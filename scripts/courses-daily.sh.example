#!/bin/bash
# Nightly BIU course job. Versioned, reviewed copy of ~/.academic-writer/bin/courses-daily.sh
# (launchd: com.yotam.academic-courses-daily). The live script is replaced by hand, not by this repo.
#
# Steps, each logged to $TERM_DIR/logs/daily-<date>.log; one failing step never stops the rest:
#   a. courses.py daily            Voice Memos (exit 5 = Lemida REST blocked by the captcha: expected, not a failure)
#   b. Chrome check                no "Google Chrome" process -> a manual chore, step c skipped
#   c. claude -p --chrome          /academic-writer:courses watch-lemida --all --run-id <RUN_ID>   (COURSES_ONLY="cohen kane" restricts)
#   c1. courses.py lemida-coverage-check --run-id <RUN_ID> [--courses "cohen kane"]   the watch's coverage file
#                                  (logs/lemida-coverage-<day>.json): written for this run, every active course (in scope) visited,
#                                  every new assignment handled, notifications read to the end and every listed one opened;
#                                  a gap (a report from another run included) fails the run and adds chores
#   c2. courses.py wispr-scan      Wispr Flow lecture recordings -> queue jobs (failure is counted; no Wispr database = no-op)
#   c3. refs.py fetch-queue        dashboard fetch requests (queue/fetch/*.json): fetch chain per ref, jobs move to queue/fetch/done/ (failure is counted)
#   c4. refs.py extract-queue      text extraction the student chose on the dashboard (queue/extract/*.json): docx and PDF text layers are read
#                                  by python, jobs move to queue/extract/done/; scans (claude-vision) and items that name gemini-ocr or tesseract
#                                  become files in queue/extract/handoff/, and a chosen source that still has its add-source Trove job is
#                                  listed in queue/extract/ingest/. If any are waiting, one claude -p step (c5) reads them.
#   c5. claude -p extract          /academic-writer:courses extract-handoff   (only when c4 left handoff or ingest files)
#
# Nothing is OCR'd or text-extracted unless the student chose it in the dashboard (user rule 2026-10-19). Steps a-c only DOWNLOAD:
# queue/sources/*.json (the add-source Trove jobs) are never drained here; a chosen source is ingested after its extraction (c5).
#   d. queued lesson jobs          /academic-writer:lesson-notes --pending
#   e. tools/toc_audit.py --all    failure -> a manual chore (the job is not failed by it)
#   f. courses.py chores digest
#   g. courses-sync-nanoclaw.sh    failure is logged, not fatal
# Schedule it with `courses.py nightly set --time HH:MM` (`off` = run on demand, `run-now [--dry]` = run once now).
#
# `courses-daily.sh --extract-only` runs only c4 and c5, logged to $TERM_DIR/logs/extract-now-<date>.log, and exits at
# once when queue/extract/ holds no job. `courses.py nightly watch on` installs a LaunchAgent that runs it whenever the
# dashboard writes an extraction job, so a chosen source reaches Trove in minutes instead of at the next night.
# c4+c5 hold a flock on $TERM_DIR/locks/extract.lock (the nightly run waits for it too), so the two never ingest the same file.
# Exit status is nonzero only when a step failed.
# COURSES_DRY=1 prints each planned command to stdout instead of running it (no log file).
export PATH="${PATH:+$PATH:}$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
REPO="${ACADEMIC_WRITER_REPO:-$HOME/dev/academic-writer}"
COURSES="$REPO/src/scripts/courses/courses.py"
REFS="$REPO/src/scripts/courses/refs.py"
export ACADEMIC_HOME="${ACADEMIC_HOME:-$HOME/Academic}"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-sonnet}"
TERM_DIR="${COURSES_TERM_DIR:-$ACADEMIC_HOME/.academic-helper/terms/תשפ״ז}"
SYNC="$HOME/.academic-writer/bin/courses-sync-nanoclaw.sh"
PY=/usr/bin/python3
EXTRACT_PY="${EXTRACT_PY:-$PY}"   # needs pymupdf (and python-docx, or pandoc) to read text layers; without it scans and PDFs go to Claude
DAY=$(date +%Y-%m-%d)
RUN_ID="$DAY-$(date +%H%M%S)-$$"   # binds the watch's coverage file to this run (stale reports are gaps)
DRY="${COURSES_DRY:-}"
FAILED=0
EXTRACT_ONLY=""
[ "${1:-}" = "--extract-only" ] && EXTRACT_ONLY=1
EXTRACT_LOCK="$TERM_DIR/locks/extract.lock"   # flock target; extract.lock.owner names the last holder

WATCH_TOOLS="mcp__claude-in-chrome__*,Read,Write,Edit,Glob,Grep,Bash(python3:*),Bash(/usr/bin/python3:*),Bash(trove ms show:*),Bash(nlm source:*),Bash(nlm notebook:*),Bash(rclone:*),Bash(pdftoppm:*),Bash(ls:*),Bash(mkdir:*),Bash(mv:*),Bash(cp:*),Bash(open:*),Bash(screencapture:*),Bash(date:*)"
LESSON_TOOLS="Read,Write,Edit,Glob,Grep,Bash(python3:*),Bash(/usr/bin/python3:*),Bash(trove items:*),Bash(trove ms show:*),Bash(trove auth whoami:*),Bash(mkdir:*),Bash(mv:*),Bash(ls:*),Bash(cat:*),Bash(date:*)"

EXTRACT_TOOLS="Read,Write,Edit,Glob,Grep,Bash(python3:*),Bash(/usr/bin/python3:*),Bash(trove items:*),Bash(trove ms show:*),Bash(trove auth whoami:*),Bash(pdftoppm:*),Bash(aw:*),Bash(tesseract:*),Bash(mkdir:*),Bash(mv:*),Bash(ls:*),Bash(cat:*),Bash(date:*)"

stamp() { date '+%Y-%m-%dT%H:%M:%S%z'; }

# plan "<description>" -> in dry mode prints it; returns 0 when the caller should skip running
dry_plan() {
  [ -n "$DRY" ] || return 1
  echo "PLAN: $*"
  return 0
}

# step <name> <command...>: run, log the exit code, count a failure. Never aborts the job.
step() {
  local name="$1"; shift
  echo "-- $name $(stamp)"
  "$@"
  local rc=$?
  echo "-- $name exit=$rc"
  return $rc
}

add_manual_chore() {  # <ref> <title> <text>
  "$PY" "$COURSES" chores add --course general --kind manual --ref "$1" --title "$2" --text "$3"
}

# extract lock: a kernel flock on fd 9 (python's fcntl, so it works where flock(1) is missing). The kernel drops it when
# the holder exits, so a crashed run never leaves a stale lock. Waits up to EXTRACT_LOCK_WAIT seconds (default 90 minutes);
# returns 1 when another run still holds it. Commands started under the lock get `9>&-` so none of them keeps it alive.
take_extract_lock() {
  [ -n "$DRY" ] && return 0
  mkdir -p "$TERM_DIR/locks"
  exec 9>>"$EXTRACT_LOCK"
  local waited=0
  until "$PY" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)' 2>/dev/null; do
    if [ "$waited" -ge "${EXTRACT_LOCK_WAIT:-5400}" ]; then
      exec 9>&-
      return 1
    fi
    sleep 15
    waited=$((waited + 15))
  done
  echo "$$ $(stamp)" > "$EXTRACT_LOCK.owner"
}

release_extract_lock() {
  [ -n "$DRY" ] || exec 9>&-
}

# the top-level extraction jobs the dashboard wrote (c4 moves finished ones to queue/extract/done/)
extract_jobs() {
  shopt -s nullglob
  local jobs=("$TERM_DIR"/queue/extract/*.json)
  shopt -u nullglob
  [ ${#jobs[@]} -gt 0 ] && printf '%s\n' "${jobs[@]}"
}

run_extract() {
  # c4. extraction the student chose on the dashboard (queue/extract/*.json): python steps run here, scans are handed to Claude
  if ! dry_plan "$EXTRACT_PY $REFS --registry $TERM_DIR extract-queue"; then
    step extract-queue "$EXTRACT_PY" "$REFS" --registry "$TERM_DIR" extract-queue 9>&- || FAILED=1
  fi

  # c5. one Claude step for what python could not read (claude-vision, gemini-ocr, tesseract) and for chosen sources awaiting their Trove ingest
  shopt -s nullglob
  HANDOFFS=("$TERM_DIR"/queue/extract/handoff/*.json "$TERM_DIR"/queue/extract/ingest/*.json)
  shopt -u nullglob
  if [ ${#HANDOFFS[@]} -eq 0 ]; then
    echo "no extraction handoffs"
  else
    echo "extraction handoffs: ${#HANDOFFS[@]}"
    if ! dry_plan "printf '%s' '/academic-writer:courses extract-handoff' | claude -p --model sonnet --plugin-dir $REPO/plugins/academic-writer --allowedTools \"$EXTRACT_TOOLS\""; then
      printf '%s' "/academic-writer:courses extract-handoff" | claude -p --model sonnet \
        --plugin-dir "$REPO/plugins/academic-writer" --allowedTools "$EXTRACT_TOOLS" 9>&-
      rc=$?
      echo "-- extract-handoff exit=$rc $(stamp)"
      [ "$rc" -ne 0 ] && FAILED=1
    fi
  fi
}

# c4+c5 under the lock; nightly and --extract-only both come through here
locked_extract() {
  if ! take_extract_lock; then
    echo "extract lock still held after ${EXTRACT_LOCK_WAIT:-5400}s: c4/c5 skipped (holder: $(cat "$EXTRACT_LOCK.owner" 2>/dev/null))"
    FAILED=1
    return
  fi
  run_extract
  release_extract_lock
}

# --extract-only: one c4+c5 round, and another only for jobs that arrived during it (a second dashboard pick); a job
# c4 could not finish is never retried here (the nightly run retries it), so Claude is not called twice for it. At most 3 rounds.
run_extract_only() {
  echo "== extract now $(stamp)"
  local jobs fresh attempted="" rounds=0
  while [ "$rounds" -lt 3 ]; do
    jobs=$(extract_jobs)
    if [ -n "$attempted" ]; then
      fresh=$(printf '%s\n' "$jobs" | grep -vxF -f <(printf '%s\n' "$attempted"))
    else
      fresh=$jobs
    fi
    [ -n "$fresh" ] || break
    attempted=$(printf '%s\n%s' "$attempted" "$jobs" | sed '/^$/d')
    locked_extract
    rounds=$((rounds + 1))
    [ -n "$DRY" ] && break
  done
  echo "== done $(stamp) failed=$FAILED"
}

run_job() {
  echo "== courses daily $(stamp)"

  # a. Voice Memos (+ REST sync; exit 5 = blocked by the captcha, expected)
  if ! dry_plan "$PY $COURSES daily"; then
    step daily "$PY" "$COURSES" daily
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then FAILED=1; fi
  fi

  # b/c. Lemida scan through Claude in Chrome
  if pgrep -x "Google Chrome" >/dev/null 2>&1; then
    PROMPT="/academic-writer:courses watch-lemida ${COURSES_ONLY:---all} --run-id $RUN_ID"
    if ! dry_plan "printf '%s' '$PROMPT' | claude -p --chrome --model sonnet --plugin-dir $REPO/plugins/academic-writer --allowedTools \"$WATCH_TOOLS\""; then
      echo "-- watch-lemida $(stamp)"
      printf '%s' "$PROMPT" | claude -p --chrome --model sonnet \
        --plugin-dir "$REPO/plugins/academic-writer" --allowedTools "$WATCH_TOOLS"
      rc=$?
      echo "-- watch-lemida exit=$rc"
      [ "$rc" -ne 0 ] && FAILED=1
    fi
  else
    if ! dry_plan "$PY $COURSES chores add --kind manual \"Open Chrome logged in to Lemida so tonight's scan can run\""; then
      echo "Chrome is not running: watch-lemida skipped"
      step chrome-chore add_manual_chore "open-chrome-$DAY" "Open Chrome logged in to Lemida so tonight's scan can run" \
        "Chrome was not running at the nightly job on $DAY, so the Lemida scan was skipped." || FAILED=1
    fi
  fi

  # c1. coverage gate: a missing file or any gap the watch left (course not visited, assignment or notification not handled) fails the job
  COVERAGE_SCOPE=()
  COVERAGE_SCOPE_TXT=""
  if [ -n "${COURSES_ONLY:-}" ]; then
    COVERAGE_SCOPE=(--courses "$COURSES_ONLY")
    COVERAGE_SCOPE_TXT=" --courses \"$COURSES_ONLY\""
  fi
  if ! dry_plan "$PY $COURSES lemida-coverage-check --date $DAY --run-id $RUN_ID$COVERAGE_SCOPE_TXT"; then
    step lemida-coverage "$PY" "$COURSES" lemida-coverage-check --date "$DAY" --run-id "$RUN_ID" "${COVERAGE_SCOPE[@]}" || FAILED=1
  fi

  # c2. Wispr Flow lecture recordings: match to course slots, write queue jobs (before the lesson-notes step reads the queue)
  if ! dry_plan "$PY $COURSES wispr-scan"; then
    step wispr-scan "$PY" "$COURSES" wispr-scan || FAILED=1
  fi

  # c3. dashboard fetch requests (queue/fetch/*.json); nonzero = a job errored and waits for tomorrow or gave up
  if ! dry_plan "$PY $REFS --registry $TERM_DIR fetch-queue"; then
    step fetch-queue "$PY" "$REFS" --registry "$TERM_DIR" fetch-queue || FAILED=1
  fi

  # c4 + c5. extraction the student chose on the dashboard, then the Trove ingest of what it produced (see run_extract)
  locked_extract

  # d. queued lesson jobs
  shopt -s nullglob
  JOBS=("$TERM_DIR"/queue/*.json)
  shopt -u nullglob
  if [ ${#JOBS[@]} -eq 0 ]; then
    echo "no queued lessons"
  else
    echo "queued lessons: ${#JOBS[@]}"
    if ! dry_plan "printf '%s' '/academic-writer:lesson-notes --pending' | claude -p --model sonnet --plugin-dir $REPO/plugins/academic-writer --allowedTools \"$LESSON_TOOLS\""; then
      printf '%s' "/academic-writer:lesson-notes --pending" | claude -p --model sonnet \
        --plugin-dir "$REPO/plugins/academic-writer" --allowedTools "$LESSON_TOOLS"
      rc=$?
      echo "-- lesson-notes exit=$rc $(stamp)"
      [ "$rc" -ne 0 ] && FAILED=1
    fi
  fi

  # e. Trove ToC audit: a failure becomes a chore, it does not fail the job
  if ! dry_plan "$PY $REPO/tools/toc_audit.py --all"; then
    AUDIT=$("$PY" "$REPO/tools/toc_audit.py" --all --json 2>&1)
    rc=$?
    echo "-- toc-audit exit=$rc"
    if [ "$rc" -ne 0 ]; then
      echo "$AUDIT" | head -40
      BOOKS=$(printf '%s' "$AUDIT" | "$PY" -c 'import json,sys
try:
    d=json.load(sys.stdin); print(", ".join(b["label"] for b in d["books"] if not b.get("ok")))
except Exception:
    print("see the daily log")' 2>/dev/null)
      add_manual_chore "toc-audit-$DAY" "ToC audit failed: ${BOOKS:-see the daily log}" \
        "tools/toc_audit.py --all failed on $DAY. Run it to see the missing, duplicate or unhinted entries." \
        || echo "could not record the ToC chore"
    fi
  fi

  # f. chores digest
  if ! dry_plan "$PY $COURSES chores digest"; then
    step digest "$PY" "$COURSES" chores digest || FAILED=1
  fi

  # g. sync to NanoClaw (logged, not fatal)
  if ! dry_plan "$SYNC"; then
    step nanoclaw-sync "$SYNC" || echo "nanoclaw sync failed (not fatal)"
  fi
  echo "== done $(stamp) failed=$FAILED"
}

if [ -n "$EXTRACT_ONLY" ]; then
  [ -n "$(extract_jobs)" ] || exit 0  # launchd also fires when c4 empties queue/extract/: nothing to do, no log
  if [ -n "$DRY" ]; then
    run_extract_only
  else
    mkdir -p "$TERM_DIR/logs"
    run_extract_only >> "$TERM_DIR/logs/extract-now-$DAY.log" 2>&1
  fi
  exit "$FAILED"
fi

if [ -n "$DRY" ]; then
  run_job
else
  mkdir -p "$TERM_DIR/logs"
  run_job >> "$TERM_DIR/logs/daily-$DAY.log" 2>&1
fi
exit "$FAILED"
