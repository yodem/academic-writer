{
  "description": "Academic Writer hooks — session dashboard, session logging (TypeScript/ESM)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "USER_CONFIG_GOOGLE_API_KEY='${user_config.google_api_key}' USER_CONFIG_JEV_API_KEY='${user_config.jev_api_key}' node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/session-env",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/session-dashboard",
            "timeout": 5,
            "statusMessage": "Loading Academic Writer dashboard..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/voice-pull",
            "timeout": 10,
            "statusMessage": "Pulling latest voice profile..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/voice/voice-migrate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/subagent-start",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/notify-stop",
            "timeout": 3,
            "statusMessage": "Notifying..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/gate-enforce",
            "timeout": 5,
            "statusMessage": "Checking gates..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs\" lifecycle/session-end-log",
            "timeout": 10,
            "statusMessage": "Logging session..."
          }
        ]
      }
    ]
  }
}
