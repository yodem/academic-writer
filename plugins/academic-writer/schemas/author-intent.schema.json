{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["thesis", "coreTextSourceId", "moves", "mustUse"],
  "properties": {
    "thesis": { "type": "string", "minLength": 1 },
    "coreTextSourceId": { "type": "string", "minLength": 1 },
    "moves": { "type": "array", "items": { "type": "string" } },
    "mustUse": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
