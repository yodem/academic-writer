{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Library evaluation plan (plan.json)",
  "description": "The claims a blind comparison of two libraries will be run on. Never shown to the judge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eval_id", "created_at", "article", "seed", "routes", "shelf", "claims", "skipped", "estimate"],
  "properties": {
    "schema": {"const": 1},
    "eval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,39}$"},
    "created_at": {"type": "string", "minLength": 1},
    "article": {"type": ["string", "null"]},
    "seed": {"type": "string", "minLength": 1},
    "routes": {"type": "array", "items": {"enum": ["trove", "pageindex"]}},
    "shelf": {"type": "array", "items": {"$ref": "#/definitions/book"}},
    "claims": {"type": "array", "items": {"$ref": "#/definitions/claim"}},
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["too_short", "no_source", "multi_source", "unresolved", "over_cap"],
      "properties": {
        "too_short": {"type": "integer", "minimum": 0},
        "no_source": {"type": "integer", "minimum": 0},
        "multi_source": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "over_cap": {"type": "integer", "minimum": 0}
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "usd"],
      "properties": {
        "runs": {"type": "integer", "minimum": 0},
        "usd": {"type": "number", "minimum": 0}
      }
    }
  },
  "definitions": {
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.#:-]+$"},
        "title": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source_id", "source_title", "cited_trove_pages", "cited_printed_page", "paragraph_id", "auditor_verdict", "corrected_page"],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]{2,3}$"},
        "text": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9_.#:-]+$"},
        "source_title": {"type": "string"},
        "cited_trove_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "cited_printed_page": {"type": ["integer", "null"], "minimum": 1},
        "paragraph_id": {"type": ["string", "null"]},
        "auditor_verdict": {"enum": ["PASS", "FAIL", null]},
        "corrected_page": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
