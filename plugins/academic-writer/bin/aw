var PYTHON_CANDIDATES = ["python3.13", "python3.12", "python3.11", "python3.10", "python3.9", "python3", "python"];
var PROBE_CODE = 'import sys; print("%d.%d.%d" % sys.version_info[:3]); print(sys.executable)';
function parseVersion(text4) {
  const match = text4.trim().match(/^(\d+)\.(\d+)(?:\.(\d+))?/u);
  if (!match) return null;
  return { major: Number(match[1]), minor: Number(match[2]), patch: Number(match[3] ?? 0) };
}
function atLeast(have, need) {
  const wanted = parseVersion(need);
  if (!wanted) return false;
  return have.major > wanted.major || have.major === wanted.major && have.minor >= wanted.minor;
}
async function probePython(command3, env, timeoutMs = thresholds_default.library.install.probeTimeoutMs) {
  let out;
  try {
    out = await runCommand([command3], ["-c", PROBE_CODE], { timeoutMs, maxBuffer: 65536, env });
  } catch {
    return null;
  }
  const [versionLine, pathLine] = out.split("\n").map((line) => line.trim());
  const version = parseVersion(versionLine ?? "");
  if (!version || version.major !== 3 || !pathLine) return null;
  return { command: command3, path: pathLine, version: `${version.major}.${version.minor}.${version.patch}`, major: version.major, minor: version.minor, minorName: `${version.major}.${version.minor}` };
}
function realOrSame(path2) {
  try {
    return realpathSync(path2);
  } catch {
    return path2;
  }
}
async function discoverPythons(env, extra = []) {
  const found = [];
  const seen = /* @__PURE__ */ new Set();
  const probes = await Promise.all([...extra, ...PYTHON_CANDIDATES].map((name) => probePython(name, env)));
  for (const info of probes) {
    if (!info) continue;
    const key = realOrSame(info.path);
    if (seen.has(key)) continue;
    seen.add(key);
    found.push(info);
  }
  return found;
}
function choosePython(found, minimum, lockedMinor) {
  const fit = found.filter((info) => atLeast(info, minimum));
  if (fit.length === 0) return null;
  const exact = lockedMinor ? fit.find((info) => info.minorName === lockedMinor) : void 0;
  if (exact) return { python: exact, exact: true };
  const ordered = [...fit].sort((left, right) => left.major - right.major || left.minor - right.minor);
  return { python: ordered[0], exact: false };
}
function venvPython(venvDir, platform = process.platform) {
  return platform === "win32" ? join6(venvDir, "Scripts", "python.exe") : join6(venvDir, "bin", "python");
}

