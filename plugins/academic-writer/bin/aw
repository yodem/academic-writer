    const [file, ...prefix] = engineCommand(options.engine, options.env);
    let exit;
    let tracker;
    const fromMs = Date.now();
    const attempt = { tag };
    group.attempts.add(attempt);
    try {
      exit = await runAgent([file, ...prefix], options.engine === "claude" ? claudeArgs(model, wrapper) : codexArgs(model, cwd), {
        input: prompt4,
        cwd,
        env,
        timeoutMs: options.runTimeoutMs,
        maxBuffer: evalLimits.maxBufferBytes,
        group,
        tracker: (pid) => {
          tracker = new TreeTracker(pid);
          attempt.tracker = tracker;
          tracker.start();
        }
      });
    } finally {
      await tracker?.stop();
      await reapTagged(tag, tracker);
      group.attempts.delete(attempt);
    }
    const parsed = parseAgent(options.engine, exit.stdout);
    const answer = parseAnswer(parsed.text, evalLimits.maxAnswerPages);
    const budget = deriveBudget(parsed.calls, wrapper);
    const returned = await returnedFor(options.project, runId2, { fromMs, toMs: Date.now() });
    const violations = commandViolations(parsed.calls, wrapper).slice(0, 5);
    let error = null;
    if (exit.spawnError === "missing") error = `the ${options.engine} command was not found`;
    else if (exit.spawnError) error = `could not start ${options.engine}: ${exit.spawnError}`;
    else if (exit.timedOut) error = `timed out after ${Math.round(options.runTimeoutMs / 1e3)} s`;
    else if (exit.tooLarge) error = "the agent printed more than the output limit";
    else if (violations.length > 0) error = "the agent ran a command that is not on its allowed list";
    else if (!answer) error = parsed.stopReason ? `no answer (${parsed.stopReason})` : exit.code !== 0 ? `exit ${exit.code ?? "signal"} and no answer: ${exit.stderr.trim().slice(0, 200)}` : "no parsable answer";
    else if (!options.plan.shelf.some((book) => book.id === answer.book)) error = "the answer names a book that is not on the shelf";
    const usd3 = parsed.costUsd;
    await appendUsage(options.project, {
      run_id: runId2,
      step: "library.eval.locate",
      provider: options.engine === "claude" ? "claude-code" : "codex",
      model: parsed.model ?? model ?? "default",
      input_tokens: parsed.inputTokens,
      output_tokens: parsed.outputTokens,
      cost_usd: usd3,
      latency_ms: exit.wallMs,
      exit: error ? "ERROR" : "OK",
      same_family: false
    });
    const run = {
      schema: 1,
      eval_id: options.plan.eval_id,
      claim_id: claim.id,
      route,
      engine: options.engine,
      model: parsed.model ?? model ?? "default",
      status: error ? "error" : "ok",
      started_at: started.toISOString(),
      answer,
      tool_calls: parsed.calls.map((call) => call.replaceAll(wrapper, "<wrapper>").slice(0, 400)),
      ...budget,
      permission_denials: parsed.permissionDenials,
      wall_ms: exit.wallMs,
      agent_ms: parsed.agentMs,
      turns: parsed.turns,
      input_tokens: parsed.inputTokens,
      output_tokens: parsed.outputTokens,
      cost_usd: usd3,
      returned_chars: returned.chars,
      returned_est_tokens: returned.est,
      agent_version: parsed.version,
      error,
      plan_sha256: planSha(options.plan),
      claim_sha256: claimSha(claim),
      prompt_version: PROMPT_VERSION,
      model_requested: requested,
      fingerprint: expectedFingerprint(options, claim, route),
      violations,
      lookup_errors: await lookupErrors(errorLog)
    };
    return { run, missing: exit.spawnError === "missing" };
  } finally {
    await rm5(dir, { recursive: true, force: true });
  }
}
function sumReturned(a, b) {
  if (a.returned_chars === null && b.returned_chars === null) return { chars: null, est: null };
  const missing = (x2) => x2.returned_chars !== null && x2.returned_est_tokens === null;
  return { chars: (a.returned_chars ?? 0) + (b.returned_chars ?? 0), est: missing(a) || missing(b) ? null : (a.returned_est_tokens ?? 0) + (b.returned_est_tokens ?? 0) };
}
async function locate(options, claim, route, group) {
  let total = null;
  let violations = [];
  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
    const { run, missing } = await locateOnce(options, claim, route, group);
    if (missing) throw new LibraryError("config", `ERROR library eval run: the ${options.engine} command was not found. The evaluation needs ${options.engine === "claude" ? "Claude Code" : "Codex"} installed on this computer (it cannot run in Cowork).`);
    violations = [.../* @__PURE__ */ new Set([...violations, ...run.violations])].slice(0, 10);
    total = total === null ? { ...run, attempts: 1 } : {
      ...run,
      attempts: attempt,
      wall_ms: total.wall_ms + run.wall_ms,
      input_tokens: total.input_tokens + run.input_tokens,
      output_tokens: total.output_tokens + run.output_tokens,
      cost_usd: total.cost_usd === null && run.cost_usd === null ? null : (total.cost_usd ?? 0) + (run.cost_usd ?? 0),
      // Each attempt measured its own window; the run's figure is the total over its attempts.
      returned_chars: sumReturned(total, run).chars,
      returned_est_tokens: sumReturned(total, run).est,
      agent_ms: total.agent_ms === null && run.agent_ms === null ? null : (total.agent_ms ?? 0) + (run.agent_ms ?? 0)
    };
    total.violations = violations;
    if (violations.length > 0) {
      total.status = "error";
      total.error = "the agent ran a command that is not on its allowed list";
      break;
    }
    if (run.status === "ok") break;
  }
  return total;
}
async function runAll(options) {
  if (existsSync14(options.paths.pairs)) {
    throw new LibraryError("usage", "ERROR library eval run: pairs already exist for this evaluation, so its runs cannot change. Start a new evaluation with another --eval id, or run again with --reset (the old pairs, judgments and runs are archived first).");
  }
  const jobs = [];
  let skipped = 0;
  let invalid = 0;
  const invalidSeen = [];
  for (const claim of options.plan.claims) {
    for (const route of options.routes) {
      const existing = await readJson(runFile(options.paths, claim.id, route));
      const current = existing !== null && validate("run", existing).length === 0 && existing.fingerprint === expectedFingerprint(options, claim, route);
      if (current && existing.violations.length > 0) {
        invalid += 1;
        invalidSeen.push(existing);
      } else if (current && existing.status === "ok") skipped += 1;
      else jobs.push({ claim, route });
    }
  }
  const summary = { planned: options.plan.claims.length * options.routes.length, done: 0, skipped, failed: 0, invalid, cost_usd: 0, invalid_runs: [] };
  const group = new ChildGroup();
  const stop = () => group.killAll();
  let fatal = null;
  let interrupted = false;
  const onSignal = (signal) => {
    if (interrupted) return;
    interrupted = true;
    fatal = new LibraryError("exit", `ERROR library eval run: interrupted by ${signal}`);
    void group.reapAll().finally(() => process.exit(128 + (osConstants.signals[signal] ?? 15)));
  };
  process.once("SIGINT", onSignal);
  process.once("SIGTERM", onSignal);
  process.once("exit", stop);
  let next = 0;
  const worker = async () => {
    for (; ; ) {
      if (fatal !== null) return;
      const job = jobs[next];
      next += 1;
      if (!job) return;
      try {
        const run = await locate(options, job.claim, job.route, group);
        await writeJson(runFile(options.paths, job.claim.id, job.route), run);
        summary.cost_usd += run.cost_usd ?? 0;
        if (run.violations.length > 0) {
          summary.invalid += 1;
          invalidSeen.push(run);
        } else if (run.status === "ok") summary.done += 1;
        else summary.failed += 1;
        options.progress(`located ${summary.done + summary.failed + summary.invalid + skipped} of ${summary.planned}`);
      } catch (error) {
        if (fatal === null) fatal = error;
        group.killAll();
        return;
      }
    }
  };
  try {
    await Promise.all(Array.from({ length: Math.max(1, Math.min(options.parallel, jobs.length || 1)) }, () => worker()));
  } finally {
    process.removeListener("SIGINT", onSignal);
    process.removeListener("SIGTERM", onSignal);
    process.removeListener("exit", stop);
    group.killAll();
  }
  if (interrupted) await new Promise(() => void 0);
  if (fatal !== null) throw fatal;
  summary.cost_usd = Math.round(summary.cost_usd * 1e4) / 1e4;
  summary.invalid_runs = invalidClaims(invalidSeen);
  return summary;
}

// src/library/eval/pairs.ts
var TEXT_UNAVAILABLE = "[The text of this page could not be read.]";
var ROUTE_WORD = /trove|page-?index/iu;
function routeLeak(pairs) {
  const scan = (value, path2) => {
    if (Array.isArray(value)) {
      for (const [index, item] of value.entries()) {
        const hit = scan(item, `${path2}[${index}]`);
        if (hit) return hit;
      }
      return null;
    }
    if (typeof value === "object" && value !== null) {
      for (const [key, item] of Object.entries(value)) {
        if (ROUTE_WORD.test(key)) return `${path2}.${key}`;
        const hit = scan(item, `${path2}.${key}`);
        if (hit) return hit;
      }
      return null;
    }
    const field = path2.split(".").pop() ?? "";
    if (typeof value === "string" && !["text", "book_title"].includes(field) && ROUTE_WORD.test(value)) return path2;
    return null;
  };
  return scan(pairs, "pairs");
}
async function fetchTexts(options, needed) {
  const texts = /* @__PURE__ */ new Map();
  for (const [book, pages] of needed) {
    const spec = formatPageRanges([...pages].sort((a, b) => a - b));
    let output;
    try {
      output = await options.aw({ args: ["read", "--source", book, "--pages", spec], route: "trove", run: `chk-${options.evalId}` });
    } catch (error) {
      if (/has none of the requested pages/u.test(error instanceof Error ? error.message : String(error))) continue;
      throw new LibraryError("exit", `ERROR library eval pairs: could not read pages ${spec} of ${book} for the judging page (${error instanceof Error ? error.message : String(error)})`);
    }
    let parsed;
    try {
      parsed = JSON.parse(output);
    } catch {
      throw new LibraryError("parse", `ERROR library eval pairs: the page read of ${book} did not return JSON`);
    }
    for (const page of parsed.pages ?? []) {
      if (typeof page.trove_page === "number" && typeof page.text === "string") texts.set(`${book}\0${page.trove_page}`, page.text.normalize("NFC"));
    }
  }
  return texts;
}
function optionFor(plan2, run, texts) {
  const answer = run.status === "ok" ? run.answer : null;
  if (!answer) return { option: { book: null, book_title: null, pages: [] }, valid: false, complete: true };
  const pages = [...new Set(answer.pages)].sort((a, b) => a - b).map((page) => ({ page, text: texts.get(`${answer.book}\0${page}`) }));
  return {
    option: { book: answer.book, book_title: plan2.shelf.find((book) => book.id === answer.book)?.title ?? answer.book, pages: pages.map((entry) => ({ page: entry.page, text: entry.text ?? TEXT_UNAVAILABLE })) },
    valid: true,
    complete: pages.every((entry) => entry.text !== void 0)
  };
}
function sameOption(a, b) {
  return a.book === b.book && a.pages.length === b.pages.length && a.pages.every((page, index) => page.page === b.pages[index]?.page);
}
function runIsCurrent(plan2, claim, route, run) {
  return run.eval_id === plan2.eval_id && run.claim_id === claim.id && run.route === route && run.prompt_version === PROMPT_VERSION && run.plan_sha256 === planSha(plan2) && run.claim_sha256 === claimSha(claim) && run.fingerprint === fingerprintOf({
    plan_sha256: run.plan_sha256,
    claim_sha256: run.claim_sha256,
    claim_id: run.claim_id,
    route: run.route,
    engine: run.engine,
    model_requested: run.model_requested,
    prompt_version: run.prompt_version
  });
}
async function buildPairs(options) {
  const { plan: plan2, paths } = options;
  if (plan2.routes.length !== 2 || plan2.routes[0] === plan2.routes[1]) throw new LibraryError("usage", "ERROR library eval pairs: a comparison needs exactly two different libraries in the plan");
  if (existsSync15(paths.judgments)) throw new LibraryError("usage", "ERROR library eval pairs: judgments are already imported; building new pairs would break them");
  if (existsSync15(paths.pairs) && !options.force) throw new LibraryError("usage", "ERROR library eval pairs: pairs already exist for this evaluation (--force builds them again, with a new hidden order)");
  const routes = plan2.routes;
  const runs = /* @__PURE__ */ new Map();
  const missing = [];
  const excluded = [];
  for (const claim of plan2.claims) {
    for (const route of routes) {
      const value = await readJson(runFile(paths, claim.id, route));
      if (value === null || validate("run", value).length > 0 || !runIsCurrent(plan2, claim, route, value)) missing.push(claim.id);
      else runs.set(`${claim.id}:${route}`, value);
    }
  }
  if (missing.length > 0) throw new LibraryError("usage", `ERROR library eval pairs: ${new Set(missing).size} claim(s) have no finished locate run for this plan; run \`aw library eval run\` first`);
  const claims = plan2.claims.filter((claim) => {
    const bad = routes.some((route) => runs.get(`${claim.id}:${route}`).violations.length > 0);
    if (bad) excluded.push({ claim_id: claim.id, reason: "an agent ran a command outside its allowed list" });
    return !bad;
  });
  if (claims.length === 0) throw new LibraryError("usage", "ERROR library eval pairs: every claim was left out; nothing to compare");
  const needed = /* @__PURE__ */ new Map();
  for (const run of runs.values()) {
    if (run.status === "ok" && run.answer) {
      const set = needed.get(run.answer.book) ?? /* @__PURE__ */ new Set();
      for (const page of run.answer.pages) set.add(page);
      needed.set(run.answer.book, set);
    }
  }
  const texts = await fetchTexts(options, needed);
  const orders = slotOrders(claims.length, seededRandom(`${options.seed}:order`));
  const pairs = [];
  const mapped = [];
  for (const [index, claim] of claims.entries()) {
    const pairId = `p${String(index + 1).padStart(2, "0")}`;
    const first = optionFor(plan2, runs.get(`${claim.id}:${routes[0]}`), texts);
    const second = optionFor(plan2, runs.get(`${claim.id}:${routes[1]}`), texts);
    const firstInA = orders[index];
    pairs.push({
      pair_id: pairId,
      claim: { id: claim.id, text: claim.text },
      auto_same: first.valid && second.valid && first.complete && second.complete && sameOption(first.option, second.option),
      options: firstInA ? { A: first.option, B: second.option } : { A: second.option, B: first.option }
    });
    mapped.push({ pair_id: pairId, claim_id: claim.id, A: firstInA ? routes[0] : routes[1], B: firstInA ? routes[1] : routes[0] });
  }
  const snapshot = [];
  for (const claim of claims) {
    for (const route of routes) snapshot.push({ claim_id: claim.id, route, sha256: await fileSha(runFile(paths, claim.id, route)) });
  }
  const mapping = newMapping(plan2.eval_id, options.seed, planSha(plan2), snapshot, mapped);
  const document2 = { schema: 1, eval_id: plan2.eval_id, created_at: options.now.toISOString(), mapping_sha256: mappingCommitment(mapping), pairs };
  const problems = validate("pairs", document2);
  if (problems.length > 0) throw new LibraryError("parse", `ERROR library eval pairs: the pairs do not match their schema (${problems[0]})`);
  const leak = routeLeak(document2);
  if (leak) throw new LibraryError("parse", `ERROR library eval pairs: a library name would be visible to the judge at ${leak}; nothing was written`);
  await writeSealed(paths.sealedDir, paths.mapping, mapping);
  await writeJson(paths.pairs, document2);
  return { pairs: document2, mapping, summary: { eval_id: plan2.eval_id, pairs: pairs.length, auto_same: pairs.filter((pair) => pair.auto_same).length, mapping_sha256: document2.mapping_sha256, excluded } };
}

