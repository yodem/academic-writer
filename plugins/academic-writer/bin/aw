function allowedEnv(env, kind = "pageindex") {
  const out = {};
  const listed = new Set((env[PASS_ENV] ?? "").split(",").map((name) => name.trim()).filter((name) => VALID_NAME.test(name)));
  for (const [name, value] of Object.entries(env)) {
    if (value === void 0) continue;
