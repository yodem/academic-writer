var SPECIAL = { "\xF8": "o", "\u0111": "d", "\u0142": "l", "\xDF": "ss", "\xE6": "ae", "\u0153": "oe", "\u0131": "i", "\xF0": "d", "\xFE": "th" };
var FINAL = { "\u05DA": "\u05DB", "\u05DD": "\u05DE", "\u05DF": "\u05E0", "\u05E3": "\u05E4", "\u05E5": "\u05E6" };
function fold(text4) {
  let out = text4.normalize("NFKD").toLowerCase().replace(new RegExp("\\p{M}", "gu"), "");
  out = out.replace(/[׳״'’‘`"“”„]/gu, "");
  out = out.replace(/[øđłßæœıðþ]/gu, (char) => SPECIAL[char] ?? char);
  out = out.replace(/[ךםןףץ]/gu, (char) => FINAL[char] ?? char);
  return out.replace(/[^\p{L}\p{N}]+/gu, " ").trim();
}
var HEBREW = /^[א-ת]+$/u;
var PREFIX_LETTERS = /* @__PURE__ */ new Set(["\u05D5", "\u05D4", "\u05D1", "\u05DB", "\u05DC", "\u05DE", "\u05E9"]);
function tokensOf(text4) {
  return fold(text4).split(" ").filter(Boolean);
}
function sameWord(noteWord, wanted) {
  if (noteWord === wanted) return true;
  if (!HEBREW.test(noteWord) || !HEBREW.test(wanted) || wanted.length < 3) return false;
  const extra = noteWord.length - wanted.length;
  return extra >= 1 && extra <= 2 && noteWord.endsWith(wanted) && [...noteWord.slice(0, extra)].every((letter) => PREFIX_LETTERS.has(letter));
}
function hasWord(tokens2, wanted) {
  return tokens2.some((token) => sameWord(token, wanted));
}
function hasSequence(tokens2, wanted) {
  if (wanted.length === 0) return false;
  for (let at = 0; at + wanted.length <= tokens2.length; at += 1) {
    if (wanted.every((word, index) => sameWord(tokens2[at + index], word))) return true;
  }
  return false;
}
