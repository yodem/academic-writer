function requireProject(project) {
  if (!existsSync13(join19(project, ".academic-helper"))) {
    throw new LibraryError("config", "ERROR library eval: this folder has no .academic-helper folder, so it is not an article project; open the article folder first");
  }
}
function sha256(data) {
  return createHash6("sha256").update(data).digest("hex");
}
function newNonce() {
  return randomBytes3(32).toString("hex");
}
function canonicalJson(value) {
  const sort = (item) => {
    if (Array.isArray(item)) return item.map(sort);
    if (typeof item === "object" && item !== null) {
      return Object.fromEntries(Object.entries(item).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0).map(([key, inner]) => [key, sort(inner)]));
    }
    return item;
  };
  return JSON.stringify(sort(value));
}
async function writeJson(file, value, mode = 420) {
  await writeText(file, `${JSON.stringify(value, null, 2)}
`, mode);
}
async function writeText(file, text4, mode = 420) {
  await mkdir4(dirname8(file), { recursive: true });
  try {
    if ((await lstat2(file)).isSymbolicLink()) throw new LibraryError("config", `ERROR library eval: ${file} is a symbolic link; refusing to write it`);
  } catch (error) {
    if (error instanceof LibraryError) throw error;
  }
  const temp = `${file}.${process.pid}.${randomBytes3(4).toString("hex")}.tmp`;
  await writeFile3(temp, text4, { encoding: "utf8", mode });
  await chmod(temp, mode);
  await rename3(temp, file);
}
async function readJson(file) {
  let text4;
  try {
    if ((await lstat2(file)).isSymbolicLink()) throw new LibraryError("config", `ERROR library eval: ${file} is a symbolic link; refusing to read it`);
    text4 = await readFile4(file, "utf8");
  } catch (error) {
    if (error instanceof LibraryError) throw error;
    return null;
  }
  try {
    return JSON.parse(text4);
  } catch {
    throw new LibraryError("parse", `ERROR library eval: ${file} is not valid JSON`);
  }
}
var SCHEMAS = { plan: library_eval_plan_schema_default, run: library_eval_run_schema_default, pairs: library_eval_pairs_schema_default, judgments: library_eval_judgments_schema_default, mapping: library_eval_mapping_schema_default };
function validate(name, value) {
  return checkSchema(SCHEMAS[name], value);
}
function validateImport(value) {
  return checkSchema({ $ref: "#/definitions/import" }, value, library_eval_judgments_schema_default);
}
async function readValid(name, file, what) {
  const value = await readJson(file);
  if (value === null) throw new LibraryError("usage", `ERROR library eval: no ${what} yet (${name === "plan" ? "run `aw library eval plan` first" : "a step before this one has not run"})`);
  const problems = validate(name, value);
  if (problems.length > 0) throw new LibraryError("parse", `ERROR library eval: ${what} is not valid (${problems[0]})`);
  return value;
}
async function appendUsage(project, row) {
  if (checkSchema(ledger_row_schema_default, row).length > 0) return false;
  try {
    const dir = join19(project, ".academic-helper", "runs", row.run_id);
    await mkdir4(dir, { recursive: true });
    await appendFile(join19(dir, "usage.jsonl"), `${JSON.stringify(row)}
`, "utf8");
    return true;
  } catch {
    return false;
  }
}

// src/library/index-cmd.ts
var limits5 = thresholds_default.library;
var INDEX_STEP = "library.index";
var SUMMARY_MODES = ["gemini", "hints", "none"];
function makeIndexer(project, env = process.env, now = () => /* @__PURE__ */ new Date()) {
  const config = loadLibraryConfig(project, env);
  return { project, config, command: config.pageindexCommand, source: config.pageindexSource, env, now };
}
function pageindexEnv(indexer, summaries) {
  const key = indexer.source === "installed" && summaries === "gemini" ? geminiKeyFrom(indexer.env) : null;
  return childEnv(indexer.env, { gemini: key });
}
function runCapture(command3, args2, options) {
  const [file, ...prefix] = command3;
  if (!file) return Promise.reject(new LibraryError("config", "ERROR library: empty command"));
  return new Promise((resolve13) => {
    let settled = false;
    let stdout = "";
    let stderr = "";
    let bytes = 0;
    const posix = process.platform !== "win32";
    const child = spawn6(file, [...prefix, ...args2], { stdio: ["ignore", "pipe", "pipe"], env: options.env, cwd: options.cwd, detached: posix, windowsHide: true });
    const kill = () => {
      try {
        if (posix && child.pid) process.kill(-child.pid, "SIGKILL");
        else child.kill("SIGKILL");
      } catch {
        try {
          child.kill("SIGKILL");
        } catch {
        }
      }
    };
    const done = (value) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      resolve13(value);
    };
    const timer = setTimeout(() => {
      kill();
      child.stdout?.destroy();
      child.stderr?.destroy();
      done({ code: null, stdout, stderr, timedOut: true, spawnError: null });
    }, options.timeoutMs);
    child.stdout?.setEncoding("utf8").on("data", (chunk) => {
      bytes += Buffer.byteLength(chunk);
      if (bytes > options.maxBuffer) {
        kill();
        done({ code: null, stdout, stderr: `${stderr}
output larger than ${options.maxBuffer} bytes`, timedOut: false, spawnError: null });
        return;
      }
      stdout += chunk;
    });
    child.stderr?.setEncoding("utf8").on("data", (chunk) => {
      if (stderr.length < 8192) stderr += chunk;
    });
    child.on("error", (error) => done({ code: null, stdout, stderr, timedOut: false, spawnError: error.code === "ENOENT" ? `command not found: ${file}` : error.message }));
    child.on("close", (code) => done({ code, stdout, stderr, timedOut: false, spawnError: null }));
  });
}
function lastJson(text4) {
  const line = text4.trim().split("\n").filter(Boolean).at(-1);
  if (!line) return null;
  try {
    const value = JSON.parse(line);
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value : null;
  } catch {
    return null;
  }
}
var PLAIN = {
  trove_failed: (detail) => `Trove could not be read for this book${detail ? ` (${detail})` : ""}. The upload to Trove is not affected; try indexing again once Trove answers.`,
  trove_truncated: () => "Trove would not hand over this whole book in one read, so it cannot be indexed yet. The copy in Trove is fine.",
  no_hinted_toc: () => "This book has no table of contents with hints, and the structure fallback was switched off, so nothing was indexed.",
  structure_helper_missing: () => "This book has no table of contents with hints, and the full helper that finds the structure by itself is not installed here. Install the full helper (needs Python 3.10 or newer), or use a computer that has it.",
  core_helper_missing: () => "The summary helper is not installed. Install the built-in helper, or index without Gemini summaries.",
  missing_key: () => "No Google (Gemini) key is available for the summaries. Add your Google key in the plugin settings, or index without summaries.",
  call_cap: (detail) => `Stopped at the limit of Gemini calls${detail ? ` (${detail})` : ""}. The summaries written so far are kept; run it again to continue.`,
  model_failed: (detail) => `Gemini did not answer${detail ? ` (${detail})` : ""}. Check the key, the model name and the connection.`,
  bad_input: (detail) => `An option or the book name was not accepted${detail ? `: ${detail}` : ""}.`,
  empty_book: () => "This book has no pages in Trove, so there is nothing to index.",
  no_toc: () => "This book has no usable table of contents entries, so no outline could be built.",
  render_failed: (detail) => `The text of this book could not be turned into a PDF for the structure check${detail ? ` (${detail})` : ""}. The Trove copy is fine.`,
  structure_failed: (detail) => `PageIndex stopped while reading the structure of the book${detail ? ` (${detail})` : ""}.`,
  empty_tree: () => "PageIndex found no structure in this book.",
  busy: () => "This book is being indexed by another process right now; try again when it finishes.",
  internal: (detail) => `The indexing helper stopped unexpectedly${detail ? ` (${detail})` : ""}. Please report it.`,
  read_back_failed: (detail) => `The book was indexed, but the check afterwards found a problem${detail ? `: ${detail}` : ""}. Trove is not affected; run the index again.`
};
function plainFailure(code, detail) {
  const clean = redact(detail).replace(/\s+/gu, " ").trim().slice(0, 240);
  return (PLAIN[code] ?? PLAIN.internal)(clean);
}
var OLD_COMMAND = "The PageIndex command found here is older than this plugin: it cannot index books (it has no index-trove step) and it cannot read books indexed by the built-in helper. Install the built-in helper (aw library install), or update pilib on the computer that holds your library.";
function ensureCanIndex(indexer) {
  indexer.capable ??= (async () => {
    const result = await runCapture(indexer.command, ["index-trove", "--help"], { timeoutMs: limits5.index.probeTimeoutMs, maxBuffer: 1048576, env: pageindexEnv(indexer, "none"), cwd: indexer.project });
    if (result.code === 0) return;
    if (result.spawnError) {
      const text4 = indexer.source === "default" ? "No PageIndex command is set up on this computer. Install the built-in helper (aw library install), or set your own command in the plugin settings." : `The PageIndex command could not be started (${redact(result.spawnError)}). Check the plugin setting or install the built-in helper (aw library install).`;
      throw new LibraryError("config", `ERROR library index: ${text4}`);
    }
    if (result.timedOut) throw new LibraryError("timeout", "ERROR library index: the PageIndex command did not answer in time; check that it is reachable.");
    if (/invalid choice|unrecognized|usage:/iu.test(result.stderr)) throw new LibraryError("config", `ERROR library index: ${OLD_COMMAND}`);
    throw new LibraryError("exit", `ERROR library index: the PageIndex command failed its start-up check (${redact(result.stderr).replace(/\s+/gu, " ").trim().slice(0, 200)}).`);
  })();
  return indexer.capable;
}
var RESULT_FIELDS = [
  "dry_run",
  "book_id",
  "trove_id",
  "title",
  "source",
  "fallback",
  "summaries",
  "model",
  "n_pages",
  "toc_entries",
  "hinted_entries",
  "nodes",
  "nodes_with_summary",
  "summaries_reused",
  "summaries_generated",
  "summary_failures",
  "expected_calls",
  "input_chars",
  "calls",
  "failures",
  "prompt_tokens",
  "completion_tokens",
  "reasoning_tokens",
  "cost_usd",
  "cost_unknown_calls",
  "call_cap",
  "seconds",
  "library",
  "indexed_at",
  "warnings"
];
function pick(source) {
  const out = {};
  for (const field of RESULT_FIELDS) if (field in source) out[field] = source[field];
  if (Array.isArray(out.warnings)) out.warnings = out.warnings.map((entry) => redact(String(entry)).slice(0, 300));
  return out;
}
function squash(text4) {
  return text4.replace(/\s+/gu, " ").trim();
}
function count(value) {
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? Math.round(value) : 0;
}
function newRunId(now, prefix = "index") {
  return `${prefix}-${now.toISOString().slice(0, 19).replace(/[-:T]/gu, "")}-${randomBytes4(2).toString("hex")}`;
}
function callCap(request) {
  const wanted = request.maxCalls ?? limits5.index.maxCalls;
  return request.summaries === "gemini" && !request.yes ? Math.min(wanted, limits5.index.askAboveCalls) : wanted;
}
async function recordUsage(indexer, request, result, ok, code, wallMs) {
  const calls = count(result.calls);
  const unpriced = count(result.cost_unknown_calls);
  const cost = typeof result.cost_usd === "number" && result.cost_usd >= 0 && !(calls > 0 && unpriced >= calls) ? result.cost_usd : null;
  const model = typeof result.model === "string" && result.model ? result.model : request.summaries === "gemini" ? request.model ?? limits5.index.summaryModel : "none";
  const seconds = typeof result.seconds === "number" ? result.seconds * 1e3 : wallMs;
  const row = {
    run_id: request.run,
    step: INDEX_STEP,
    provider: request.summaries === "gemini" ? "gemini" : "pilib",
    model,
    input_tokens: count(result.prompt_tokens),
    output_tokens: count(result.completion_tokens),
    cost_usd: cost,
    latency_ms: Math.max(0, Math.round(Math.max(seconds, wallMs))),
    exit: ok ? "OK" : code === "call_cap" ? "CAP_REACHED" : "ERROR",
    same_family: false
  };
  return appendUsage(indexer.project, row);
}
async function indexBook(indexer, request) {
  if (!PLAIN_ID.test(request.troveId)) throw new LibraryError("usage", "ERROR library index: --trove-id must be a plain id (letters, digits and . _ # : - only)");
  if (request.bookId !== void 0 && !PLAIN_ID.test(request.bookId)) throw new LibraryError("usage", "ERROR library index: --book-id must be a plain id (letters, digits and . _ # : - only)");
  if (!SUMMARY_MODES.includes(request.summaries)) throw new LibraryError("usage", "ERROR library index: --summaries must be gemini, hints or none");
  if (request.model !== void 0 && !/^[A-Za-z0-9._/:-]{1,80}$/u.test(request.model)) throw new LibraryError("usage", "ERROR library index: --model must be a plain model name");
  await ensureCanIndex(indexer);
  const env = pageindexEnv(indexer, request.dryRun ? "none" : request.summaries);
  if (request.summaries === "gemini" && indexer.source === "installed" && !request.dryRun && geminiKeyFrom(indexer.env) === null) {
    return { ok: false, code: "missing_key", message: plainFailure("missing_key", ""), needs_yes: false, result: { trove_id: request.troveId }, read_back: null, ledger_recorded: false };
  }
  const cap = callCap(request);
  const args2 = [
    "index-trove",
    request.troveId,
    "--summaries",
    request.summaries,
    "--max-calls",
    String(cap),
    ...request.bookId ? ["--book-id", request.bookId] : [],
    ...request.noFallback ? ["--no-fallback"] : [],
    ...request.model ? ["--model", request.model] : [],
    ...request.concurrency ? ["--concurrency", String(request.concurrency)] : [],
    ...request.dryRun ? ["--dry-run"] : []
  ];
  const started = Date.now();
  const captured = await runCapture(indexer.command, args2, { timeoutMs: limits5.index.timeoutMs, maxBuffer: limits5.maxBufferBytes, env, cwd: indexer.project });
  const wall = Date.now() - started;
  if (captured.timedOut) throw new LibraryError("timeout", `ERROR library index: the PageIndex command did not finish within ${Math.round(limits5.index.timeoutMs / 6e4)} minutes and was stopped. The Trove copy is fine; run it again to continue (summaries already written are kept).`);
  if (captured.spawnError) throw new LibraryError("config", `ERROR library index: the PageIndex command could not be started (${redact(captured.spawnError)}).`);
  const answer = lastJson(captured.stdout);
  if (answer === null) {
    if (/invalid choice|unrecognized/iu.test(captured.stderr)) throw new LibraryError("config", `ERROR library index: ${OLD_COMMAND}`);
    const tail = redact(captured.stderr).replace(/\s+/gu, " ").trim().slice(-200);
    return { ok: false, code: "internal", message: plainFailure("internal", tail || `exit ${captured.code ?? "signal"}`), needs_yes: false, result: { trove_id: request.troveId }, read_back: null, ledger_recorded: false };
  }
  const result = pick(answer);
  if (answer.ok !== true || captured.code !== 0) {
    const code = typeof answer.code === "string" ? answer.code : "internal";
    const ledger2 = request.dryRun ? false : await recordUsage(indexer, request, answer, false, code, wall);
    const needsYes = code === "call_cap" && !request.yes && request.summaries === "gemini" && cap === limits5.index.askAboveCalls;
    const detail = typeof answer.error === "string" ? answer.error : "";
    const base = plainFailure(code, code === "call_cap" ? `${cap} calls` : detail);
    return { ok: false, code, message: needsYes ? `${base} This book needs more than ${limits5.index.askAboveCalls} Gemini calls: ask the researcher, then run it again with --yes.` : base, needs_yes: needsYes, result: { ...pick(answer), trove_id: request.troveId }, read_back: null, ledger_recorded: ledger2 };
  }
  if (request.dryRun) return { ok: true, code: null, message: null, needs_yes: false, result, read_back: null, ledger_recorded: false };
  const readBack = request.verify ? await verifyBook(indexer, request, result) : null;
  const ledger = await recordUsage(indexer, request, answer, readBack === null || readBack.ok, readBack && !readBack.ok ? "read_back_failed" : null, wall);
  if (readBack && !readBack.ok) return { ok: false, code: "read_back_failed", message: plainFailure("read_back_failed", readBack.problems.join("; ")), needs_yes: false, result, read_back: readBack, ledger_recorded: ledger };
  return { ok: true, code: null, message: null, needs_yes: false, result, read_back: readBack, ledger_recorded: ledger };
}
function walkTree(nodes, visit) {
  if (!Array.isArray(nodes)) return;
  for (const entry of nodes) {
    if (typeof entry !== "object" || entry === null) continue;
    visit(entry);
    walkTree(entry.nodes, visit);
  }
}
async function pilibJson(indexer, args2) {
  try {
    const out = await runCommand(indexer.command, args2, { timeoutMs: limits5.timeoutMs.primary, maxBuffer: limits5.maxBufferBytes, env: pageindexEnv(indexer, "none"), cwd: indexer.project });
    return lastJson(out);
  } catch {
    return null;
  }
}
async function verifyBook(indexer, request, result) {
  const bookId = typeof result.book_id === "string" ? result.book_id : request.bookId ?? request.troveId;
  const problems = [];
  const checks = {};
  const pages = count(result.n_pages);
  const meta = await pilibJson(indexer, ["meta", bookId]);
  checks.meta = meta !== null && count(meta.n_pages) === pages && (meta.trove_id === void 0 || meta.trove_id === null || meta.trove_id === request.troveId);
  if (!checks.meta) problems.push(meta === null ? "the book cannot be read back from the library" : `the library says ${count(meta.n_pages)} pages, the index run said ${pages}`);
  const tree = await pilibJson(indexer, ["tree", bookId]);
  let nodes = 0;
  let outOfRange = 0;
  let summarised = 0;
  walkTree(tree?.structure, (node) => {
    nodes += 1;
    const start = node.start_index;
    const end = node.end_index;
    if (!(typeof start === "number" && typeof end === "number" && Number.isInteger(start) && Number.isInteger(end) && start >= 1 && start <= end && end <= pages)) outOfRange += 1;
    if (String(node.summary ?? node.prefix_summary ?? "").trim()) summarised += 1;
  });
  const shortened = tree !== null && typeof tree.note === "string";
  checks.tree = tree !== null && nodes > 0 && outOfRange === 0 && (shortened || nodes === count(result.nodes));
  if (tree === null || nodes === 0) problems.push("the outline cannot be read back");
  else {
    if (outOfRange > 0) problems.push(`${outOfRange} outline entries point outside the book`);
    if (!shortened && nodes !== count(result.nodes)) problems.push(`the outline has ${nodes} entries, the index run said ${count(result.nodes)}`);
  }
  const warnings = Array.isArray(result.warnings) ? result.warnings : [];
  if (result.source === "trove-toc" && warnings.length === 0 && count(result.nodes) !== count(result.toc_entries)) {
    checks.toc_entries = false;
    problems.push(`the outline has ${count(result.nodes)} entries but Trove's table of contents has ${count(result.toc_entries)}`);
  }
  if (result.summaries === "gemini" || result.summaries === "hints") {
    const have = shortened || nodes === 0 ? count(result.nodes_with_summary) : summarised;
    const of = shortened || nodes === 0 ? count(result.nodes) : nodes;
    const share = of === 0 ? 0 : have / of;
    checks.summaries = `${Math.round(share * 100)}%`;
    if (share < limits5.index.minSummaryShare) problems.push(`only ${Math.round(share * 100)}% of the outline entries carry a summary (at least ${Math.round(limits5.index.minSummaryShare * 100)}% expected)`);
    if (!shortened && nodes > 0 && Math.abs(summarised - count(result.nodes_with_summary)) > Math.max(1, Math.round(nodes * 0.05))) problems.push("the summaries read back do not match the index run");
  }
  const wanted = Array.from({ length: Math.min(limits5.index.verifyPages, pages) }, (_, index) => index + 1);
  const spec = wanted.length === 0 ? "" : `${wanted[0]}-${wanted[wanted.length - 1]}`;
  const read = wanted.length === 0 ? null : await pilibJson(indexer, ["read", bookId, spec, "--json"]);
  const got = Array.isArray(read?.pages) ? read.pages : [];
  checks.pages = wanted.length > 0 && got.length === wanted.length && got.every((entry) => typeof entry.content === "string" && entry.content.trim() !== "");
  if (!checks.pages) problems.push("the first pages cannot be read back from the library");
  let troveCompared = false;
  if (checks.pages && wanted.length > 0) {
    try {
      const trove = new TroveBackend({ command: indexer.config.troveCommand, env: childEnv(indexer.env, { kind: "trove" }), timeoutMs: limits5.timeoutMs.primary, cwd: indexer.project });
      const theirs = await trove.read(request.troveId, wanted);
      troveCompared = true;
      const byPage = new Map(theirs.pages.map((entry) => [entry.page, squash(entry.text)]));
      const same = got.every((entry) => byPage.get(Number(entry.page)) === squash(String(entry.content)));
      checks.trove_pages = same;
      if (!same) problems.push("the first pages in the library differ from the pages in Trove");
    } catch {
      checks.trove_pages = "not compared (Trove did not answer here)";
    }
  }
  return { ok: problems.length === 0, trove_compared: troveCompared, checks, problems };
}
function indexOutput(indexer, outcome, request) {
  return {
    ok: outcome.ok,
    command: "library index",
    ...outcome.code ? { code: outcome.code } : {},
    ...outcome.message ? { error: outcome.message } : {},
    ...outcome.needs_yes ? { needs_yes: true } : {},
    ...outcome.result,
    pageindex_source: indexer.source,
    ...outcome.read_back ? { read_back: outcome.read_back } : {},
    ...request.dryRun ? {} : { ledger: { run_id: request.run, step: INDEX_STEP, recorded: outcome.ledger_recorded } }
  };
}

// src/library/backfill.ts
var limits6 = thresholds_default.library;
var whole2 = (value) => typeof value === "number" && Number.isInteger(value) && value >= 0 ? value : null;
async function listTrove(indexer, selector) {
  const env = childEnv(indexer.env, { kind: "trove" });
  const timeoutMs = limits6.timeoutMs.readAll;
  if (selector.kind === "ids") return selector.ids.map((id) => ({ id, title: "", pages: null }));
  if (selector.kind === "shelf") return (await new TroveBackend({ command: indexer.config.troveCommand, env, timeoutMs, cwd: indexer.project }).list()).map((book) => ({ id: book.id, title: book.title, pages: book.pageCount }));
  const out = await runCommand(indexer.config.troveCommand, ["items", "list", "--json"], { timeoutMs, maxBuffer: limits6.maxBufferBytes, env, cwd: indexer.project });
  let parsed;
  try {
    parsed = JSON.parse(out);
  } catch {
    throw new LibraryError("parse", "ERROR library backfill: trove items list did not return JSON");
  }
  const items = Array.isArray(parsed?.items) ? parsed.items : [];
  return items.flatMap((item) => {
    const record = typeof item === "object" && item !== null ? item : {};
    return typeof record.id === "string" && PLAIN_ID.test(record.id) ? [{ id: record.id, title: typeof record.title === "string" ? record.title : "", pages: whole2(record.pageCount) }] : [];
  });
}
async function candidates(indexer, request) {
  let base;
  try {
    base = await listTrove(indexer, request.selector);
  } catch (error) {
    throw new LibraryError(error instanceof LibraryError && error.code !== "exit" ? error.code : "exit", `ERROR library backfill: the list of books could not be read from Trove (${clipError(errorMessage(error).replace(/^ERROR library: /u, ""))}). Nothing was indexed.`);
  }
  const trove = new TroveBackend({ command: indexer.config.troveCommand, env: childEnv(indexer.env, { kind: "trove" }), timeoutMs: limits6.timeoutMs.primary, cwd: indexer.project });
  const list = [];
  const unreadable = [];
  for (const book of base) {
    try {
      const toc = await trove.toc(book.id);
      list.push({ id: book.id, title: book.title || toc.title || book.id, pages: book.pages, tocEntries: toc.toc.length, hinted: toc.toc.filter((entry) => entry.title.includes(" - ")).length });
    } catch (error) {
      unreadable.push({ id: book.id, error: clipError(errorMessage(error).replace(/^ERROR library: /u, "")) });
    }
  }
  return { list, unreadable };
}
async function alreadyIndexed(indexer, book) {
  const meta = await pilibJson(indexer, ["meta", book.id]);
  const origin = (typeof meta?.origin === "object" && meta.origin !== null ? meta.origin : {}).trove;
  if (!origin) return false;
  const pages = whole2(origin.trove_pages);
  const entries = whole2(origin.toc_entries);
  return pages !== null && entries !== null && entries === book.tocEntries && (book.pages === null || book.pages === pages);
}
async function plan(indexer, request) {
  const { list, unreadable } = await candidates(indexer, request);
  const lines = [];
  let planned = 0;
  for (const book of list) {
    const fallback = book.tocEntries === 0 || book.hinted * 2 < book.tocEntries;
    const line = { id: book.id, title: book.title, pages: book.pages, toc_entries: book.tocEntries, hinted_entries: book.hinted, action: "index", reason: null, expected_calls: request.summaries === "gemini" ? fallback ? null : book.tocEntries : 0, likely_fallback: fallback };
    if (request.limit !== void 0 && planned >= request.limit) {
      line.action = "skip";
      line.reason = "over the --limit";
    } else if (request.skipExisting && await alreadyIndexed(indexer, book)) {
      line.action = "skip";
      line.reason = "already indexed (same pages and outline length)";
    } else if (fallback && request.noFallback) {
      line.action = "skip";
      line.reason = "no table of contents with hints and --no-fallback was given";
    } else planned += 1;
    lines.push(line);
  }
  return { lines, unreadable };
}
var STOP_CODES = /* @__PURE__ */ new Set(["missing_key", "core_helper_missing", "model_failed"]);
async function runBackfill(indexer, request) {
  await ensureCanIndex(indexer);
  const { lines, unreadable } = await plan(indexer, request);
  const todo = lines.filter((line) => line.action === "index");
  const estimated = todo.reduce((sum3, line) => sum3 + (line.expected_calls ?? 0), 0);
  const fallbackBooks = todo.filter((line) => line.likely_fallback).length;
  const askRequired = request.summaries === "gemini" && (estimated > limits6.index.askAboveCalls || fallbackBooks > 0);
  const summary = {
    command: "library backfill",
    run_id: request.run,
    summaries: request.summaries,
    model: request.summaries === "gemini" ? request.model ?? limits6.index.summaryModel : null,
    pageindex_source: indexer.source,
    books: lines.length,
    to_index: todo.length,
    skipped: lines.length - todo.length,
    unreadable,
    estimated_calls: estimated,
    estimated_calls_note: "one Gemini call per outline entry; books without a hinted table of contents are not counted",
    books_without_hinted_toc: fallbackBooks,
    ask_required: askRequired,
    ask_above_calls: limits6.index.askAboveCalls,
    plan: lines
  };
  if (request.dryRun) return { output: { ok: true, dry_run: true, ...summary }, exit: 0 };
  if (askRequired && !request.yes) {
    return { output: { ok: false, code: "needs_confirmation", error: `This backfill would send book text to Google (Gemini) for about ${estimated} summaries${fallbackBooks > 0 ? ` plus ${fallbackBooks} book${fallbackBooks === 1 ? "" : "s"} without a hinted table of contents, whose cost cannot be counted ahead` : ""}. Show the plan to the researcher, ask, then run it again with --yes.`, ...summary }, exit: 2 };
  }
  const results = unreadable.map((entry) => ({ id: entry.id, title: "", status: "failed", code: "trove_failed", error: plainFailure("trove_failed", entry.error) }));
  let calls = 0;
  let promptTokens = 0;
  let completionTokens = 0;
  let cost = 0;
  let costKnown = false;
  let stopped = null;
  for (const line of lines) {
    if (line.action === "skip") {
      results.push({ id: line.id, title: line.title, status: "skipped", reason: line.reason });
      continue;
    }
    if (stopped) {
      results.push({ id: line.id, title: line.title, status: "not_run", reason: stopped });
      continue;
    }
    const one = { troveId: line.id, summaries: request.summaries, noFallback: request.noFallback, maxCalls: request.maxCalls, model: request.model, dryRun: false, yes: request.yes, run: request.run, verify: request.verify };
    try {
      const outcome = await indexBook(indexer, one);
      const result = outcome.result;
      calls += whole2(result.calls) ?? 0;
      promptTokens += whole2(result.prompt_tokens) ?? 0;
      completionTokens += whole2(result.completion_tokens) ?? 0;
      if (typeof result.cost_usd === "number") {
        cost += result.cost_usd;
        costKnown = true;
      }
      results.push({
        id: line.id,
        title: line.title,
        status: outcome.ok ? "indexed" : "failed",
        ...outcome.code ? { code: outcome.code } : {},
        ...outcome.message ? { error: outcome.message } : {},
        source: result.source ?? null,
        fallback: result.fallback ?? null,
        nodes: result.nodes ?? null,
        n_pages: result.n_pages ?? null,
        calls: result.calls ?? 0,
        cost_usd: result.cost_usd ?? null,
        ...outcome.read_back ? { read_back_ok: outcome.read_back.ok } : {}
      });
      if (!outcome.ok && outcome.code && STOP_CODES.has(outcome.code)) stopped = `stopped after ${line.id}: ${outcome.code}`;
    } catch (error) {
      results.push({ id: line.id, title: line.title, status: "failed", code: error instanceof LibraryError ? error.code : "internal", error: plainFailure("internal", errorMessage(error).replace(/^ERROR library[a-z ]*: /u, "")) });
    }
  }
  const failed = results.filter((entry) => entry.status === "failed").length;
  return {
    output: {
      ok: failed === 0,
      command: "library backfill",
      run_id: request.run,
      summaries: request.summaries,
      pageindex_source: indexer.source,
      books: lines.length,
      indexed: results.filter((entry) => entry.status === "indexed").length,
      skipped: results.filter((entry) => entry.status === "skipped").length,
      failed,
      not_run: results.filter((entry) => entry.status === "not_run").length,
      calls,
      prompt_tokens: promptTokens,
      completion_tokens: completionTokens,
      cost_usd: costKnown ? Math.round(cost * 1e6) / 1e6 : null,
      unreadable,
      results
    },
    exit: failed === 0 ? 0 : 4
  };
}

