async function classify(items, runId2) {
  return endRunOnError(runId2, "revise", () => classifyItems(items, runId2));
}
async function classifyItems(items, runId2) {
  startRunOnce(runId2, "revise");
  emit(runId2, "revise", "step_start", { step: "read" });
  const schema3 = { type: "OBJECT", properties: { items: { type: "ARRAY", items: { type: "OBJECT", properties: { id: { type: "STRING" }, category: { type: "STRING", enum: ["text_edit", "argument", "voice_signal", "plugin_defect"] }, proposal: { type: "OBJECT" } }, required: ["id", "category", "proposal"] } } }, required: ["items"] };
  const fallback = async () => {
    const caps = thresholds_default.budget.revise;
    const result2 = await callGemini({ step: "revise.classify", system: "Classify review feedback accurately. Return JSON only.", parts: [JSON.stringify(items)], responseSchema: schema3, runId: runId2, budget: new Budget(runId2, caps) });
    return JSON.stringify(result2.json);
  };
  const result = await decide({ point: "revise.classify", question: "Classify each Word review item.", options: ["text_edit", "argument", "voice_signal", "plugin_defect"], context: JSON.stringify(items), runId: runId2, fallback });
  const parsed = JSON.parse(result.answer);
  if (typeof parsed !== "object" || parsed === null || !Array.isArray(parsed.items)) throw new Error("ERROR revise.classify: missing verdict");
  emit(runId2, "revise", "step_end", { step: "read" });
  return parsed;
}
function applyTextEdit(item) {
  const file = item.proposal.file;
  const before = item.proposal.before;
  const after = item.proposal.after;
  if (typeof file !== "string" || typeof before !== "string" || typeof after !== "string") return;
  const target = join14(projectDir(), file);
  const body = readFileSync10(target, "utf8");
  if (!body.includes(before)) throw new Error(`ERROR revise.apply: anchor not found for ${item.id}`);
  writeFileSync4(target, body.replace(before, after), "utf8");
}
async function applyPlan(plan2) {
  return endRunOnError(plan2.runId, "revise", () => applyItems(plan2));
}
async function applyItems(plan2) {
  if (!dataOverride2) dataDir();
  const applied = [];
  const deferred = [];
  const feedbackDir = join14(dataOverride2 ?? dataDir(), "feedback");
  startRunOnce(plan2.runId, "revise");
  emit(plan2.runId, "revise", "step_start", { step: "update-draft" });
  for (const item of plan2.items) {
    append(join14(dataOverride2 ?? dataDir(), "labels", "revise.classify.jsonl"), { point: "revise.classify", itemId: item.id, label: item.category });
    if (typeof item.proposal.changeId === "string" && (item.proposal.label === "uphold" || item.proposal.label === "refute")) {
      append(join14(dataOverride2 ?? dataDir(), "labels", "proofread.verify.jsonl"), { point: "proofread.verify", changeId: item.proposal.changeId, label: item.proposal.label });
    }
    if (item.category === "text_edit") {
      applyTextEdit(item);
      applied.push(item.id);
    } else if (item.category === "argument") {
      const file = join14(projectDir(), ".academic-helper", "revise-todo.md");
      mkdirSync7(join14(projectDir(), ".academic-helper"), { recursive: true });
      appendFileSync7(file, `
- [ ] ${String(item.proposal.text ?? JSON.stringify(item.proposal))}
`, "utf8");
      deferred.push(item.id);
    } else if (item.category === "plugin_defect") {
      append(join14(feedbackDir, "ledger.jsonl"), { ts: (/* @__PURE__ */ new Date()).toISOString(), runId: plan2.runId, step: String(item.proposal.step ?? "unknown"), item: item.proposal, authorWords: String(item.proposal.authorWords ?? ""), pluginVersion: plan2.pluginVersion });
      applied.push(item.id);
    } else {
      const accepted = await confirm([item]);
      if (!accepted) {
        deferred.push(item.id);
        continue;
      }
      const dir = voiceDir();
      mkdirSync7(dir, { recursive: true });
      appendVoicePair({ before: String(item.proposal.before ?? ""), after: String(item.proposal.after ?? ""), source: plan2.runId }, dataOverride2 ?? dataDir());
      if (item.proposal.styleWords !== void 0) writeVoiceStyleWords(item.proposal.styleWords, dataOverride2 ?? dataDir());
      if (item.proposal.terms !== void 0) writeFileSync4(join14(projectDir(), ".academic-helper", "terms.json"), JSON.stringify(item.proposal.terms, null, 2), "utf8");
      applied.push(item.id);
    }
  }
  emit(plan2.runId, "revise", "step_end", { step: "update-draft" });
  emit(plan2.runId, "revise", "step_start", { step: "update-stores" });
  emit(plan2.runId, "revise", "step_end", { step: "update-stores" });
  emit(plan2.runId, "revise", "run_end", { exit: "OK" });
  return { applied, deferred };
}

