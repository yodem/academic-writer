// src/library/eval/files.ts
var EVAL_ROOT = join19(".academic-helper", "library-eval");
var EVAL_ID = /^[A-Za-z0-9][A-Za-z0-9-]{0,39}$/u;
function guardEvalDirs(project, evalId) {
  const refuse = (what) => {
    throw new LibraryError("config", `ERROR library eval: ${what}; refusing to use it`);
  };
  let real;
  try {
    real = realpathSync3(project);
  } catch {
    return refuse("the project folder cannot be resolved");
  }
  const helper = join19(project, ".academic-helper");
  if (!existsSync13(helper)) return;
  let helperReal;
  try {
    helperReal = realpathSync3(helper);
  } catch {
    return refuse(".academic-helper cannot be resolved");
  }
  if (helperReal !== real && !helperReal.startsWith(`${real}${sep2}`)) refuse(".academic-helper points outside the project");
  const evalRoot = join19(helperReal, "library-eval", evalId);
  for (const dir of [join19(helperReal, "library-eval"), evalRoot, join19(evalRoot, "runs"), join19(evalRoot, "sealed"), join19(evalRoot, "archive")]) {
    let info;
    try {
      info = lstatSync2(dir);
    } catch {
      continue;
    }
    if (info.isSymbolicLink()) refuse(`${dir.slice(helperReal.length + 1)} is a symbolic link`);
    if (!info.isDirectory()) refuse(`${dir.slice(helperReal.length + 1)} is not a folder`);
  }
}
function evalPaths(project, evalId) {
  if (!EVAL_ID.test(evalId)) throw new LibraryError("usage", "ERROR library eval: --eval must be a plain id (letters, digits and hyphens, up to 40)");
  guardEvalDirs(project, evalId);
  const root = join19(project, EVAL_ROOT, evalId);
  return {
    root,
    plan: join19(root, "plan.json"),
    runsDir: join19(root, "runs"),
    pairs: join19(root, "pairs.json"),
    sealedDir: join19(root, "sealed"),
    mapping: join19(root, "sealed", "mapping.json"),
    judgments: join19(root, "judgments.json"),
    reportJson: join19(root, "report.json"),
    reportMd: join19(root, "report.md"),
    judgeHtml: join19(root, "judge.html"),
    archiveDir: join19(root, "archive")
  };
}
async function fileSha(file) {
  try {
    return sha256(await readFile4(file));
  } catch {
    return null;
  }
}
function runFile(paths, claimId, route) {
  return join19(paths.runsDir, `${claimId}-${route}.json`);
