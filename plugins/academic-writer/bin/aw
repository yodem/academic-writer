}
function loadSourceKeys() {
  const path2 = join15(projectDir(), ".academic-helper", "sources.json");
  if (!existsSync9(path2)) return /* @__PURE__ */ new Set();
  try {
    const raw = JSON.parse(readFileSync11(path2, "utf8"));
    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.sources) ? raw.sources : [];
    return new Set(list.map((entry) => {
      const source = entry;
      return String(source.sourceId ?? source.id ?? "");
    }).filter(Boolean));
  } catch {
    return /* @__PURE__ */ new Set();
  }
}
function withPassageKeys(given) {
  const sourceKeys = new Set(given);
  const path2 = join15(projectDir(), ".academic-helper", "evidence.json");
  if (!existsSync9(path2)) return sourceKeys;
  try {
    const raw = JSON.parse(readFileSync11(path2, "utf8"));
    for (const source of raw.sources ?? []) sourceKeys.add(source.id);
    const keys = new Set(sourceKeys);
    for (const passage of raw.passages ?? []) if (sourceKeys.has(passage.sourceId)) keys.add(passage.id);
    return keys;
  } catch {
    return sourceKeys;
  }
}
function evidencePassagesFor(unit) {
  const path2 = join15(projectDir(), ".academic-helper", "evidence.json");
