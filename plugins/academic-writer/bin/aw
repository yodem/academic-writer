    const dir = await containedDir(parsed.data.project, ["retrieval"]);
    if (!dir) return null;
    const expected = join10(dir, `spec-${parsed.data.lookup_id}.json`);
    if (await realpath2(path2) !== expected) return null;
    await rm3(expected, { force: true });
    return parsed.data;
  } catch {
    return null;
  }
}
var round3 = (value) => Math.round(value * 1e3) / 1e3;
function compareRoutes(primary, shadowPages) {
  if (primary.ok === false || primary.too_large) return null;
  const shadowByPage = new Map(shadowPages.map((entry) => [entry.page, entry.text]));
  const entries = primary.pages.map((entry) => {
    const other = shadowByPage.get(entry.page);
    const overlap = other === void 0 ? 0 : jaccard(entry.text, other);
    return { page: entry.page, jaccard: round3(overlap), agree: other !== void 0 && overlap >= limits3.agree.jaccardMin };
  });
  const agreed = entries.filter((entry) => entry.agree).length;
  return { rate: entries.length === 0 ? null : round3(agreed / entries.length), compared: entries.length, agreed, pages: entries.slice(0, limits3.ledger.maxAgreePages) };
}
async function waitForPrimary(spec, started, settings) {
  const file = spoolFile(spec.project, spec.lookup_id, "primary");
  for (; ; ) {
    const found = await readSpool(spec.project, file);
    if (found) return found;
    if (Date.now() - started >= settings.primaryWaitMs) return null;
    await sleep2(limits3.shadow.pollMs);
  }
}
async function runShadowWorker(spec, runner2, settings) {
  const started = Date.now();
  const scope = new CommandScope();
  let result = null;
  let failure = null;
  let timedOut = false;
  let timer;
  try {
    await sweepSpool(spec.project);
    const call = runner2.runShadow(spec, scope);
    call.catch(() => void 0);
    const deadline = new Promise((resolveDeadline) => {
      timer = setTimeout(() => {
        resolveDeadline("timeout");
      }, settings.timeoutMs);
    });
    try {
      const outcome = await Promise.race([call, deadline]);
      if (outcome === "timeout") timedOut = true;
      else result = outcome;
    } catch (error) {
      failure = error;
      timedOut = error instanceof LibraryError && error.code === "timeout";
    }
    clearTimeout(timer);
    if (timedOut || scope.aborted) {
      timedOut = true;
      scope.abort();
      result = null;
    }
    const latency2 = Date.now() - started;
    let agree = null;
    if (spec.op === "read" && result?.pages) {
      await writeSpool(spec.project, spoolFile(spec.project, spec.lookup_id, "shadow"), spoolValue(spec.lookup_id, { route: spec.route, ok: true }, result.pages));
      const primary = await waitForPrimary(spec, started, settings);
      agree = primary ? compareRoutes(primary, result.pages) : null;
    }
    const code = failure instanceof LibraryError ? failure.code : failure ? "error" : null;
    const row = {
      row_type: "shadow",
      schema: 1,
      ts: nowIso(),
      lookup_id: spec.lookup_id,
      run_id: spec.run_id,
      route: spec.route,
      ok: result !== null,
      book: result?.book ?? null,
      route_pages: result?.route_pages ?? null,
      latency_ms: latency2,
      bytes: result?.bytes ?? 0,
      chars: result?.chars ?? 0,
      text_sha: result?.text_sha ?? null,
      error: result ? null : clipError(timedOut ? `${spec.route} did not answer within ${settings.timeoutMs} ms` : failure instanceof Error ? failure.message : String(failure ?? "no answer")),
      error_code: result ? null : timedOut ? "timeout" : code,
      timed_out: timedOut,
      agree,
      ...result?.est_tokens !== void 0 ? { est_tokens: result.est_tokens, tokens_basis: TOKENS_BASIS } : {}
    };
    await appendRow(spec.project, row);
  } catch {
  } finally {
    clearTimeout(timer);
    scope.abort();
    await releaseSlot(spec.project, spec.slot === null || !spec.slot_nonce ? null : { slot: spec.slot, nonce: spec.slot_nonce });
    await removeSpool(spec.project, spoolFile(spec.project, spec.lookup_id, "primary"));
  }
}

// src/library/registry.ts
import { existsSync as existsSync6, readFileSync as readFileSync7 } from "node:fs";
import { join as join11 } from "node:path";
function stripFragment(id) {
  const index = id.indexOf("#");
  return index >= 0 ? id.slice(0, index) : id;
}
function findSource(project, sourceId) {
  const file = join11(project, ".academic-helper", "sources.json");
  if (!existsSync6(file)) return void 0;
  let raw;
  try {
    raw = JSON.parse(readFileSync7(file, "utf8"));
  } catch {
    return void 0;
  }
  const list = Array.isArray(raw) ? raw : raw?.sources;
  if (!Array.isArray(list)) return void 0;
  const base = stripFragment(sourceId);
  const records2 = list.filter((entry) => typeof entry === "object" && entry !== null);
  const idOf = (entry) => String(entry.sourceId ?? entry.id ?? "");
  const hit = records2.find((entry) => idOf(entry) === sourceId) ?? records2.find((entry) => stripFragment(idOf(entry)) === base);
  if (!hit) return void 0;
  const parsed = parseSourcePageMap(hit.pageMap);
  return { id: idOf(hit), ...parsed.map ? { pageMap: parsed.map } : {}, ...parsed.warning ? { warning: parsed.warning } : {} };
}
function loadShelf(path2) {
  if (!path2) return { books: null, map: /* @__PURE__ */ new Map() };
  const bad = (why) => new LibraryError("config", `ERROR library: the PageIndex shelf ${path2} ${why}; fix it or remove "pageindex.shelf" from library.json`);
  if (!existsSync6(path2)) throw bad("does not exist");
  let raw;
  try {
    raw = JSON.parse(readFileSync7(path2, "utf8"));
  } catch (error) {
    throw bad(error instanceof SyntaxError ? "is not valid JSON" : "cannot be read");
  }
  const strings = (value) => Array.isArray(value) && value.every((entry) => typeof entry === "string");
  const record = typeof raw === "object" && raw !== null && !Array.isArray(raw) ? raw : void 0;
  if (!Array.isArray(raw) && !record) throw bad('must be a list of book ids or an object with "books" and/or "map"');
  const books = Array.isArray(raw) ? raw : record?.books;
  const mapRaw = record?.map;
  if (books !== void 0 && !strings(books)) throw bad('has a "books" list that is not a list of book id strings');
  if (mapRaw !== void 0 && (typeof mapRaw !== "object" || mapRaw === null || Array.isArray(mapRaw))) throw bad('has a "map" that is not an object');
  if (books === void 0 && mapRaw === void 0) throw bad('has neither "books" nor "map"');
  const map = /* @__PURE__ */ new Map();
  for (const [source, value] of Object.entries(mapRaw ?? {})) {
    const entry = typeof value === "object" && value !== null ? value : void 0;
    if (!entry || typeof entry.book !== "string" || !entry.book) throw bad(`has a map entry "${source}" without a "book" id`);
    let pages = "auto";
    if (entry.pages === "identity") pages = "identity";
    else if (typeof entry.pages === "object" && entry.pages !== null) {
      const pagemap = entry.pages.pagemap;
      if (!Array.isArray(pagemap) || !pagemap.every((n) => Number.isInteger(n))) throw bad(`has a map entry "${source}" whose pagemap is not a list of whole numbers`);
      pages = { kind: "pagemap", pdfToTrove: pagemap };
    } else if (entry.pages !== void 0) throw bad(`has a map entry "${source}" with an unknown "pages" value`);
    map.set(source, { book: entry.book, pages });
  }
  return { books: strings(books) ? books : [...new Set([...map.values()].map((entry) => entry.book))], map };
}

// src/library/adapter.ts
var limits4 = thresholds_default.library;
var FORCED_ROUTE_ENV = "AW_LIBRARY_ROUTE";
function forcedRouteFrom(env) {
  const value = env[FORCED_ROUTE_ENV]?.trim();
  if (!value) return null;
  if (value === "trove" || value === "pageindex") return value;
  throw new LibraryError("config", `ERROR library: ${FORCED_ROUTE_ENV} must be trove or pageindex (got "${value.slice(0, 40)}")`);
}
function forceRoute(config, route) {
  return { ...config, route, primary: route, secondary: null, shadowEnabled: false };
}
function newLookupId() {
  return `lk_${Date.now().toString(36)}${randomBytes2(4).toString("hex")}`;
}
var Library = class _Library {
  constructor(project, env = process.env, options = {}) {
    this.project = project;
    this.env = env;
    this.forced = forcedRouteFrom(env);
    const loaded = loadLibraryConfig(project, env);
    this.config = this.forced === null ? loaded : forceRoute(loaded, this.forced);
    const override = Number(env.AW_LIBRARY_TIMEOUT_MS);
    this.override = Number.isFinite(override) && override > 0 ? override : void 0;
    this.shadowMode = options.shadow ?? "off";
    this.scope = options.scope;
    const timeoutMs = options.timeoutMs ?? this.override ?? limits4.timeoutMs.primary;
    const readAllEnv = Number(env.AW_LIBRARY_READALL_TIMEOUT_MS);
    const readAllMs = options.readAllTimeoutMs ?? (Number.isFinite(readAllEnv) && readAllEnv > 0 ? readAllEnv : void 0) ?? options.timeoutMs ?? this.override ?? limits4.timeoutMs.readAll;
    this.trove = this.makeTrove(timeoutMs, readAllMs);
    this.pageindex = this.makePageIndex(timeoutMs, readAllMs);
  }
  config;
  /** The route AW_LIBRARY_ROUTE forced, or null. */
  forced;
  trove;
  pageindex;
  shelfCache;
  resolved = /* @__PURE__ */ new Map();
  shadowMode;
  scope;
  /** AW_LIBRARY_TIMEOUT_MS replaces every timeout (test and troubleshooting seam; the defaults live in thresholds.json). */
  override;
  makeTrove(timeoutMs, readAllTimeoutMs) {
    return new TroveBackend({ command: this.config.troveCommand, env: allowedEnv(this.env, "trove"), timeoutMs, readAllTimeoutMs, cwd: this.project, scope: this.scope });
  }
  makePageIndex(timeoutMs, readAllTimeoutMs) {
    return new PageIndexBackend({ command: this.config.pageindexCommand, env: allowedEnv(this.env, "pageindex"), timeoutMs, readAllTimeoutMs, cwd: this.project, scope: this.scope });
  }
  get shelf() {
    this.shelfCache ??= loadShelf(this.config.shelfPath);
    return this.shelfCache;
  }
  backend(route) {
    return route === "trove" ? this.trove : this.pageindex;
  }
  /** Which route book and page space a canonical source id means on `route`. Unknown PageIndex mappings fail loud. */
  async resolveBook(route, source) {
    const id = stripFragment(source);
    if (route === "trove") return { book: id, pages: { kind: "identity" } };
    const cached = this.resolved.get(id);
    if (cached) return cached;
    const found = await this.resolvePageIndex(id);
    this.resolved.set(id, found);
    return found;
  }
  async pagesFromMeta(book) {
    const meta = await this.pageindex.meta(book);
    if (!meta) return null;
    return meta.pagemap ? { kind: "pagemap", pdfToTrove: meta.pagemap } : { kind: "identity" };
  }
  async resolvePageIndex(id) {
    const shelf = this.shelf;
    const mapped = shelf.map.get(id);
    if (mapped) {
      if (mapped.pages === "identity") return { book: mapped.book, pages: { kind: "identity" } };
      if (mapped.pages !== "auto") return { book: mapped.book, pages: mapped.pages };
      const fromMeta = await this.pagesFromMeta(mapped.book);
      if (!fromMeta) throw new LibraryError("page_map", `ERROR library: cannot tell how PageIndex pages of ${mapped.book} map to Trove pages; add "pages": "identity" or a pagemap to the shelf map`);
      return { book: mapped.book, pages: fromMeta };
    }
    const catalog = await this.pageindex.catalog();
    const onShelf = (book) => shelf.books === null || shelf.books.includes(book);
    if (catalog.has(id) && onShelf(id)) return { book: id, pages: await this.pagesFromMeta(id) ?? { kind: "identity" } };
    const candidates2 = [...catalog.keys()].filter(onShelf);
    if (candidates2.length > limits4.pageindex.metaScanMax) throw new LibraryError("page_map", `ERROR library: ${id} is not in the shelf map and the shelf has too many books to search; add it to the shelf map`);
    let found;
    let next = 0;
    const worker = async () => {
      while (next < candidates2.length && !found) {
        const book = candidates2[next];
        next += 1;
        const meta = await this.pageindex.meta(book);
        if (meta?.trove_id === id) found = { book, pages: meta.pagemap ? { kind: "pagemap", pdfToTrove: meta.pagemap } : { kind: "identity" } };
      }
    };
    await Promise.all(Array.from({ length: Math.min(limits4.pageindex.metaScanConcurrency, candidates2.length) }, worker));
    if (!found) throw new LibraryError("page_map", `ERROR library: ${id} is not on this project's PageIndex shelf`);
    return found;
  }
  /** The route's books with plain ids only: an id that is not plain could carry a command into a shell, so it is dropped (and counted). */
  async listVia(route) {
    const all = await this.listRaw(route);
    const items = all.filter((book) => isPlainId(book.id));
    return { items, skipped: all.length - items.length };
  }
  async listRaw(route) {
    const books = await this.backend(route).list();
    if (route === "trove") return books;
    const shelf = this.shelf;
    const reverse = /* @__PURE__ */ new Map();
    for (const [source, entry] of shelf.map) reverse.set(entry.book, source);
    const visible = books.filter((book) => shelf.books === null || shelf.books.includes(book.id) || reverse.has(book.id));
    return visible.map((book) => ({ ...book, id: reverse.get(book.id) ?? book.id }));
  }
  async tocVia(route, source) {
    const { book, pages } = await this.resolveBook(route, source);
    const result = await this.backend(route).toc(book);
    const toc = result.toc.flatMap((entry) => {
      const page = routeToTrovePage(entry.page, pages);
      if (page === null) return [];
      return [{ ...entry, page, endPage: entry.endPage === null ? null : routeToTrovePage(entry.endPage, pages) }];
    });
    return { book, title: result.title ?? null, toc };
  }
  /** One route's answer for a page request, in canonical (Trove) page numbers. Used by the answering path and by the shadow. */
  async fetchPages(route, source, wanted) {
    const wantedAll = wanted === "all";
    const { book, pages: routePages } = await this.resolveBook(route, source);
    let routeWanted = "all";
    let missing = [];
    if (!wantedAll) {
      const mapped = troveToRoutePages(wanted, routePages);
      routeWanted = mapped.route;
      missing = mapped.missing;
    }
    const backend = this.backend(route);
    const raw = routeWanted === "all" || routeWanted.length > 0 ? await backend.read(book, routeWanted) : { pages: [] };
    const split = splitComplete(relabelPages(raw.pages, routePages), routePages);
    const canonical = split.complete;
    if (!wantedAll) {
      const have = new Set(canonical.map((page) => page.page));
      missing = [.../* @__PURE__ */ new Set([...missing, ...wanted.filter((page) => !have.has(page))])].sort((a, b) => a - b);
      if (canonical.length === 0) throw new LibraryError("page_missing", `ERROR library read: ${route} has none of the requested pages of ${source} (missing ${missing.join(",")})`);
    }
    if (wantedAll && routePages.kind === "pagemap") {
      const have = new Set(canonical.map((page) => page.page));
      missing = [...new Set(routePages.pdfToTrove)].filter((page) => !have.has(page)).sort((a, b) => a - b);
    }
    return { book, routePages, raw, canonical, missing };
  }
  // ------------------------------------------------------------ ledger and shadow
  /** The shadow for one lookup, started before the answering route is asked so the two overlap. Never throws, never waits for the worker. */
  async launch(op, source, pages, ids, lookupId) {
    const secondary = this.config.secondary;
    if (!secondary) return noShadow("none");
    if (!this.config.shadowEnabled || this.shadowMode === "off") return noShadow("disabled");
    if (!limits4.shadow.ops.includes(op)) return noShadow("skipped:op");
    if (Array.isArray(pages) && pages.length > limits4.shadow.readAllMaxPages) return noShadow("skipped:too_many_pages");
    const spec = { v: 1, lookup_id: lookupId, run_id: ids.run ?? null, claim_id: ids.claim ?? null, op, route: secondary, project: this.project, source, pages };
    return startShadow(spec, this.shadowMode, this.env, this);
  }
  /** Whether a whole-book read may still be shadowed once its size is known (never before: the size comes from the answer). */
  wholeBookGate() {
    if (!this.config.secondary) return "none";
    if (!this.config.shadowEnabled || this.shadowMode === "off") return "disabled";
    if (!limits4.shadow.ops.includes("read")) return "skipped:op";
    return null;
  }
  async spoolPrimary(lookupId, ok, pages) {
    await writeSpool(this.project, spoolFile(this.project, lookupId, "primary"), spoolValue(lookupId, { ok }, pages));
  }
  async writeLookup(p) {
    const route = this.config.primary;
    const row = {
      row_type: "lookup",
      schema: 1,
      ts: nowIso(),
      lookup_id: p.lookupId,
      run_id: p.ids.run ?? null,
      claim_id: p.ids.claim ?? null,
      op: p.op,
      source_id: p.source,
      mode: this.config.route,
      route_primary: route,
      book_by_route: { trove: route === "trove" ? p.book : null, pageindex: route === "pageindex" ? p.book : null },
      request: p.request,
      primary: {
        route,
        ok: p.ok,
        route_pages: p.routePages,
        latency_ms: p.latencyMs,
        bytes: p.bytes,
        chars: p.chars,
        text_sha: p.sha,
        error: p.ok ? null : clipError(errorMessage(p.error)),
        error_code: p.ok ? null : p.error instanceof LibraryError ? p.error.code : "error",
        ...p.ok && p.estTokens !== void 0 ? { est_tokens: p.estTokens, tokens_basis: TOKENS_BASIS } : {},
        ...p.ok && p.pagesReturned !== void 0 ? { pages_returned: p.pagesReturned } : {}
      },
      shadow_status: p.shadowStatus
    };
    await appendRow(this.project, row);
  }
  /** The ShadowRunner side: the same request on the other route, under the shadow timeout instead of the primary one; the worker records the outcome. */
  runShadow(spec, scope) {
    return new _Library(this.project, this.env, { shadow: "off", timeoutMs: workerSettings(this.env).timeoutMs, scope }).shadowCall(spec);
  }
  async shadowCall(spec) {
    if (spec.op === "list") return summarizeText(null, JSON.stringify((await this.listVia(spec.route)).items));
    if (spec.op === "toc") {
      const result = await this.tocVia(spec.route, spec.source ?? "");
      return summarizeText(result.book, JSON.stringify(result.toc));
    }
    const got = await this.fetchPages(spec.route, spec.source ?? "", spec.pages ?? "all");
    const text4 = got.canonical.map((page) => page.text).join("\n");
    return {
      book: got.book,
      route_pages: formatPageRanges(got.canonical.flatMap((page) => page.routePages)) || null,
      bytes: Buffer.byteLength(text4, "utf8"),
      chars: text4.length,
      text_sha: textSha(text4),
      est_tokens: estimateTokens(text4),
      pages: got.canonical.map((page) => ({ page: page.page, text: page.text }))
    };
  }
  /** A lookup that has no page text (list, toc): ask the answering route, record the lookup, let the shadow settle. */
  async tracked(op, source, ids, work) {
    const lookupId = newLookupId();
    const handle = await this.launch(op, source, null, ids, lookupId);
    const started = Date.now();
    const base = { lookupId, op, source, ids, request: { printed: null, trove_pages: null }, shadowStatus: handle.status };
    try {
      const { value, book, text: text4 } = await work(this.config.primary);
      await this.writeLookup({ ...base, book, ok: true, routePages: null, latencyMs: Date.now() - started, bytes: Buffer.byteLength(text4, "utf8"), chars: text4.length, sha: textSha(text4), error: null, estTokens: estimateTokens(text4) });
      await handle.settle();
      return value;
    } catch (error) {
      await this.writeLookup({ ...base, book: null, ok: false, routePages: null, latencyMs: Date.now() - started, bytes: 0, chars: 0, sha: null, error });
      await handle.settle();
      throw error;
    }
  }
  /** The answering route's books, as canonical ids (PageIndex books that map to a Trove id show that id). */
  async list(ids = {}) {
    return this.tracked("list", null, ids, async (route) => {
      const { items, skipped } = await this.listVia(route);
      return { value: { route, mode: this.config.route, items, skipped_invalid_ids: skipped }, book: null, text: JSON.stringify(items) };
    });
  }
  async toc(source, ids = {}) {
    return this.tracked("toc", stripFragment(source), ids, async (route) => {
      const result = await this.tocVia(route, source);
      return { value: { route, mode: this.config.route, source_id: stripFragment(source), title: result.title, toc: result.toc }, book: result.book, text: JSON.stringify(result.toc) };
    });
  }
  async read(request) {
    const route = this.config.primary;
    const source = stripFragment(request.source);
    let printedPages = null;
    let wanted;
    if (request.all) wanted = "all";
    else if (request.pages !== void 0) wanted = parsePageSpec(request.pages);
    else if (request.printed !== void 0) {
      const printed = parsePageSpec(request.printed);
      if (printed === "all") throw new LibraryError("usage", "ERROR library: --printed needs page numbers, not all");
      printedPages = printed;
      const record = findSource(this.project, request.source);
      try {
        wanted = printedToTrove(printed, record?.pageMap, this.project);
      } catch (error) {
        if (error instanceof LibraryError && error.code === "page_map") throw new LibraryError("usage", `${error.message}${record?.warning ? ` (${record.warning})` : ""}`);
        throw error;
      }
    } else throw new LibraryError("usage", "ERROR library read: give --pages A-B, --printed A-B or all");
    const wantedAll = wanted === "all";
    const ids = { run: request.run, claim: request.claim };
    const lookupId = newLookupId();
    const ledgerRequest = { printed: request.printed ?? null, trove_pages: wantedAll ? "all" : formatPageRanges(wanted) };
    const gate = wantedAll ? this.wholeBookGate() : null;
    let handle = wantedAll ? noShadow(gate ?? "skipped:primary_failed") : await this.launch("read", source, wanted, ids, lookupId);
    const started = Date.now();
    const op = request.op ?? "read";
    try {
      const got = await this.fetchPages(route, source, wanted);
      const { raw, canonical, routePages, missing } = got;
      const plain = canonical.map((page) => ({ page: page.page, text: page.text }));
      const title = raw.title ?? await this.backend(route).title(got.book);
      const chars = canonical.reduce((sum3, page) => sum3 + page.text.length, 0);
      if (wantedAll && gate === null) {
        if (canonical.length > limits4.shadow.readAllMaxPages) handle = noShadow("skipped:read_all");
        else {
          await this.spoolPrimary(lookupId, true, plain);
          handle = await this.launch("read", source, canonical.map((page) => page.page), ids, lookupId);
        }
      } else if (handle.status === "pending") await this.spoolPrimary(lookupId, true, plain);
      const text4 = canonical.map((page) => page.text).join("\n");
      const latencyMs = Date.now() - started;
      await this.writeLookup({
        lookupId,
        op,
        source,
        ids,
        request: ledgerRequest,
        book: got.book,
        ok: true,
        routePages: formatPageRanges(canonical.flatMap((page) => page.routePages)) || null,
        latencyMs,
        bytes: Buffer.byteLength(text4, "utf8"),
        chars,
        sha: textSha(text4),
        error: null,
        shadowStatus: handle.status,
        estTokens: estimateTokens(text4),
        pagesReturned: new Set(canonical.map((page) => page.page)).size
      });
      const output = {
        lookup_id: lookupId,
        op: "read",
        source_id: source,
        route,
        mode: this.config.route,
        shadow_status: handle.status,
        request: ledgerRequest,
        printed_pages: printedPages,
        title: title ?? null,
        page_count: raw.pageCount ?? null,
        pages: canonical.map((page) => ({ trove_page: page.page, text: page.text, route_pages: page.routePages })),
        missing_pages: missing,
        latency_ms: latencyMs,
        chars,
        ...raw.raw !== void 0 && routePages.kind === "identity" ? { raw: raw.raw } : {}
      };
      await handle.settle();
      return output;
    } catch (error) {
      if (handle.status === "pending") await this.spoolPrimary(lookupId, false, []);
      await this.writeLookup({ lookupId, op, source, ids, request: ledgerRequest, book: null, ok: false, routePages: null, latencyMs: Date.now() - started, bytes: 0, chars: 0, sha: null, error, shadowStatus: handle.status });
      await handle.settle();
      throw error;
    }
  }
  /** Report: the route setting, whether the answering route is usable, and with `check` one cheap list per route. */
  async status(check) {
    const { config } = this;
    const troveEnabled = profileTroveEnabled(this.project);
    const enabled = config.primary === "pageindex" ? true : troveEnabled !== false;
    const word = (command3) => (command3[0] ?? "").split("/").pop() ?? "";
    const report = {
      route: config.route,
      primary: config.primary,
      secondary: config.secondary,
      configured: config.configured,
      enabled,
      forced: this.forced,
      shadow: { enabled: config.shadowEnabled },
      shelf: config.shelfPath !== null,
      commands: { trove: word(config.troveCommand), pageindex: word(config.pageindexCommand) }
    };
    if (check) {
      const probe2 = async (route) => {
        const started = Date.now();
        try {
          const timeoutMs = this.override ?? limits4.timeoutMs.check;
          const items = await (route === "trove" ? this.makeTrove(timeoutMs) : this.makePageIndex(timeoutMs)).list();
          return { ok: true, latency_ms: Date.now() - started, count: items.length, error: null };
        } catch (error) {
          return { ok: false, latency_ms: Date.now() - started, count: null, error: errorMessage(error) };
        }
      };
      const routes = {};
      for (const route of [config.primary, config.secondary]) if (route) routes[route] = await probe2(route);
      report.check = routes;
    }
    return report;
  }
};
function summarizeText(book, text4) {
  return { book, route_pages: null, bytes: Buffer.byteLength(text4, "utf8"), chars: text4.length, text_sha: textSha(text4), est_tokens: estimateTokens(text4) };
}

// ../schemas/evidence.schema.json
var evidence_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  type: "object",
  required: ["sources", "passages"],
  properties: {
    sources: {
      type: "array",
      items: {
        type: "object",
        required: ["id", "title", "author", "role", "isCoreText"],
        properties: {
          id: { type: "string" },
          title: { type: "string" },
          author: { type: "string" },
          role: { enum: ["primary", "secondary"] },
          isCoreText: { type: "boolean" }
        },
        additionalProperties: false
      }
    },
    passages: {
      type: "array",
      items: {
        type: "object",
        required: ["id", "sourceId", "locator", "quote", "gloss", "relevance"],
        properties: {
          id: { type: "string" },
          sourceId: { type: "string" },
          locator: { type: "string" },
          quote: { type: "string" },
          gloss: { type: "string" },
          relevance: { type: "integer", minimum: 0, maximum: 3 }
        },
        additionalProperties: false
      }
    }
  },
  additionalProperties: false
};

// src/evidence.ts
var sourceCache = /* @__PURE__ */ new Map();
var prompt2 = (min, max, isCore) => [
  "Extract evidence passages from the supplied source for the author thesis. Use only the supplied author intent and source text.",
  "The intent JSON contains the thesis in the author's words, the argument moves, the core text id and any must-use passages.",
  `Return between ${min} and ${max} passages that support, complicate, illustrate or contradict the thesis or any of its moves.`,
  isCore ? "This source IS the author's core text: cover it densely. Include every passage that states a position the thesis depends on, every dilemma or argument the author will analyse, and the key definitions." : "Prefer passages that bear directly on a move.",
  "Quotes must be exact substrings copied from the source text; never reconstruct, translate, or silently normalize a quote. Keep each quote to one or two sentences.",
  "Include a locator (page/section as given in the text), a concise gloss, and relevance from 0 (tangential) through 3 (central)."
].join(" ");
var extractionSchema = { type: "object", required: ["passages"], properties: { passages: evidence_schema_default.properties.passages }, additionalProperties: false };
var stubState = {};
function stablePassageId(sourceId, quote2) {
  const prefix = sourceId.replace(/^sefaria:/u, "s-").replace(/[^\p{L}\p{N}-]/gu, "").slice(0, 8);
  return `${prefix}-${createHash4("sha256").update(normalize(quote2)).digest("hex").slice(0, 8)}`;
}
function normalize(value) {
  return value.normalize("NFC").replace(/\s+/gu, " ").trim();
}
function cacheKeyFor(route, id) {
  return route === "trove" ? id : `${route}~${id}`;
}
function cachePath(id, text4) {
  const digest = createHash4("sha256").update(text4).digest("hex");
  const directory = join12(dataDir(), "sources", `${encodeURIComponent(id)}@${digest}`);
  mkdirSync5(directory, { recursive: true });
  writeFileSync2(join12(directory, "text.md"), text4, "utf8");
  return join12(directory, "text.md");
}
function cachedText(id) {
  const root = join12(dataDir(), "sources");
  if (!existsSync7(root)) return void 0;
  const prefix = `${encodeURIComponent(id)}@`;
  const entry = readdirSync2(root).find((name) => name.startsWith(prefix));
  if (!entry) return void 0;
  const path2 = join12(root, entry, "text.md");
  return existsSync7(path2) ? readFileSync8(path2, "utf8") : void 0;
}
function ckMetadata(text4) {
  const head = text4.slice(0, 4e3);
  const title = head.match(/\*\*([^*\n]{2,200})\*\*/u)?.[1]?.trim();
  const authorBlock = head.split(/^#+\s*(?:מחבר|Author)[^\n]*$/imu)[1];
  const author = authorBlock?.match(/^\s*[-*]\s+([^·(\n]+)/mu)?.[1]?.trim();
  return { title, author };
}
async function fetchViaLibrary(library, id, runId2) {
  const output = await library.read({ source: id, all: true, op: "get", run: runId2 });
  if (output.raw !== void 0) return output.raw;
  const body = output.pages.map((page) => `\u2500\u2500 Page ${page.trove_page} \u2500\u2500
${page.text}`).join("\n\n");
  return output.title ? `**${output.title}**

${body}` : body;
}
async function titleViaLibrary(library, id) {
  try {
    const route = library.config.primary;
    const { book } = await library.resolveBook(route, id);
    return await library.backend(route).title(book);
  } catch {
    return void 0;
  }
}
async function extract(sourceId, text4, intent, runId2, isCore = false) {
  if (stubState.value?.extract) return stubState.value.extract(sourceId, text4, intent, runId2);
  const target = thresholds_default.evidence.passagesPerSource[isCore ? "core" : "other"];
  const result = await callGemini({
    step: "evidence.extract",
    runId: runId2,
    system: prompt2(target.min, target.max, isCore),
    parts: [`Author intent (thesis and must-use passages):
${intent}`, `Source ${sourceId}:
${text4}`],
    responseSchema: extractionSchema
  });
  if (typeof result.json !== "object" || result.json === null || !Array.isArray(result.json.passages)) {
    throw new Error("ERROR evidence.extract: missing passages");
  }
  return { passages: result.json.passages };
}
function event(runId2, record, reason) {
  const path2 = join12(projectDir(), ".academic-helper", "runs", runId2, "events.jsonl");
  mkdirSync5(join12(projectDir(), ".academic-helper", "runs", runId2), { recursive: true });
  appendFileSync5(path2, `${JSON.stringify({ type: "evidence.quote_dropped", passageId: record.id, sourceId: record.sourceId, reason })}
`, "utf8");
}
async function buildEvidence(options) {
  dataDir();
  projectDir();
  for (const id of options.sources) {
    if (!isPlainId(id)) throw new Error(`ERROR evidence.build: source id ${JSON.stringify(id)} is not a plain id (letters, digits and . _ # : - only); remove it from the source list`);
  }
  const intent = options.intent ? readFileSync8(options.intent, "utf8") : "";
  const intentJson = (() => {
    try {
      return JSON.parse(intent);
    } catch {
      return {};
    }
  })();
  const intentCore = intentJson.coreTextSourceId ?? "";
  const primaryIds = new Set(intentJson.primarySources ?? []);
  const library = new Library(projectDir(), process.env, { shadow: shadowModeFrom(process.env) });
  const route = library.config.primary;
  const tasks = [
    ...options.sources.map(async (id) => {
      const key = cacheKeyFor(route, id);
      const cached = sourceCache.get(key) ?? cachedText(key);
      const text4 = cached ?? await (stubState.value?.fetchCk ? stubState.value.fetchCk(id, route) : fetchViaLibrary(library, id, options.runId));
      sourceCache.set(key, text4);
      cachePath(key, text4);
      const meta = ckMetadata(text4);
      const tocTitle = stubState.value?.fetchCk ? void 0 : await titleViaLibrary(library, id);
      const isCoreText = id === intentCore;
      return { id, key, title: tocTitle ?? meta.title ?? id, author: meta.author ?? "", role: isCoreText || primaryIds.has(id) ? "primary" : "secondary", isCoreText, text: text4 };
    }),
    ...(options.sefaria ?? []).map(async (reference) => {
      const id = `sefaria:${reference}`;
      const cached = cachedText(id);
      const result = cached === void 0 ? await (stubState.value?.fetchSefaria ?? fetchSefaria)(reference) : { title: reference, author: "", text: cached };
      cachePath(id, result.text);
      return { id, key: id, title: result.title, author: result.author, role: "primary", isCoreText: id === intentCore, text: result.text };
    })
  ];
  const fetched = await Promise.all(tasks);
  const extracted = [];
  let next = 0;
  const concurrency = routeFor("evidence.extract").concurrency;
  if (concurrency < 1) throw new Error("ERROR evidence.extract: configured concurrency must be positive");
  await Promise.all(Array.from({ length: Math.min(concurrency, fetched.length) }, async () => {
    while (next < fetched.length) {
      const index = next;
      next += 1;
      const source = fetched[index];
      if (source) extracted[index] = { source, result: await extract(source.id, source.text, intent, options.runId, source.isCoreText) };
    }
  }));
  const sources = fetched.map(({ text: _text, key: _key, ...source }) => source);
  const passages = [];
  for (const { source, result } of extracted) {
    const cachedText2 = sourceCache.get(source.key) ?? source.text;
    for (const passage of result.passages) {
      if (!normalize(passage.quote) || !normalize(cachedText2).includes(normalize(passage.quote))) {
        event(options.runId, passage, "quote_not_verbatim");
        continue;
      }
      const rated = await decide({
        point: "evidence.relevance",
        question: "How relevant is this passage to the author thesis (0 = not relevant, 3 = central)?",
        options: ["0", "1", "2", "3"],
        context: JSON.stringify({ thesis: intent, quote: passage.quote, gloss: passage.gloss }),
        runId: options.runId,
        fallback: async () => String(passage.relevance)
      });
      const id = stablePassageId(source.id, passage.quote);
      if (passages.some((p) => p.id === id)) continue;
      passages.push({ ...passage, id, relevance: Number(rated.answer) });
    }
  }
  const previousPath = join12(projectDir(), ".academic-helper", "evidence.json");
  if (existsSync7(previousPath)) {
    try {
      const previous = JSON.parse(readFileSync8(previousPath, "utf8"));
      const texts = new Map(fetched.map((f3) => [f3.id, normalize(sourceCache.get(f3.key) ?? f3.text)]));
      for (const p of previous.passages ?? []) {
        if (passages.some((q) => q.id === p.id)) continue;
        const text4 = texts.get(p.sourceId);
        if (text4 === void 0 || text4.includes(normalize(p.quote))) passages.push(p);
      }
      for (const src of previous.sources ?? []) if (!sources.some((x2) => x2.id === src.id)) sources.push(src);
    } catch {
    }
  }
  const output = { sources, passages };
  const target = join12(projectDir(), ".academic-helper", "evidence.json");
  mkdirSync5(join12(projectDir(), ".academic-helper"), { recursive: true });
  writeFileSync2(target, `${JSON.stringify(output, null, 2)}
`, "utf8");
  appendLedger({ run_id: options.runId, step: "evidence.build", provider: "code", model: "code", input_tokens: 0, output_tokens: 0, cost_usd: 0, latency_ms: 0, exit: "OK", same_family: false });
  return output;
}

