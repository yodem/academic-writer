// src/routing.ts
var stepIds = ["proofread.find", "proofread.verify", "proofread.memo", "evidence.extract", "write.draft", "write.synthesize", "voice.moves", "revise.classify", "ocr", "edit"];
var modelTable = thresholds_default.models;

// src/main.ts
var args = setPathArguments(process.argv.slice(2));
var [command, subcommand, runId] = args;
if (command === "ledger" && subcommand === "show" && runId) {
  try {
    dataDir();
    const file = join(projectDir(), ".academic-helper", "runs", runId, "usage.jsonl");
    const rows = readFileSync(file, "utf8").trim().split("\n").filter(Boolean).map((line) => JSON.parse(line));
    const totals = /* @__PURE__ */ new Map();
    for (const row of rows) {
      const total = totals.get(row.step) ?? { input_tokens: 0, output_tokens: 0, cost_usd: 0 };
      total.input_tokens += row.input_tokens;
      total.output_tokens += row.output_tokens;
      total.cost_usd = total.cost_usd === null || row.cost_usd === null ? null : total.cost_usd + row.cost_usd;
      totals.set(row.step, total);
    }
    process.stdout.write(`${JSON.stringify(Object.fromEntries(totals), null, 2)}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error && error.message.startsWith("ERROR:") ? error.message : `ERROR ledger: missing run ${runId}`}
`);
    process.exitCode = error instanceof Error && error.message.startsWith("ERROR:") ? 3 : 2;
  }
} else if (command === "models" && subcommand === "check") {
  process.stdout.write(`Configured Gemini steps: ${stepIds.join(", ")}
Live model verification requires GOOGLE_API_KEY.
`);
} else {
  process.stderr.write("ERROR: expected aw models check or aw ledger show <runId>\n");
  process.exitCode = 2;
}
