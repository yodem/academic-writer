}
function readEvents(file) {
  let text4;
  try {
    text4 = readFileSync3(file, "utf8");
  } catch {
    return [];
  }
  const events = [];
  for (const line of text4.split("\n")) {
    if (!line.trim()) continue;
    try {
      const parsed = JSON.parse(line);
      if (typeof parsed === "object" && parsed !== null && "kind" in parsed) events.push(parsed);
    } catch {
    }
  }
  return events;
}
async function endRunOnError(runId2, flow, fn, project) {
  try {
    return await fn();
  } catch (error) {
