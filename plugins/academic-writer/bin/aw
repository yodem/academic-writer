    return { pages: await this.readPlain(book, pages) };
  }
  /** A whole-book read gets the longer timeout; page ranges keep the lookup timeout. */
  readTimeout(pages) {
    return pages === "all" ? this.options.readAllTimeoutMs ?? this.options.timeoutMs : this.options.timeoutMs;
  }
  async readPlain(book, pages) {
    let wanted;
    if (pages === "all") {
      const count2 = (await this.catalog()).get(book)?.n_pages ?? (await this.meta(book))?.n_pages ?? null;
      if (count2 === null) throw new LibraryError("page_map", `ERROR library: PageIndex does not say how many pages ${book} has, so the whole book cannot be read in chunks`);
      wanted = Array.from({ length: count2 }, (_, index) => index + 1);
    } else wanted = pages;
    const chunkSize = limits.pageindex.readChunkPages;
    const chunks = [];
    for (let index = 0; index < wanted.length; index += chunkSize) chunks.push(wanted.slice(index, index + chunkSize));
    const results = new Array(chunks.length);
    let next = 0;
    const worker = async () => {
      while (next < chunks.length) {
        const mine = next;
        next += 1;
        results[mine] = parseBanners(await this.run(["read", book, formatPageRanges(chunks[mine])], this.readTimeout(pages))).pages;
      }
    };
    await Promise.all(Array.from({ length: Math.min(limits.pageindex.chunkConcurrency, chunks.length) }, worker));
    return results.flat();
  }
};

