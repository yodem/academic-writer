}
var YEAR_LIKE = (value) => value >= 1e3 && value <= 2100;
function pageRange(first, last) {
  const pages = [];
  for (let page = first; page <= Math.max(first, last) && pages.length < evalLimits.maxAnswerPages; page += 1) pages.push(page);
  return pages;
}
var NAMED_PAGE = /(?<![\p{L}\p{N}])(?:pp?\.|pages?|עמ[׳'’]?|עמוד(?:ים)?)\s*(\d{1,5})(?:\s*[-–—]\s*(\d{1,5}))?/iu;
var TRAILING_PAGE = /[,:\s](\d{1,5})(?:\s*[-–—]\s*(\d{1,5}))?\s*[.)\]]*\s*$/u;
function pagesCited(segment, year) {
  const named = NAMED_PAGE.exec(segment);
  if (named) return pageRange(Number(named[1]), named[2] ? Number(named[2]) : Number(named[1]));
  const trailing = TRAILING_PAGE.exec(segment.trim());
  if (!trailing) return [];
  const first = Number(trailing[1]);
  const last = trailing[2] ? Number(trailing[2]) : first;
  if (YEAR_LIKE(first) && !trailing[2]) return [];
  if (year !== null && String(first) === year) return [];
  return pageRange(first, last);
}
function segmentsOf(note) {
  return note.split(/\s*[;؛]\s*/u).map((piece) => piece.trim()).filter(Boolean);
}
function matchSegment(cards, segment) {
  if (isIbid(segment)) return { kind: "ibid", printed: pagesCited(segment, null) };
  const tokens2 = tokensOf(segment);
  const byAuthor = [];
  const eligible = [];
  for (const card of cards) {
    const authorsHit = card.surnames.filter((surname) => hasSequence(tokens2, surname)).length;
    if (authorsHit === 0) continue;
    byAuthor.push(card);
    const titleHits = card.titleWords.filter((word) => hasWord(tokens2, word)).length;
    const yearHit = card.year !== null && tokens2.includes(card.year);
    if (titleHits === 0 && !yearHit) continue;
    eligible.push({
      card,
      titleHits,
      yearHit,
      score: titleHits / Math.max(1, card.titleWords.length) + (yearHit ? 0.5 : 0) + authorsHit / card.surnames.length * 0.25
    });
  }
  if (eligible.length === 0) {
    return { kind: "unmatched", reason: byAuthor.length === 0 ? "no source in sources.json has an author surname that appears in the note" : `the author matches ${byAuthor.map((card) => card.id).join(", ")} but no title word or year of it appears in the note` };
  }
  eligible.sort((a, b) => b.score - a.score);
  const [best, second] = eligible;
  if (second && second.score >= best.score - 1e-9) {
    const tied = eligible.filter((entry) => entry.score >= best.score - 1e-9).map((entry) => entry.card.id);
    return { kind: "unmatched", reason: `the note matches several sources equally (${tied.join(", ")}); name more of the title` };
  }
  return { kind: "source", card: best.card, printed: pagesCited(segment, best.card.year) };
}
var NoteResolver = class {
  constructor(cards) {
    this.cards = cards;
  }
  previous = null;
  seen = /* @__PURE__ */ new Map();
  /** Record a note that was resolved some other way (by its source id), so a following "Ibid." can repeat it. */
  noteResolvedByKey(key, source) {
    this.seen.set(key, { sources: source ? [source] : [], unmatched: [], partial: false });
    this.previous = { sources: source ? [source] : [], reason: source ? null : "the previous note names no known source" };
  }
  resolve(key, text4) {
    const known = this.seen.get(key);
    if (known) return known;
    const result = { sources: [], unmatched: [], partial: false };
    const trimmed = text4.trim();
    if (!trimmed) result.unmatched.push({ text: "", reason: "the note has no text to match" });
    for (const segment of segmentsOf(trimmed)) {
      const match = matchSegment(this.cards, segment);
      if (match.kind === "source") result.sources.push({ sourceId: match.card.id, title: match.card.title, printed: match.printed });
      else if (match.kind === "unmatched") result.unmatched.push({ text: segment, reason: match.reason });
      else if (this.previous === null) result.unmatched.push({ text: segment, reason: "Ibid. with no earlier note to repeat" });
      else if (this.previous.reason !== null) result.unmatched.push({ text: segment, reason: `Ibid. repeats the previous note, but ${this.previous.reason}` });
      else if (this.previous.sources.length !== 1) result.unmatched.push({ text: segment, reason: "Ibid. repeats a previous note that cites several sources, so it does not say which" });
      else result.sources.push({ ...this.previous.sources[0], printed: match.printed });
    }
    if (result.sources.length > 0 && result.unmatched.length > 0) {
      const matched = [...new Set(result.sources.map((source) => source.sourceId))].join(", ");
      result.partial = true;
      result.sources = [];
      result.unmatched = result.unmatched.map((item) => ({ text: item.text, reason: `partial match: another citation of this note matched ${matched}, so the whole note is left unresolved; ${item.reason}` }));
    }
    this.seen.set(key, result);
    this.previous = {
      sources: result.sources,
      reason: result.sources.length === 0 ? `the previous note is unmatched (${result.unmatched[0]?.reason ?? "no text"})` : null
    };
    return result;
  }
};

// src/library/eval/claims.ts
var DEFINITION = /^\[\^([^\]]+)\]:\s*(.*)$/u;
var MARKER = /\[\^([^\]]+)\]/gu;
var ABBREVIATIONS = /* @__PURE__ */ new Set(["e.g", "i.e", "cf", "ca", "vol", "no", "ed", "eds", "pp", "p", "vs", "etc", "fig", "ch", "esp", "trans", "et al", "al"]);
function normalise(text4) {
  return text4.normalize("NFC").replace(/\s+/gu, " ").trim();
}
function wordBefore(text4, index) {
  let start = index;
  while (start > 0 && /[\p{L}.]/u.test(text4[start - 1])) start -= 1;
  return text4.slice(start, index).toLowerCase();
}
function splitSentences(paragraph) {
  const out = [];
  let start = 0;
  let index = 0;
  while (index < paragraph.length) {
    const char = paragraph[index];
    if (!".!?\u05C3".includes(char)) {
      index += 1;
      continue;
    }
    let end = index + 1;
    for (; ; ) {
      const marker = /^\[\^[^\]]+\]/u.exec(paragraph.slice(end));
      if (marker) {
        end += marker[0].length;
        continue;
      }
      if (end < paragraph.length && /[.!?׃"”’'״)]/u.test(paragraph[end])) {
        end += 1;
        continue;
      }
      break;
    }
    const atBreak = end >= paragraph.length || /\s/u.test(paragraph[end]);
    const word = char === "." && end === index + 1 ? wordBefore(paragraph, index) : "";
    const abbreviation = word !== "" && (word.length === 1 || ABBREVIATIONS.has(word));
    if (atBreak && !abbreviation) {
      out.push(paragraph.slice(start, end));
      start = end;
    }
    index = end;
  }
  if (start < paragraph.length) out.push(paragraph.slice(start));
  return out.map((piece) => piece.trim()).filter(Boolean);
}
function parseDraft(markdown, unitId) {
  const definitions = /* @__PURE__ */ new Map();
  const sentences = [];
  let paragraphNumber = 0;
  let order = 0;
  for (const block2 of markdown.split(/\n\s*\n/u)) {
    const lines = [];
    for (const line of block2.split("\n")) {
      const match = DEFINITION.exec(line.trim());
      if (match) definitions.set(match[1], normalise(match[2] ?? ""));
      else lines.push(line);
    }
    const body = normalise(lines.join(" "));
    if (!body || body.startsWith("#")) continue;
    paragraphNumber += 1;
    for (const piece of splitSentences(body)) {
      const keys = [...new Set([...piece.matchAll(MARKER)].map((match) => match[1]))];
      if (keys.length === 0) continue;
      const text4 = normalise(piece.replace(MARKER, " ")).replace(/\s+([.,;:!?׃])/gu, "$1");
      order += 1;
      sentences.push({ text: text4, keys, paragraphId: `${unitId}_p_${paragraphNumber}`, order });
    }
  }
  return { sentences, definitions };
}
function wordCount(text4) {
  return text4.split(/\s+/u).filter((word) => /[\p{L}\p{N}]/u.test(word)).length;
}
function readJsonQuiet(file) {
  if (!existsSync17(file)) return void 0;
  try {
    return JSON.parse(readFileSync17(file, "utf8"));
  } catch {
    return void 0;
  }
}
function listOf2(raw, key) {
  const list = Array.isArray(raw) ? raw : raw?.[key];
  return Array.isArray(list) ? list.filter((entry) => typeof entry === "object" && entry !== null) : [];
}
function loadRegistry(project) {
  const registry = { loaded: false, sources: /* @__PURE__ */ new Map(), passages: /* @__PURE__ */ new Map() };
  const dir = join22(project, ".academic-helper");
  const sources = readJsonQuiet(join22(dir, "sources.json"));
  const evidence = readJsonQuiet(join22(dir, "evidence.json"));
  for (const entry of listOf2(sources, "sources")) {
    const id = String(entry.sourceId ?? entry.id ?? "");
    if (id) {
      registry.sources.set(id, String(entry.workTitle ?? entry.title ?? id));
      registry.loaded = true;
    }
  }
  for (const entry of listOf2(evidence, "sources")) {
    const id = String(entry.id ?? entry.sourceId ?? "");
    if (id && !registry.sources.has(id)) {
      registry.sources.set(id, String(entry.title ?? entry.workTitle ?? id));
      registry.loaded = true;
    }
  }
  for (const entry of listOf2(evidence, "passages")) {
    if (typeof entry.id === "string" && typeof entry.sourceId === "string") {
      registry.passages.set(entry.id, { sourceId: entry.sourceId, locator: typeof entry.locator === "string" ? entry.locator : "" });
      registry.loaded = true;
    }
  }
  return registry;
}
var PRINTED_PAGE = /(?<![\p{L}\p{N}])(?:pp?\.|pages?|עמ[׳'’]?|עמוד(?:ים)?)\s*(\d{1,5})(?:\s*[-–—]\s*(\d{1,5}))?/iu;
function pagesNamedIn(text4, limit = evalLimits.maxAnswerPages) {
  const match = PRINTED_PAGE.exec(text4);
  if (!match) return [];
  const first = Number(match[1]);
  const last = match[2] ? Number(match[2]) : first;
  const pages = [];
  for (let page = first; page <= Math.max(first, last) && pages.length < limit; page += 1) pages.push(page);
  return pages;
}
function fromLocator(locator) {
  const trove = /^\s*Page\s+(\d{1,6})\b/iu.exec(locator);
  const original = /\borig\.?\s*(\d{1,6})/iu.exec(locator);
  if (trove) return { trove: [Number(trove[1])], printed: original ? [Number(original[1])] : [] };
  return { trove: [], printed: pagesNamedIn(locator) };
}
function resolveNoteSource(project, source) {
  let trove = [];
  if (source.printed.length > 0) {
    const map = findSource(project, source.sourceId)?.pageMap;
    if (map) {
      try {
        trove = printedToTrove(source.printed, map, project);
      } catch {
        trove = [];
      }
    }
  }
  return { sourceId: source.sourceId, title: source.title, printed: source.printed, trove };
}
var KeyResolver = class {
  constructor(project, registry, definitions, unit, unmatched) {
    this.project = project;
    this.registry = registry;
    this.definitions = definitions;
    this.unit = unit;
    this.unmatched = unmatched;
    this.cards = loadSourceCards(project);
    this.resolver = new NoteResolver(this.cards);
  }
  resolver;
  cards;
  byKey = /* @__PURE__ */ new Map();
  partialKeys = /* @__PURE__ */ new Set();
  /** True when only some citations of the note matched a source: the note is unresolved, and a sentence carrying it is not used. */
  isPartial(key) {
    return this.partialKeys.has(key);
  }
  /** True when the note is partial or matched no source at all (an Ibid. after an unmatched note, an unknown citation). */
  isUnresolved(key) {
    return this.partialKeys.has(key) || this.byKey.get(key)?.length === 0;
  }
  resolve(key) {
    const cached = this.byKey.get(key);
    if (cached) return cached;
    const byId = resolveKey(this.project, this.registry, key, this.definitions);
    let out = [];
    if (byId) {
      this.resolver.noteResolvedByKey(key, { sourceId: byId.sourceId, title: byId.title, printed: byId.printed });
      out = [byId];
    } else if (this.cards.length > 0) {
      const result = this.resolver.resolve(key, this.definitions.get(key) ?? "");
      if (result.partial) this.partialKeys.add(key);
      out = result.sources.map((source) => resolveNoteSource(this.project, source));
      for (const item of result.unmatched) this.unmatched?.push({ unit: this.unit, note: key, text: item.text.slice(0, 200), reason: item.reason });
    }
    this.byKey.set(key, out);
    return out;
  }
};
function resolveKey(project, registry, key, definitions) {
  const passage = registry.passages.get(key);
  const sourceId = passage ? passage.sourceId : key;
  const known = registry.sources.has(sourceId) ? sourceId : [...registry.sources.keys()].find((id2) => stripFragment(id2) === stripFragment(sourceId));
  if (registry.loaded && !known) return null;
  if (!registry.loaded && !PLAIN_ID.test(sourceId)) return null;
  const id = known ?? sourceId;
  if (!PLAIN_ID.test(id)) return null;
  const title = registry.sources.get(id) ?? id;
  let trove = [];
  let printed = [];
  if (passage) ({ trove, printed } = fromLocator(passage.locator));
  if (trove.length === 0 && printed.length === 0) printed = pagesNamedIn(definitions.get(key) ?? "");
  if (trove.length === 0 && printed.length > 0) {
    const map = findSource(project, id)?.pageMap;
    if (map) {
      try {
        trove = printedToTrove(printed, map, project);
      } catch {
        trove = [];
      }
    }
  }
  return { sourceId: id, title, printed, trove };
}
function draftFiles(path2) {
  const unitOf = (file) => (file.split("/").pop() ?? file).replace(/\.md$/iu, "");
  if (!existsSync17(path2)) return [];
  if (!readdirSafe(path2)) return [{ file: path2, unit: unitOf(path2) }];
  return (readdirSafe(path2) ?? []).filter((name) => name.toLowerCase().endsWith(".md")).sort().map((name) => ({ file: join22(path2, name), unit: unitOf(name) }));
}
function readdirSafe(path2) {
  try {
    return readdirSync6(path2);
  } catch {
    return null;
  }
}

// src/library/eval/plan.ts
function emptySkips() {
  return { too_short: 0, no_source: 0, multi_source: 0, unresolved: 0, over_cap: 0 };
}
function articleFiles(project, article) {
  const drafts = join23(project, ".academic-helper", "drafts");
  if (!article) return { files: draftFiles(drafts), runFilter: null, label: null };
  const asPath = isAbsolute3(article) ? article : resolve11(project, article);
  if (existsSync18(asPath)) return { files: draftFiles(asPath), runFilter: null, label: relative2(project, asPath) || "." };
  if (EVAL_ID.test(article)) return { files: draftFiles(drafts), runFilter: article, label: `run ${article}` };
  throw new LibraryError("usage", `ERROR library eval plan: --article ${article} is neither a file or folder nor a run id`);
}
function candidatesFromDrafts(project, files, skips, unmatched) {
  const registry = loadRegistry(project);
  const out = [];
  const seen = /* @__PURE__ */ new Set();
  let order = 0;
  for (const { file, unit } of files) {
    const draft = parseDraft(readFileSync18(file, "utf8"), unit);
    const keysOf = new KeyResolver(project, registry, draft.definitions, unit, unmatched);
    const resolved = draft.sentences.map((sentence) => ({
      sentence,
      keys: sentence.keys.flatMap((key) => keysOf.resolve(key)),
      partial: sentence.keys.some((key) => keysOf.isUnresolved(key))
    }));
    for (const { sentence, keys, partial } of resolved) {
      order += 1;
      if (wordCount(sentence.text) < evalLimits.minClaimWords) {
        skips.too_short += 1;
        continue;
      }
      if (partial || keys.length === 0) {
        skips.no_source += 1;
        continue;
      }
      const sources = new Set(keys.map((key) => key.sourceId));
      if (sources.size > 1) {
        skips.multi_source += 1;
        continue;
      }
      const first = keys[0];
      const marker = `${first.sourceId}\0${sentence.text}`;
      if (seen.has(marker)) continue;
      seen.add(marker);
      const trove = [...new Set(keys.flatMap((key) => key.trove))].sort((a, b) => a - b);
      const printed = keys.flatMap((key) => key.printed)[0] ?? null;
      out.push({ order, text: sentence.text, source_id: first.sourceId, source_title: first.title, cited_trove_pages: trove, cited_printed_page: printed, paragraph_id: sentence.paragraphId });
    }
  }
  return out;
}
function candidatesFromFile(project, file, skips) {
  const path2 = isAbsolute3(file) ? file : resolve11(project, file);
  let raw;
  try {
    raw = JSON.parse(readFileSync18(path2, "utf8"));
  } catch {
    throw new LibraryError("usage", `ERROR library eval plan: --claims ${file} is not a readable JSON file`);
  }
  const list = Array.isArray(raw) ? raw : raw?.claims;
  if (!Array.isArray(list)) throw new LibraryError("usage", "ERROR library eval plan: --claims must hold a list of {text, source}");
  const registry = loadRegistry(project);
  const out = [];
  list.forEach((entry, index) => {
    const item = typeof entry === "object" && entry !== null ? entry : {};
    const text4 = typeof item.text === "string" ? item.text.normalize("NFC").replace(/\s+/gu, " ").trim() : "";
    const source = String(item.source_id ?? item.source ?? "");
    if (!text4 || wordCount(text4) < evalLimits.minClaimWords) {
      skips.too_short += 1;
      return;
    }
    if (!source || !PLAIN_ID.test(source)) {
      skips.no_source += 1;
      return;
    }
    const trove = Array.isArray(item.trove_pages) ? item.trove_pages.filter((page) => Number.isInteger(page) && page > 0) : [];
    const printed = Number.isInteger(item.printed_page) && item.printed_page > 0 ? item.printed_page : null;
    out.push({
      order: index + 1,
      text: text4,
      source_id: source,
      source_title: registry.sources.get(source) ?? source,
      cited_trove_pages: trove,
      cited_printed_page: printed,
      paragraph_id: null
    });
  });
  return out;
}
async function auditorFor(candidate, runFilter, rows) {
  if (!candidate.paragraph_id) return { verdict: null, corrected: null };
  const lookups = new Map(rows.filter((row) => row.row_type === "lookup").map((row) => [row.lookup_id, row]));
  const verdicts = rows.filter((row) => row.row_type === "verdict" && row.paragraph_id === candidate.paragraph_id && (runFilter === null || row.run_id === runFilter));
  const sameSource = verdicts.filter((row) => lookups.get(row.lookup_id)?.source_id !== void 0 && stripFragment(lookups.get(row.lookup_id)?.source_id ?? "") === stripFragment(candidate.source_id));
  const onPage = candidate.cited_trove_pages.length === 0 ? [] : sameSource.filter((row) => {
    const requested = parsePageSpec(lookups.get(row.lookup_id)?.request.trove_pages ?? "");
    return requested === "all" || candidate.cited_trove_pages.some((page) => requested.includes(page));
  });
  const pool = onPage.length > 0 ? onPage : sameSource;
  const newest = pool.reduce((best, row) => best === null || compareVerdictKeys(row, best) > 0 ? row : best, null);
  return newest ? { verdict: newest.verdict, corrected: newest.corrected_page } : { verdict: null, corrected: null };
}
async function resolvableIds(aw, route, evalId) {
  let text4;
  try {
    text4 = await aw({ args: ["list"], route, run: `chk-${evalId}` });
  } catch (error) {
    throw new LibraryError("exit", `ERROR library eval plan: the ${route} library could not list its books (${error instanceof Error ? error.message : String(error)}); fix that, or plan without the check using --no-resolve`);
  }
  try {
    const parsed = JSON.parse(text4);
    return new Set((parsed.items ?? []).map((item) => String(item.id ?? "")).filter(Boolean));
  } catch {
    throw new LibraryError("parse", `ERROR library eval plan: the ${route} library answered with something that is not a book list`);
  }
}
async function buildPlan(options) {
  if (options.n < 1 || options.n > evalLimits.maxClaims) {
    throw new LibraryError("usage", `ERROR library eval plan: --n must be between 1 and ${evalLimits.maxClaims}`);
  }
  const skipped = emptySkips();
  const article = articleFiles(options.project, options.article);
  let candidates2 = options.claimsFile ? candidatesFromFile(options.project, options.claimsFile, skipped) : candidatesFromDrafts(options.project, article.files, skipped, options.unmatched);
  if (options.resolve) {
    const sets = await Promise.all(options.routes.map((route) => resolvableIds(options.aw, route, options.evalId)));
    const before = candidates2.length;
    candidates2 = candidates2.filter((candidate) => sets.every((ids) => ids.has(candidate.source_id) || [...ids].some((id) => stripFragment(id) === stripFragment(candidate.source_id))));
    skipped.unresolved = before - candidates2.length;
  }
  const bySource = /* @__PURE__ */ new Map();
  for (const candidate of candidates2) bySource.set(candidate.source_id, [...bySource.get(candidate.source_id) ?? [], candidate]);
  const target = Math.min(options.n, candidates2.length);
  const cap = Math.ceil(options.n / evalLimits.perSourceShare);
  const groups = shuffle([...bySource.keys()].sort(), seededRandom(`${options.seed}:sources`)).map((source) => shuffle(bySource.get(source), seededRandom(`${options.seed}:${source}`)).slice(0, cap));
  const picked = [];
  for (let round = 0; picked.length < target && round < cap; round += 1) {
    for (const group of groups) {
      const next = group[round];
      if (next && picked.length < target) picked.push(next);
    }
  }
  skipped.over_cap = candidates2.length - picked.length;
  picked.sort((a, b) => a.order - b.order);
  const { rows } = await readRows(options.project);
  const claims = [];
  for (const [index, candidate] of picked.entries()) {
    const { verdict, corrected } = await auditorFor(candidate, article.runFilter, rows);
    const { order: _order, ...rest } = candidate;
    claims.push({ id: `c${String(index + 1).padStart(2, "0")}`, ...rest, auditor_verdict: verdict, corrected_page: corrected });
  }
  const shelf = [...new Map(claims.map((claim) => [claim.source_id, { id: claim.source_id, title: claim.source_title }])).values()];
  const runs = claims.length * options.routes.length;
  return {
    schema: 1,
    eval_id: options.evalId,
    created_at: options.now.toISOString(),
    article: article.label,
    seed: options.seed,
    routes: options.routes,
    shelf,
    claims,
    skipped,
    estimate: { runs, usd: Math.round(runs * evalLimits.expectedUsdPerRun * 100) / 100 }
  };
}

// src/library/eval/reset.ts
import { existsSync as existsSync19 } from "node:fs";
import { mkdir as mkdir7, rename as rename4 } from "node:fs/promises";
import { basename as basename8, join as join24 } from "node:path";
async function archiveGeneration(paths, now) {
  const parts = [paths.pairs, paths.sealedDir, paths.judgments, paths.runsDir, paths.reportJson, paths.reportMd, paths.judgeHtml].filter((part) => existsSync19(part));
  if (parts.length === 0) return null;
  const target = join24(paths.archiveDir, now.toISOString().replace(/[:.]/gu, "-"));
  await mkdir7(target, { recursive: true });
  for (const part of parts) await rename4(part, join24(target, basename8(part)));
  return target;
}

// src/library/eval/stats.ts
function sum(values) {
  return values.reduce((total, value) => total + value, 0);
}
function median(values) {
  if (values.length === 0) return null;
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  const low = sorted[middle - 1];
  const high = sorted[middle];
  return sorted.length % 2 === 1 ? high : (low + high) / 2;
}
function wilson95(successes, n) {
  if (n <= 0) return null;
  const z = 1.959963984540054;
  const p = successes / n;
  const denominator = 1 + z * z / n;
  const centre = (p + z * z / (2 * n)) / denominator;
  const margin = z * Math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denominator;
  return [Math.max(0, centre - margin), Math.min(1, centre + margin)];
}
function logFactorials(n) {
  const table = [0];
  for (let index = 1; index <= n; index += 1) table.push(table[index - 1] + Math.log(index));
  return table;
}
function signTestP(k, n) {
  if (n <= 0) return 1;
  const low = Math.min(k, n - k);
  const logs = logFactorials(n);
  let tail = 0;
  for (let index = 0; index <= low; index += 1) {
    tail += Math.exp(logs[n] - logs[index] - logs[n - index] - n * Math.LN2);
  }
  return Math.min(1, 2 * tail);
}

// src/library/eval/unblind.ts
var NAME3 = { trove: "Trove", pageindex: "PageIndex" };
function rate(eligible, hits) {
  return { eligible, hits, rate: eligible === 0 ? null : hits / eligible };
}
function hitsOf(run, claim, pages) {
  if (!run || run.status !== "ok" || !run.answer) return false;
  return stripFragment(run.answer.book) === stripFragment(claim.source_id) && run.answer.pages.some((page) => pages.includes(page));
}
function routeReport(route, plan2, runs, tally) {
  const own = plan2.claims.map((claim) => ({ claim, run: runs.get(`${claim.id}:${route}`) }));
  const have = own.filter((entry) => entry.run !== void 0);
  const ok = have.filter((entry) => entry.run.status === "ok");
  const costs = have.map((entry) => entry.run.cost_usd).filter((value) => value !== null);
  const est = have.map((entry) => entry.run.returned_est_tokens).filter((value) => value !== null);
  const chars = have.map((entry) => entry.run.returned_chars).filter((value) => value !== null);
  const decisive = tally.wins + tally.losses;
  const cited = own.filter((entry) => entry.claim.cited_trove_pages.length > 0);
  const passed = cited.filter((entry) => entry.claim.auditor_verdict === "PASS");
  const corrected = own.filter((entry) => entry.claim.auditor_verdict === "FAIL" && entry.claim.corrected_page !== null);
  return {
    route,
    ...tally,
    win_rate: decisive === 0 ? null : tally.wins / decisive,
    win_rate_ci95: wilson95(tally.wins, decisive),
    runs: { ok: ok.length, error: have.length - ok.length },
    cited_page_hit: rate(cited.length, cited.filter((entry) => hitsOf(entry.run, entry.claim, entry.claim.cited_trove_pages)).length),
    auditor_pass_hit: rate(passed.length, passed.filter((entry) => hitsOf(entry.run, entry.claim, entry.claim.cited_trove_pages)).length),
    corrected_page_hit: rate(corrected.length, corrected.filter((entry) => hitsOf(entry.run, entry.claim, [entry.claim.corrected_page])).length),
    cost_usd: { total: costs.length === 0 ? null : sum(costs), median: median(ok.map((entry) => entry.run.cost_usd).filter((value) => value !== null)) },
    tokens: {
      input_total: sum(have.map((entry) => entry.run.input_tokens)),
      output_total: sum(have.map((entry) => entry.run.output_tokens)),
      input_median: median(ok.map((entry) => entry.run.input_tokens)),
      output_median: median(ok.map((entry) => entry.run.output_tokens))
    },
    wall_s: { total: sum(have.map((entry) => entry.run.wall_ms)) / 1e3, median: ((m2) => m2 === null ? null : m2 / 1e3)(median(ok.map((entry) => entry.run.wall_ms))) },
    tool_calls_median: median(ok.map((entry) => entry.run.n_reads + entry.run.n_toc)),
    returned_est_tokens: { total: est.length === 0 ? null : sum(est), median: median(est) },
    returned_chars: { total: chars.length === 0 ? null : sum(chars), median: median(chars) }
  };
}
async function unblind(options) {
  const { paths } = options;
  const plan2 = await readValid("plan", paths.plan, "plan");
  const { pairs, mapping, pairsSha } = await checkCommitment(paths);
  if (planSha(plan2) !== mapping.plan_sha256) throw new LibraryError("parse", "ERROR library eval unblind: the plan changed after the pairs were built; refusing to unblind");
  for (const entry of mapping.runs) {
    if (await fileSha(runFile(paths, entry.claim_id, entry.route)) !== entry.sha256) {
      throw new LibraryError("parse", "ERROR library eval unblind: the locate runs changed after the pairs were built (they were run again?); refusing to mix answers and costs of two generations");
    }
  }
  const raw = await readJson(paths.judgments);
  if (raw === null && !options.force) throw new LibraryError("usage", "ERROR library eval unblind: refused: no judgments are imported yet. Judge the pairs and run `aw library eval import` first (--force overrides, and shows the key before anyone has judged)");
  if (raw !== null && validate("judgments", raw).length > 0) throw new LibraryError("parse", "ERROR library eval unblind: judgments.json is not valid");
  const judgments = raw;
  if (judgments && (judgments.mapping_sha256 !== pairs.mapping_sha256 || judgments.pairs_sha256 !== pairsSha)) {
    throw new LibraryError("parse", "ERROR library eval unblind: the pairs or the sealed mapping changed after the judgments were stored; refusing to unblind");
  }
  const latest = effective(judgments);
  const unjudged = pairs.pairs.filter((pair) => !latest.has(pair.pair_id));
  if (unjudged.length > 0 && !options.force) throw new LibraryError("usage", `ERROR library eval unblind: refused: ${unjudged.length} pair(s) are not judged yet (--force overrides)`);
  const runs = /* @__PURE__ */ new Map();
  for (const claim of plan2.claims) {
    for (const route of plan2.routes) {
      const value = await readJson(runFile(paths, claim.id, route));
      if (value !== null && validate("run", value).length === 0) runs.set(`${claim.id}:${route}`, value);
    }
  }
  const [first, second] = plan2.routes;
  const tally = {
    trove: { wins: 0, losses: 0, ties: 0, neither: 0 },
    pageindex: { wins: 0, losses: 0, ties: 0, neither: 0 }
  };
  const claims = new Map(plan2.claims.map((claim) => [claim.id, claim]));
  const rows = [];
  let skipped = 0;
  let autoSame = 0;
  let judged = 0;
  let agree = 0;
  let disagree = 0;
  for (const entry of mapping.pairs) {
    const pair = pairs.pairs.find((candidate) => candidate.pair_id === entry.pair_id);
    const claim = claims.get(entry.claim_id);
    if (!pair || !claim) continue;
    const judgment = latest.get(entry.pair_id);
    const verdict = judgment?.verdict ?? "none";
    const routeOf = { A: entry.A, B: entry.B };
    let preferred = null;
    if (verdict === "A" || verdict === "B") {
      preferred = routeOf[verdict];
      const loser = preferred === first ? second : first;
      tally[preferred].wins += 1;
      tally[loser].losses += 1;
    } else if (verdict === "same") {
      tally[first].ties += 1;
      tally[second].ties += 1;
    } else if (verdict === "neither") {
      tally[first].neither += 1;
      tally[second].neither += 1;
    }
    if (verdict === "skip") skipped += 1;
    if (judgment?.source === "auto") autoSame += 1;
    else if (verdict !== "skip" && verdict !== "none") judged += 1;
    const byRoute = (route) => {
      const option = pair.options[entry.A === route ? "A" : "B"];
      return { book: option.book, pages: option.pages.map((page) => page.page) };
    };
    if (preferred && claim.auditor_verdict === "PASS" && claim.cited_trove_pages.length > 0) {
      const hit = (route) => hitsOf(runs.get(`${claim.id}:${route}`), claim, claim.cited_trove_pages);
      if (hit(first) !== hit(second)) {
        if (hit(preferred)) agree += 1;
        else disagree += 1;
      }
    }
    rows.push({
      pair_id: entry.pair_id,
      claim_id: claim.id,
      claim: claim.text,
      judgment: verdict,
      by: judgment?.source ?? "none",
      note: judgment?.note ?? "",
      option_routes: routeOf,
      preferred,
      pages: { trove: byRoute("trove"), pageindex: byRoute("pageindex") }
    });
  }
  const decisive = tally[first].wins + tally[first].losses;
  const routesReport = {
    [first]: routeReport(first, plan2, runs, tally[first]),
    [second]: routeReport(second, plan2, runs, tally[second])
  };
  const enough = judged >= evalLimits.minPairs;
  const p = decisive === 0 ? null : signTestP(tally[first].wins, decisive);
  const report = {
    schema: 1,
    eval_id: plan2.eval_id,
    generated_at: options.now.toISOString(),
    forced: options.force && (raw === null || unjudged.length > 0),
    excluded: [...runs.values()].filter((run) => run.violations.length > 0).map((run) => ({ claim_id: run.claim_id, route: run.route, violations: run.violations })),
    n_pairs: pairs.pairs.length,
    n_judged: judged,
    n_auto_same: autoSame,
    n_skipped: skipped,
    n_unjudged: unjudged.length,
    decisive,
    routes: routesReport,
    sign_test: { first, second, first_wins: tally[first].wins, decisive, p_value: p },
    enough_pairs: enough,
    statement: "",
    auditor_agreement: { eligible: agree + disagree, agree, disagree, rate: agree + disagree === 0 ? null : agree / (agree + disagree) },
    pairs: rows
  };
  report.statement = statementFor(report);
  await writeJson(paths.reportJson, report);
  await writeText(paths.reportMd, renderMarkdown(report));
  return report;
}
var pct = (value) => value === null ? "n/a" : `${Math.round(value * 100)}%`;
var usd = (value) => value === null ? "n/a" : `$${value.toFixed(value < 1 ? 3 : 2)}`;
var num2 = (value, digits = 0) => value === null ? "n/a" : value.toLocaleString("en-US", { maximumFractionDigits: digits });
function statementFor(report) {
  const { first, second } = report.sign_test;
  const a = report.routes[first];
  const b = report.routes[second];
  if (!report.enough_pairs) {
    return `Only ${report.n_judged} pair${report.n_judged === 1 ? " was" : "s were"} judged by you, and at least ${evalLimits.minPairs} are needed before this report says which library is better. Read the numbers below as a first look, not a verdict.`;
  }
  if (report.decisive === 0) return `None of the ${report.n_judged} judged pairs had a clear winner, so the two libraries look alike on these claims.`;
  if (a.wins === b.wins) return `The two libraries won the same number of pairs (${a.wins} each, out of ${report.decisive} with a clear winner): no difference on these claims.`;
  const leader = a.wins > b.wins ? a : b;
  const ci = leader.win_rate_ci95;
  const range = ci ? ` (95% range ${pct(ci[0])} to ${pct(ci[1])})` : "";
  const p = report.sign_test.p_value;
  const clear = p !== null && p < 0.05;
  return `${NAME3[leader.route]} won ${leader.wins} of the ${report.decisive} pairs with a clear winner, a win rate of ${pct(leader.win_rate)}${range}. ${clear ? "That is unlikely to be chance" : "With this few pairs it could still be chance"} (sign test p = ${p === null ? "n/a" : p.toFixed(3)}).`;
}
function renderMarkdown(report) {
  const [first, second] = [report.sign_test.first, report.sign_test.second];
  const routes = [report.routes[first], report.routes[second]];
  const line = (label, cell) => `| ${label} | ${routes.map(cell).join(" | ")} |`;
  const lines = [
    `# Which library found the right pages? (${report.eval_id})`,
    "",
    ...report.forced ? ["> The key was opened before every pair was judged (forced). Do not treat this as a finished result.", ""] : [],
    report.statement,
    "",
    `Pairs: ${report.n_pairs} in all, ${report.n_judged} judged by you, ${report.n_auto_same} identical (marked "same" automatically), ${report.n_skipped} skipped, ${report.n_unjudged} not judged.`,
    "",
    ...report.excluded.length > 0 ? ["Left out because an agent ran a command it was not allowed to run (the run is invalid):", ...report.excluded.map((entry) => `- ${entry.claim_id}, ${NAME3[entry.route]}: ${entry.violations.join(" | ")}`), ""] : [],
    "## By library",
    "",
    `| | ${routes.map((route) => NAME3[route.route]).join(" | ")} |`,
    `| --- | ${routes.map(() => "---").join(" | ")} |`,
    line("Pairs won", (r2) => String(r2.wins)),
    line("Pairs lost", (r2) => String(r2.losses)),
    line("Same", (r2) => String(r2.ties)),
    line("Neither found it", (r2) => String(r2.neither)),
    line("Win rate (wins / decisive pairs)", (r2) => `${pct(r2.win_rate)}${r2.win_rate_ci95 ? ` (${pct(r2.win_rate_ci95[0])} to ${pct(r2.win_rate_ci95[1])})` : ""}`),
    line("Locate runs that finished / failed", (r2) => `${r2.runs.ok} / ${r2.runs.error}`),
    line("Median time per claim", (r2) => r2.wall_s.median === null ? "n/a" : `${r2.wall_s.median.toFixed(1)} s`),
    line("Median agent tokens in / out", (r2) => `${num2(r2.tokens.input_median)} / ${num2(r2.tokens.output_median)}`),
    line("Total agent tokens in / out", (r2) => `${num2(r2.tokens.input_total)} / ${num2(r2.tokens.output_total)}`),
    line("Median / total cost", (r2) => `${usd(r2.cost_usd.median)} / ${usd(r2.cost_usd.total)}`),
    line("Median tool calls per claim", (r2) => num2(r2.tool_calls_median, 1)),
    line("Text returned to the agent (estimated tokens, total)", (r2) => num2(r2.returned_est_tokens.total)),
    "",
    "## Against the citations you already have",
    "",
    `| | ${routes.map((route) => NAME3[route.route]).join(" | ")} |`,
    `| --- | ${routes.map(() => "---").join(" | ")} |`,
    line("Found the page your article cites", (r2) => `${r2.cited_page_hit.hits} of ${r2.cited_page_hit.eligible} (${pct(r2.cited_page_hit.rate)})`),
    line("...where the citation checker said PASS", (r2) => `${r2.auditor_pass_hit.hits} of ${r2.auditor_pass_hit.eligible} (${pct(r2.auditor_pass_hit.rate)})`),
    line("Found the corrected page where the checker said FAIL", (r2) => `${r2.corrected_page_hit.hits} of ${r2.corrected_page_hit.eligible} (${pct(r2.corrected_page_hit.rate)})`),
    "",
    report.auditor_agreement.eligible === 0 ? "Your preference and the citation checker could not be compared: no pair had exactly one library finding the cited page." : `Your preference matched the citation checker in ${report.auditor_agreement.agree} of ${report.auditor_agreement.eligible} pairs where exactly one library found the cited page (${pct(report.auditor_agreement.rate)}).`,
    "",
    "## Pair by pair",
    ""
  ];
  for (const pair of report.pairs) {
    const verdict = pair.preferred ? `${NAME3[pair.preferred]} was better` : pair.judgment === "same" ? "same" : pair.judgment === "neither" ? "neither found it" : pair.judgment === "skip" ? "skipped" : "not judged";
    lines.push(`### ${pair.pair_id}: ${pair.claim}`, "");
    lines.push(`- Your verdict: ${verdict}${pair.by === "auto" ? " (automatic: both libraries chose the same pages)" : ""}`);
    for (const route of [first, second]) lines.push(`- ${NAME3[route]}: ${pair.pages[route].book ?? "no answer"}${pair.pages[route].pages.length ? `, pages ${pair.pages[route].pages.join(", ")}` : ""}`);
    if (pair.note) lines.push(`- Your note: ${pair.note}`);
    lines.push("");
  }
  return `${lines.join("\n")}
`;
}

// src/library/eval/cli.ts
var BOOLEAN_FLAGS = /* @__PURE__ */ new Set(["--json", "--stdin", "--force", "--partial", "--no-resolve", "--reset"]);
var VALUE_FLAGS = /* @__PURE__ */ new Set(["--eval", "--article", "--n", "--seed", "--claims", "--routes", "--engine", "--parallel", "--model", "--file", "--out", "--template", "--timeout-s"]);
var SUBCOMMANDS = ["plan", "run", "pairs", "page", "import", "unblind", "status"];
function parse(argv) {
  const flags = /* @__PURE__ */ new Map();
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (BOOLEAN_FLAGS.has(arg)) flags.set(arg, true);
    else if (VALUE_FLAGS.has(arg)) {
      const value = argv[index + 1];
      if (value === void 0) throw new LibraryError("usage", `ERROR library eval: ${arg} needs a value`);
      flags.set(arg, value);
      index += 1;
    } else throw new LibraryError("usage", `ERROR library eval: unknown option or argument ${arg}`);
  }
  return flags;
}
function text3(flags, name) {
  const value = flags.get(name);
  return typeof value === "string" ? value : void 0;
}
function wholeNumber(flags, name, fallback, max) {
  const raw = text3(flags, name);
  if (raw === void 0) return fallback;
  if (!/^[1-9]\d{0,5}$/u.test(raw) || Number(raw) > max) throw new LibraryError("usage", `ERROR library eval: ${name} must be a whole number from 1 to ${max}`);
  return Number(raw);
}
function exitCodeFor(error) {
  if (!(error instanceof LibraryError)) return 4;
  if (error.code === "usage") return 2;
  if (error.code === "config") return 3;
  return 4;
}
function routesFrom(flags) {
  const raw = text3(flags, "--routes") ?? "trove,pageindex";
  const routes = raw.split(",").map((part) => part.trim());
  if (routes.length !== 2 || routes[0] === routes[1] || !routes.every((route) => route === "trove" || route === "pageindex")) {
    throw new LibraryError("usage", "ERROR library eval: --routes must name both libraries once, for example trove,pageindex");
  }
  return routes;
}
function engineFrom(flags) {
  const engine = text3(flags, "--engine") ?? "claude";
  if (engine !== "claude" && engine !== "codex") throw new LibraryError("usage", "ERROR library eval: --engine must be claude or codex");
  return engine;
}
function evalIdFrom(flags) {
  const id = text3(flags, "--eval");
  if (!id) throw new LibraryError("usage", "ERROR library eval: --eval <id> is required");
  return id;
}
function newEvalId(project, now) {
  const stamp = now.toISOString().slice(0, 10).replaceAll("-", "");
  for (const letter of "abcdefghijklmnopqrstuvwxyz") {
    const id = `ev-${stamp}-${letter}`;
    if (!existsSync20(join25(project, EVAL_ROOT, id))) return id;
  }
  throw new LibraryError("usage", "ERROR library eval plan: 26 evaluations already exist today; pass --eval <id>");
}
async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}
