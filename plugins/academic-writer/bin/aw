}
async function voiceMoves(runId2) {
  const dir = store();
  const profile = readFileSync9(join13(dir, "profile.json"), "utf8");
  const exemplars = readJsonl(join13(dir, "exemplars.jsonl"));
  const result = await callGemini({ step: "voice.moves", system: `Describe concise reusable author writing moves. Return JSON with a rules string of no more than ${thresholds_default.voice.bundle.maxRuleLines} lines.`, parts: [profile, JSON.stringify(exemplars)], runId: runId2, budget: new Budget(runId2, thresholds_default.budget.voiceMoves), responseSchema: { type: "OBJECT", properties: { rules: { type: "STRING" } }, required: ["rules"] } });
  const parsed = result.json;
  if (typeof parsed.rules !== "string") throw new AwError("ERROR", "voice.moves", "missing rules verdict");
  const rules = parsed.rules.split("\n").slice(0, thresholds_default.voice.bundle.maxRuleLines).join("\n");
