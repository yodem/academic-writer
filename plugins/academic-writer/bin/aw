function surnamesOf(author) {
  const out = [];
  const add = (surname) => {
    const words = tokensOf(surname);
    if (words.length > 0) out.push(words);
  };
  if (Array.isArray(author)) {
    for (const entry of author) out.push(...surnamesOf(entry));
    return out;
  }
  if (typeof author === "object" && author !== null) {
    const record = author;
    const family = textOf(record.family ?? record.surname ?? record.last ?? record.lastName);
    if (family) add(family);
    else out.push(...surnamesOf(textOf(record.name ?? record.literal)));
    return out;
  }
  const text4 = textOf(author).trim();
  if (!text4) return out;
  for (const piece of text4.split(/\s+(?:and|&|ו)\s+|\s*;\s*/iu)) {
    const trimmed = piece.trim();
    if (!trimmed) continue;
    if (trimmed.includes(",")) add(trimmed.slice(0, trimmed.indexOf(",")));
    else {
      const words = trimmed.split(/\s+/u);
      add(words[words.length - 1]);
    }
  }
  return out;
}
function distinctive(title) {
  return [...new Set(tokensOf(title).filter((word) => word.length >= 3 && !STOPWORDS.has(word)))];
}
function listOf(raw, key) {
  const list = Array.isArray(raw) ? raw : raw?.[key];
  return Array.isArray(list) ? list.filter((entry) => typeof entry === "object" && entry !== null) : [];
}
