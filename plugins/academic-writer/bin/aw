async function voiceBundle(options) {
  const dir = store();
  if (!existsSync8(join13(dir, "profile.json"))) throw new AwError("ERROR", "voice.bundle", "exit 3 no voice store \u2014 run: aw voice pull (or /academic-writer:voice)");
  const all = readJsonl(join13(dir, "exemplars.jsonl"));
  const chosen = [];
  const sources = /* @__PURE__ */ new Set();
  const perSource = thresholds_default.voice.bundle.maxPerSource;
  let seed = Number.parseInt(sha(options.runId).slice(0, 8), 16) || 1;
  while (all.length && chosen.length < options.n) {
    seed = seed * 1664525 + 1013904223 >>> 0;
    const index = seed % all.length;
    const item = all.splice(index, 1)[0];
    const sourceCount = chosen.filter((exemplar) => exemplar.source === item?.source).length;
    if (!item || sources.has(item.source) && sourceCount >= perSource) continue;
    sources.add(item.source);
    chosen.push(item);
  }
  const pairs = readJsonl(join13(dir, "pairs.jsonl")).slice(-options.pairs);
  const out = join13(dir, `bundle-${sha(options.runId).slice(0, 12)}.json`);
  writeFileSync3(out, JSON.stringify({ exemplars: chosen, pairs, rules: readFileSync9(join13(dir, "rules.md"), "utf8"), styleWords: JSON.parse(readFileSync9(join13(dir, "style-words.json"), "utf8")) }, null, 2));
  return { exemplars: chosen, pairs, path: out };
}
function voiceMigrate(from) {
