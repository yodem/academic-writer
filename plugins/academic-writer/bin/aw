// src/library/eval/agent.ts
init_thresholds();
import { execFile, spawn as spawn7 } from "node:child_process";
var ChildGroup = class {
  children = /* @__PURE__ */ new Set();
  /** Locate attempts in flight, with what is needed to find everything they started. */
  attempts = /* @__PURE__ */ new Set();
  /** Set once the group is being stopped: nothing new may start. */
  stopping = false;
  add(child) {
    this.children.add(child);
  }
  remove(child) {
    this.children.delete(child);
  }
  get size() {
    return this.children.size;
  }
  killAll() {
    for (const child of this.children) killGroup(child);
    this.children.clear();
  }
  /** Stop every agent AND everything its attempts started (tagged or followed), waiting for the bounded rescan to finish. */
  async reapAll() {
    this.stopping = true;
    this.killAll();
    for (const attempt of [...this.attempts]) {
      await attempt.tracker?.stop();
      await reapTagged(attempt.tag, attempt.tracker);
    }
  }
};
function killGroup(child) {
  try {
    if (process.platform !== "win32" && child.pid) process.kill(-child.pid, "SIGKILL");
    else child.kill("SIGKILL");
  } catch {
    try {
      child.kill("SIGKILL");
    } catch {
    }
  }
}
function runAgent(command3, args2, options) {
  const [file, ...prefix] = command3;
  const started = Date.now();
  if (!file) return Promise.resolve({ stdout: "", stderr: "", code: null, timedOut: false, tooLarge: false, spawnError: "empty command", wallMs: 0 });
  return new Promise((resolve13) => {
    let settled = false;
    const out = [];
    let size = 0;
    let stderr = "";
    let timedOut = false;
    let tooLarge = false;
    const child = spawn7(file, [...prefix, ...args2], { stdio: ["pipe", "pipe", "pipe"], env: options.env, cwd: options.cwd, detached: process.platform !== "win32", windowsHide: true });
    options.group.add(child);
    if (child.pid) options.tracker?.(child.pid);
    const finish = (code, spawnError) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      options.group.remove(child);
      resolve13({ stdout: Buffer.concat(out).toString("utf8"), stderr: stderr.slice(0, 8192), code, timedOut, tooLarge, spawnError, wallMs: Date.now() - started });
    };
    const timer = setTimeout(() => {
      timedOut = true;
      killGroup(child);
      child.stdout?.destroy();
      child.stderr?.destroy();
      finish(null, null);
    }, options.timeoutMs);
    child.stdout?.on("data", (chunk) => {
      size += chunk.length;
      if (size > options.maxBuffer) {
        tooLarge = true;
        killGroup(child);
        finish(null, null);
        return;
      }
      out.push(chunk);
    });
    child.stderr?.on("data", (chunk) => {
      if (stderr.length < 8192) stderr += chunk.toString("utf8");
    });
    child.stdin?.on("error", () => {
    });
    child.on("error", (error) => finish(null, error.code === "ENOENT" ? "missing" : error.message));
    child.on("close", (code) => {
      killGroup(child);
      finish(code, null);
    });
    child.stdin?.end(options.input);
  });
}
function emptyParsed() {
  return { text: null, calls: [], toolErrors: [], permissionDenials: 0, version: null, model: null, inputTokens: 0, outputTokens: 0, costUsd: null, agentMs: null, turns: null, stopReason: null };
}
function records(stdout) {
  const out = [];
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (!trimmed.startsWith("{")) continue;
    try {
      const value = JSON.parse(trimmed);
      if (typeof value === "object" && value !== null && !Array.isArray(value)) out.push(value);
    } catch {
    }
  }
  return out;
}
var num = (value) => typeof value === "number" && Number.isFinite(value) ? value : 0;
var str = (value) => typeof value === "string" && value ? value : null;
var rec = (value) => typeof value === "object" && value !== null && !Array.isArray(value) ? value : {};
function parseClaude(stdout) {
  const parsed = emptyParsed();
  for (const event2 of records(stdout)) {
    if (event2.type === "system") {
      parsed.version = parsed.version ?? str(event2.claude_code_version);
      parsed.model = parsed.model ?? str(event2.model);
    } else if (event2.type === "assistant") {
      const content = rec(event2.message).content;
      for (const part of Array.isArray(content) ? content : []) {
        const item = rec(part);
        if (item.type !== "tool_use") continue;
        const input = rec(item.input);
        parsed.calls.push(item.name === "Bash" && typeof input.command === "string" ? input.command : `[${String(item.name)}] ${JSON.stringify(input).slice(0, 200)}`);
      }
    } else if (event2.type === "user") {
      const content = rec(event2.message).content;
      for (const part of Array.isArray(content) ? content : []) {
        const item = rec(part);
        if (item.type === "tool_result" && item.is_error === true) parsed.toolErrors.push(String(typeof item.content === "string" ? item.content : JSON.stringify(item.content)).slice(0, 200));
      }
    } else if (event2.type === "result") {
      const usage = rec(event2.usage);
      parsed.text = str(event2.result);
      parsed.inputTokens = num(usage.input_tokens) + num(usage.cache_read_input_tokens) + num(usage.cache_creation_input_tokens);
      parsed.outputTokens = num(usage.output_tokens);
      parsed.costUsd = typeof event2.total_cost_usd === "number" ? event2.total_cost_usd : null;
      parsed.agentMs = typeof event2.duration_ms === "number" ? Math.round(event2.duration_ms) : null;
      parsed.turns = typeof event2.num_turns === "number" ? event2.num_turns : null;
      parsed.permissionDenials = Array.isArray(event2.permission_denials) ? event2.permission_denials.length : 0;
      const subtype = str(event2.subtype);
      parsed.stopReason = event2.is_error === true ? subtype ?? "error" : subtype && subtype !== "success" ? subtype : null;
    }
  }
  return parsed;
}
function parseCodex(stdout) {
  const parsed = emptyParsed();
  let sawUsage = false;
  for (const event2 of records(stdout)) {
    const item = rec(event2.item ?? rec(event2.msg));
    const kind = str(item.type) ?? str(item.item_type);
    if (event2.type === "item.completed" || event2.type === "item.started" || typeof event2.msg === "object") {
      if (kind === "command_execution" && event2.type !== "item.started") {
        const command3 = str(item.command);
        if (command3) parsed.calls.push(command3);
        if (typeof item.exit_code === "number" && item.exit_code !== 0) parsed.toolErrors.push(String(item.aggregated_output ?? "").slice(0, 200));
      } else if (kind === "agent_message" || kind === "assistant_message") {
        parsed.text = str(item.text) ?? str(item.message) ?? parsed.text;
      }
    }
    if (event2.type === "turn.completed" || event2.type === "token_count") {
      const usage = rec(event2.usage ?? rec(event2.msg).info);
      parsed.inputTokens += num(usage.input_tokens) + num(usage.cached_input_tokens);
      parsed.outputTokens += num(usage.output_tokens);
      sawUsage = true;
      parsed.turns = (parsed.turns ?? 0) + 1;
    }
    if (event2.type === "turn.failed" || event2.type === "error") parsed.stopReason = str(rec(event2.error).message) ?? str(event2.message) ?? "error";
    if (typeof event2.model === "string" && !parsed.model) parsed.model = event2.model;
  }
  if (!sawUsage) {
    parsed.inputTokens = 0;
    parsed.outputTokens = 0;
  }
  return parsed;
}
function parseAgent(engine, stdout) {
  return engine === "claude" ? parseClaude(stdout) : parseCodex(stdout);
}
function parseAnswer(text4, maxPages) {
  if (!text4) return null;
  const candidates2 = [...text4.matchAll(/```json\s*(\{[\s\S]*?\})\s*```/giu)].map((match) => match[1]);
  if (candidates2.length === 0) candidates2.push(...[...text4.matchAll(/\{[^{}]*"pages"[^{}]*\}/gu)].map((match) => match[0]));
  for (const raw of candidates2.reverse()) {
    try {
      const value = rec(JSON.parse(raw));
      const pages = [...new Set((Array.isArray(value.pages) ? value.pages : []).map((page) => Number(page)).filter((page) => Number.isInteger(page) && page > 0))].slice(0, maxPages);
      if (pages.length === 0) continue;
      return { book: String(value.book ?? ""), pages, reason: typeof value.reason === "string" ? value.reason.slice(0, 500) : "" };
    } catch {
    }
  }
  return null;
}
var RUN_TAG_ENV = "AW_EVAL_RUN_TAG";
function psOutput(args2) {
  if (process.platform === "win32") return Promise.resolve("");
  return new Promise((resolve13) => {
    execFile("ps", args2, { maxBuffer: 64 * 1024 * 1024 }, (error, stdout) => {
      resolve13(error ? "" : stdout);
    });
  });
}
async function snapshotProcs() {
  const out = [];
  for (const line of (await psOutput(["-axo", "pid=,ppid=,lstart="])).split("\n")) {
    const match = /^\s*(\d+)\s+(\d+)\s+(.+?)\s*$/u.exec(line);
    if (match) out.push({ pid: Number(match[1]), ppid: Number(match[2]), started: match[3] });
  }
  return out;
}
async function listTagged(tag) {
  const marker = `${RUN_TAG_ENV}=${tag}`;
  const found = [];
  for (const line of (await psOutput(["axeww", "-o", "pid=,command="])).split("\n")) {
    const match = /^\s*(\d+)\s/u.exec(line);
    if (!match) continue;
    const at = line.indexOf(marker);
    if (at >= 0 && /\s/u.test(line[at + marker.length] ?? " ") && Number(match[1]) !== process.pid) found.push(Number(match[1]));
  }
  return found;
}
var TreeTracker = class {
  constructor(root) {
    this.root = root;
  }
  seen = /* @__PURE__ */ new Map();
  timer = null;
  busy = Promise.resolve();
  tick() {
    this.busy = this.busy.then(async () => {
      const procs = await snapshotProcs();
      const children = /* @__PURE__ */ new Map();
      for (const proc of procs) children.set(proc.ppid, [...children.get(proc.ppid) ?? [], proc]);
      const visited = /* @__PURE__ */ new Set();
      const queue = procs.filter((proc) => proc.pid === this.root || this.seen.get(proc.pid) === proc.started);
      for (const proc of queue) visited.add(proc.pid);
      for (let index = 0; index < queue.length; index += 1) {
        const proc = queue[index];
        if (proc.pid !== this.root) this.seen.set(proc.pid, proc.started);
        for (const child of children.get(proc.pid) ?? []) if (!visited.has(child.pid)) {
          visited.add(child.pid);
          queue.push(child);
        }
      }
    });
    return this.busy;
  }
  start() {
    void this.tick();
    this.timer = setInterval(() => {
      void this.tick();
    }, thresholds_default.library.shadow.pollMs);
  }
  async stop() {
    if (this.timer) clearInterval(this.timer);
    this.timer = null;
    await this.tick();
  }
  /** The followed processes that are still running (same pid AND same start time). */
  async alive() {
    const procs = await snapshotProcs();
    return procs.filter((proc) => this.seen.get(proc.pid) === proc.started).map((proc) => proc.pid);
  }
};
async function reapTagged(tag, tracker) {
  const { reapGraceMs, pollMs } = thresholds_default.library.shadow;
  let killed = 0;
  for (let round = 0; round <= Math.ceil(reapGraceMs / pollMs); round += 1) {
    const pids = [.../* @__PURE__ */ new Set([...await listTagged(tag), ...tracker ? await tracker.alive() : []])].filter((pid) => pid !== process.pid);
    if (pids.length === 0) return killed;
    for (const pid of pids) {
      killed += 1;
      try {
        process.kill(-pid, "SIGKILL");
      } catch {
      }
      try {
        process.kill(pid, "SIGKILL");
      } catch {
      }
    }
    await new Promise((done) => {
      setTimeout(done, pollMs);
    });
  }
  return killed;
}

