function friendlyInstallError(step, text4) {
  const lower2 = text4.toLowerCase();
  if (/externally-managed-environment/u.test(lower2)) return "this Python refuses to install packages by itself; point --python at a normal Python (python.org or Homebrew)";
  if (/(could not resolve|name or service not known|temporary failure in name|connection (?:error|refused|reset|timed out)|network is unreachable|max retries exceeded|read timed out)/u.test(lower2)) return "the download did not work: check the internet connection and try again";
  if (/ssl|certificate/u.test(lower2)) return "a secure download failed (certificate problem): check the network or proxy and try again";
  if (/(hashes are required|do not match the hashes|hash mismatch|expected sha256)/u.test(lower2)) return "a downloaded file did not match its expected checksum, so nothing was kept: try again, and report it if it repeats";
  if (/no matching distribution|could not find a version/u.test(lower2)) return "a required package has no version for this Python: try a different Python with --python";
  if (/(no module named venv|ensurepip is not available)/u.test(lower2)) return "this Python cannot make a private folder (the venv module is missing): install the full Python from python.org or Homebrew";
  if (/(no space left|disk quota)/u.test(lower2)) return "the disk is full";
  if (/(permission denied|operation not permitted)/u.test(lower2)) return "the plugin could not write to its data folder (permission denied)";
  if (/failed building wheel|error: subprocess-exited|microsoft visual c\+\+/u.test(lower2)) return "a package could not be built on this computer: try a different Python with --python";
  const line = text4.split("\n").map((entry) => entry.trim()).filter((entry) => /^(error|fatal)/iu.test(entry)).at(-1) ?? text4.split("\n").map((entry) => entry.trim()).find(Boolean) ?? "";
  return `${step} did not finish${line ? ` (${line.slice(0, 160)})` : ""}`;
}
function stepFailure(step, error) {
  if (error instanceof LibraryError) {
    if (error.code === "timeout") return new LibraryError("timeout", `ERROR library install: ${step} took too long and was stopped. Try again; a slow connection can need a second run.`);
    if (error.code === "spawn") return new LibraryError("spawn", `ERROR library install: could not start ${step}: ${error.message.replace(/^ERROR library: /u, "")}`);
    return new LibraryError("exit", `ERROR library install: ${friendlyInstallError(step, `${error.stderr}
${error.message}`)}.`, error.stderr);
  }
  return new LibraryError("exit", `ERROR library install: ${step} failed`);
}
async function chooseTier(options, pinned) {
  const found = await discoverPythons(childEnv(options.env), options.python ? [options.python] : []);
  if (options.python && !found.some((info) => info.command === options.python)) {
    throw new LibraryError("usage", `ERROR library install: ${options.python} is not a Python 3 that runs on this computer`);
  }
  const usable = options.python ? found.filter((info) => info.command === options.python) : found;
  const structure = choosePython(usable, install.minPython, pinned.tiers.structure.locked_with_python);
  const core = choosePython(usable, install.minPythonCore, pinned.tiers.core.locked_with_python);
  const notes = [];
  if (options.tier === "structure") {
    if (!structure) throw new LibraryError("config", `ERROR library install: the full helper (for books with no table of contents) needs Python ${install.minPython} or newer, and none was found. Install a newer Python (python.org or Homebrew) and run this again, or install the basic helper with --tier core.`);
    return { tier: "structure", requested: "structure", python: structure.python, exact: structure.exact, notes };
  }
  if (options.tier === "core" || !structure) {
    if (!core) throw new LibraryError("config", `ERROR library install: no Python ${install.minPythonCore} or newer was found on this computer. Install Python from python.org (or Homebrew) and run this again.`);
    if (options.tier === void 0) notes.push(`No Python ${install.minPython} or newer was found, so only the basic helper is installed: it indexes books that have a table of contents. A book without one needs a newer Python (run the install again afterwards) or a computer that has it.`);
    return { tier: "core", requested: options.tier ?? null, python: core.python, exact: core.exact, notes };
  }
  return { tier: "structure", requested: null, python: structure.python, exact: structure.exact, notes };
}
