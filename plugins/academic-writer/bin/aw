var LOCK_SCRIPT = [
  "import os, sys",
  "fd = os.open(sys.argv[1], os.O_CREAT | os.O_RDWR, 0o600)",
  "try:",
  '    if os.name == "nt":',
  "        import msvcrt",
  "        msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)",
  "    else:",
  "        import fcntl",
  "        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)",
  "except OSError:",
  '    print("busy", flush=True)',
  "    sys.exit(3)",
  'print("locked", flush=True)',
  "sys.stdin.read()"
].join("\n");
async function takeLock(file, python, env, what) {
  const child = spawn4(python, ["-c", LOCK_SCRIPT, file], { stdio: ["pipe", "pipe", "ignore"], env: childEnv(env), windowsHide: true });
  let closed = false;
  const closing = new Promise((done) => {
    child.once("close", () => {
      closed = true;
      done();
    });
  });
  const answer = await new Promise((settle) => {
    let text4 = "";
    const timer = setTimeout(() => {
      settle("timeout");
    }, install.probeTimeoutMs);
    child.stdout?.setEncoding("utf8").on("data", (chunk) => {
      text4 += chunk;
      if (text4.includes("\n")) {
        clearTimeout(timer);
        settle(text4.trim());
      }
    });
    child.once("error", () => {
      clearTimeout(timer);
      settle("error");
    });
    child.once("close", () => {
      clearTimeout(timer);
      settle(text4.trim() || "closed");
    });
  });
  const release = async () => {
    if (closed) return;
    child.stdin?.end();
    const killer = setTimeout(() => {
      child.kill("SIGKILL");
    }, 3e3);
    await closing;
    clearTimeout(killer);
  };
  if (answer === "locked") return release;
  child.kill("SIGKILL");
  if (answer === "busy") throw new LibraryError("exit", `ERROR library ${what}: another install or uninstall is already running; wait for it to finish.`);
  throw new LibraryError("config", `ERROR library ${what}: could not take the install lock (the Python at ${python} did not start properly). Try another with --python.`);
}
function guardHome(home, dataRoot, what) {
  const refuse = (why) => new LibraryError("config", `ERROR library ${what}: ${why}`);
  if (!dataRoot) throw refuse("the plugin's data folder is not known (pass --data-dir <folder>), so the helper folder cannot be checked; nothing was touched.");
  let root;
  try {
    root = realpathSync2(resolve5(dataRoot));
  } catch {
    throw refuse(`the plugin's data folder ${dataRoot} cannot be resolved; nothing was touched.`);
  }
  const expected = join7(root, "pageindex");
  let actual;
  if (existsSync4(home) || isLink(home)) {
    if (isLink(home)) throw refuse(`${home} is a symbolic link; refusing to use it.`);
    actual = realpathSync2(home);
  } else {
    try {
      actual = join7(realpathSync2(dirname2(home)), basename4(home));
    } catch {
      actual = resolve5(home);
    }
  }
  if (actual !== expected) throw refuse(`${home} is not the plugin's own helper folder (${expected}); nothing was touched.`);
  for (const path2 of [installPaths(home).venv, installPaths(home).library, installPaths(home).installed]) {
    if (isLink(path2)) throw refuse(`${path2} is a symbolic link; refusing to use it.`);
  }
}
async function writeAtomic(file, text4) {
  const temp = `${file}.${process.pid}.tmp`;
  try {
    await writeFile2(temp, text4, "utf8");
    await rename(temp, file);
  } catch (error) {
    await rm(temp, { force: true });
    throw error;
  }
}
async function pilibHealth(command3, env, timeoutMs = install.healthTimeoutMs) {
  try {
    const out = await runCommand(command3, ["health"], { timeoutMs, maxBuffer: 1048576, env });
    const parsed = JSON.parse(out.trim().split("\n").at(-1) ?? "");
    if (typeof parsed.tier !== "string" || typeof parsed.pilib_version !== "string") return null;
    return { ok: parsed.ok === true, tier: parsed.tier, python: String(parsed.python ?? ""), litellm: typeof parsed.litellm === "string" ? parsed.litellm : null, pilib_version: parsed.pilib_version, weasyprint: parsed.weasyprint === true, pageindex: parsed.pageindex === true, pageindex_commit: typeof parsed.pageindex_commit === "string" ? parsed.pageindex_commit : null };
  } catch {
    return null;
  }
}
function homeFor(options) {
  const home = resolveHome(options.env, options.dataDir);
  if (!home) throw new LibraryError("config", "ERROR library install: the plugin's data folder is not known. Run this through the plugin (it passes --data-dir), or pass --data-dir <folder>.");
  return home;
}
async function runInstall(options) {
  const pinned = readPinned(options.pluginRoot);
  const home = homeFor(options);
  const paths = installPaths(home);
  const chosen = await chooseTier(options, pinned);
  const requirements = requirementsFile(options.pluginRoot, pinned, chosen.tier);
  if (!existsSync4(requirements)) throw new LibraryError("config", "ERROR library install: the plugin is missing its requirements file; update or reinstall the plugin.");
  const expected = pinned.tiers[chosen.tier].requirements_sha256;
  if (await sha256File(requirements) !== expected) throw new LibraryError("config", "ERROR library install: the requirements file does not match the one the plugin pins (its checksum differs); update or reinstall the plugin.");
  const system = chosen.tier === "structure" ? pinned.tiers.structure.system_libraries : void 0;
  const warnings = [...chosen.notes];
  if (!chosen.exact) warnings.push(`The packages were locked with Python ${pinned.tiers[chosen.tier].locked_with_python}; this computer uses ${chosen.python.minorName}. The install checks that it works afterwards.`);
  const venvVerdict = async () => {
    if (!existsSync4(paths.python)) return null;
    const minimum = chosen.tier === "structure" ? install.minPython : install.minPythonCore;
    const existing = await probePython(paths.python, childEnv(options.env));
    if (!existing) return "the existing private Python folder no longer starts";
    if (!atLeast(existing, minimum)) return `the existing private Python folder uses Python ${existing.version}, and this tier needs Python ${minimum} or newer`;
    return null;
  };
  let rebuild = await venvVerdict();
  const rebuildWarning = (reason) => `${reason[0]?.toUpperCase()}${reason.slice(1)}, so it will be removed and rebuilt with Python ${chosen.python.version}. The indexed books are kept.`;
  if (rebuild) warnings.push(rebuildWarning(rebuild));
  const plan2 = {
    rebuild_venv: rebuild !== null,
    rebuild_reason: rebuild,
    tier: chosen.tier,
    requested_tier: chosen.requested,
    python: { path: chosen.python.path, version: chosen.python.version },
    home,
    venv: paths.venv,
    library: paths.library,
    requirements: pinned.tiers[chosen.tier].requirements,
    approx_size_mb: install.approxSizeMb[chosen.tier],
    sends_data_to_google: false,
    steps: ["create a private Python folder (venv)", "install the pinned packages with checked hashes (pip --require-hashes)", "check that the helper starts (pilib health)", "write installed.json"],
    ...system ? { system_library: { name: "pango", macos: system.macos ?? null, debian_ubuntu: system.debian_ubuntu ?? null, note: "Needed to turn the text of a book without a table of contents into a PDF. Without it the helper stays at the basic tier." } } : {},
    warnings
  };
  if (options.dryRun) return { ok: true, dry_run: true, ...plan2 };
  if (!options.yes) {
    throw new LibraryError("usage", `ERROR library install: this adds about ${install.approxSizeMb[chosen.tier]} MB of Python packages to ${home}. Ask the researcher first, then run it again with --yes. (--dry-run shows the plan without changing anything.)`);
  }
  const dataRoot = options.dataDir ?? options.env.CLAUDE_PLUGIN_DATA ?? null;
  if (dataRoot) await mkdir(resolve5(dataRoot), { recursive: true });
  guardHome(home, dataRoot, "install");
  await mkdir(home, { recursive: true });
  const release = await takeLock(paths.lock, chosen.python.path, options.env, "install");
  let created = false;
  const abandon = async () => {
    if (created) await rm(paths.venv, { recursive: true, force: true });
  };
  try {
    const env = { ...childEnv(options.env, { kind: "install" }), PIP_DISABLE_PIP_VERSION_CHECK: "1", PIP_NO_INPUT: "1", PYTHONNOUSERSITE: "1" };
    const command3 = installedCommand(home, options.pluginRoot);
    const verdict = await venvVerdict();
    if (verdict !== null && rebuild === null) warnings.push(rebuildWarning(verdict));
    rebuild = verdict;
    const existing = readInstalled(home);
    if (!rebuild && existing && existing.tier === chosen.tier && matchesPinned(existing, pinned) && existsSync4(paths.python)) {
      const health2 = await pilibHealth(command3, env);
      if (health2 && health2.tier === chosen.tier) return { ok: true, action: "already_installed", ...plan2, tier: health2.tier, installed_at: existing.installed_at, notes: ["Already installed and up to date."] };
    }
    if (rebuild) {
      await rm(paths.installed, { force: true });
      await rm(paths.venv, { recursive: true, force: true });
    }
    if (!existsSync4(paths.python)) {
      try {
        await runCommand([chosen.python.path], ["-m", "venv", paths.venv], { timeoutMs: install.venvTimeoutMs, maxBuffer: 1048576, env });
        created = true;
      } catch (error) {
        await rm(paths.venv, { recursive: true, force: true });
        throw stepFailure("creating the private Python folder", error);
      }
    }
    try {
      await runCommand([paths.python], ["-m", "pip", "install", "--quiet", "--require-hashes", "--no-input", "--disable-pip-version-check", "-r", requirements], { timeoutMs: install.pipTimeoutMs, maxBuffer: 16777216, env });
    } catch (error) {
      throw stepFailure("installing the packages", error);
    }
    await mkdir(paths.library, { recursive: true });
    const health = await pilibHealth(command3, env);
    if (!health) throw new LibraryError("exit", "ERROR library install: the packages installed, but the helper does not start. Run `aw library install --dry-run` to see which Python was used, and try another with --python.");
    if (health.tier !== "core" && health.tier !== "structure") throw new LibraryError("exit", "ERROR library install: the packages installed, but the summary helper (LiteLLM) cannot be loaded. Try another Python with --python.");
    const degraded = chosen.tier === "structure" && health.tier !== "structure";
    if (degraded) warnings.push(`The full helper could not start (${health.weasyprint ? "PageIndex did not load" : "the PDF library WeasyPrint did not load"}), so the basic helper is ready and books with no table of contents are not covered yet.${system?.macos && process.platform === "darwin" ? ` On a Mac, run: ${system.macos}, then run this install again.` : system?.debian_ubuntu && process.platform === "linux" ? ` On Linux, run: ${system.debian_ubuntu}, then run this install again.` : " Install the pango system library, then run this install again."}`);
    const real = await probePython(paths.python, env);
    const record = {
      schema: 1,
      tier: health.tier === "structure" ? "structure" : "core",
      requested_tier: chosen.tier,
      python: real?.version ?? chosen.python.version,
      pageindex_commit: health.tier === "structure" ? pinned.pageindex.commit : null,
      requirements_sha256: expected,
      pilib_version: health.pilib_version,
      litellm: health.litellm,
      installed_at: (options.now ?? (() => /* @__PURE__ */ new Date()))().toISOString()
    };
    if (degraded) record.requirements_sha256 = pinned.tiers.core.requirements_sha256;
    await writeAtomic(paths.installed, `${JSON.stringify(record, null, 2)}
`);
    return { ok: true, action: "installed", ...plan2, rebuild_venv: rebuild !== null, rebuild_reason: rebuild, tier: record.tier, degraded, pilib_version: record.pilib_version, litellm: record.litellm ?? null, installed_at: record.installed_at, warnings };
  } catch (error) {
    await abandon();
    throw error;
  } finally {
    await release();
  }
}
async function runUninstall(options) {
  const home = resolveHome(options.env, options.dataDir);
  if (!home) throw new LibraryError("config", "ERROR library uninstall: the plugin's data folder is not known. Pass --data-dir <folder>.");
  guardHome(home, options.dataDir ?? options.env.CLAUDE_PLUGIN_DATA ?? null, "uninstall");
  const paths = installPaths(home);
  if (!options.yes) {
    throw new LibraryError("usage", `ERROR library uninstall: this removes the helper's private Python folder${options.purgeLibrary ? " and every indexed book" : " (the indexed books are kept)"} in ${home}. Ask the researcher first, then run it again with --yes.`);
  }
  if (!existsSync4(home)) return { ok: true, removed: [], library_kept: null, home };
  const python = (await discoverPythons(childEnv(options.env)))[0]?.path ?? (process.platform !== "win32" && existsSync4(paths.python) ? paths.python : null);
  if (!python) throw new LibraryError("config", "ERROR library uninstall: no Python was found to hold the install lock, so nothing was removed. Install Python, or remove the folder by hand.");
  const release = await takeLock(paths.lock, python, options.env, "uninstall");
  try {
    const present = [paths.venv, paths.installed, ...options.purgeLibrary ? [paths.library] : []].filter((path2) => existsSync4(path2));
    for (const path2 of present) await rm(path2, { recursive: true, force: true });
    return { ok: true, removed: present.map((path2) => basename4(path2)), library_kept: options.purgeLibrary ? null : existsSync4(paths.library) ? paths.library : null, home };
  } finally {
    await release();
  }
}
function isLink(path2) {
  try {
    return lstatSync(path2).isSymbolicLink();
  } catch {
    return false;
  }
}

// src/library/config.ts
var LIBRARY_CONFIG_FILE = join8(".academic-helper", "library.json");
var DEFAULT_PAGEINDEX_COMMAND = "pilib";
var DEFAULT_TROVE_COMMAND = "trove";
var libraryConfigSchema = external_exports.object({
  $schema: external_exports.string().optional(),
  route: external_exports.enum(["trove", "pageindex", "both"]),
  primary: external_exports.enum(["trove", "pageindex"]).optional(),
  pageindex: external_exports.object({
    command: external_exports.union([external_exports.string().min(1), external_exports.array(external_exports.string().min(1)).min(1)]).optional(),
    shelf: external_exports.string().min(1).optional()
  }).strict().optional(),
  shadow: external_exports.object({ enabled: external_exports.boolean().optional() }).strict().optional()
}).strict();
function commandFrom(value, fallback) {
  if (Array.isArray(value)) return value;
  if (typeof value === "string" && value.trim()) return splitCommand(value);
  return [fallback];
}
function optionalDataDir() {
  try {
    return dataDir();
  } catch {
    return null;
  }
}
function optionalPluginRoot(env) {
  const bin = dirname3(resolve6(process.argv[1] ?? ""));
  if (basename5(bin) === "bin") return dirname3(bin);
  return env.CLAUDE_PLUGIN_ROOT?.trim() || null;
}
function installedPageindex(env, options) {
  const home = resolveHome(env, options.dataDir === void 0 ? optionalDataDir() : options.dataDir);
  if (!home || !isInstalled(home)) return null;
  const root = options.pluginRoot === void 0 ? optionalPluginRoot(env) : options.pluginRoot;
  return root ? { command: installedCommand(home, root), home } : null;
}
function loadLibraryConfig(project, env = process.env, options = {}) {
  const file = join8(project, LIBRARY_CONFIG_FILE);
  let parsed;
  if (existsSync5(file)) {
    let json;
    try {
      json = JSON.parse(readFileSync6(file, "utf8"));
    } catch {
      throw new LibraryError("config", `ERROR library: ${LIBRARY_CONFIG_FILE} is not valid JSON`);
    }
    const result = libraryConfigSchema.safeParse(json);
    if (!result.success) {
      const issue = result.error.issues[0];
      throw new LibraryError("config", `ERROR library: ${LIBRARY_CONFIG_FILE} is not valid (${issue?.path.join(".") || "file"}: ${issue?.message ?? "unknown problem"})`);
    }
    parsed = result.data;
  }
  const route = parsed?.route ?? "trove";
  if (route !== "both" && parsed?.primary && parsed.primary !== route) {
    throw new LibraryError("config", `ERROR library: ${LIBRARY_CONFIG_FILE} says route "${route}" but primary "${parsed.primary}"; drop primary or use route "both"`);
  }
  const primary = route === "both" ? parsed?.primary ?? "trove" : route;
  const secondary = route === "both" ? primary === "trove" ? "pageindex" : "trove" : null;
  const envPageindex = env.AW_PAGEINDEX_COMMAND?.trim();
  const shelf = parsed?.pageindex?.shelf;
  const fromFile2 = parsed?.pageindex?.command;
  let pageindexCommand;
  let pageindexSource;
  let pageindexHome = resolveHome(env, options.dataDir === void 0 ? optionalDataDir() : options.dataDir);
  if (envPageindex) {
    pageindexCommand = splitCommand(envPageindex);
    pageindexSource = "setting";
  } else if (fromFile2 !== void 0 && (Array.isArray(fromFile2) || fromFile2.trim())) {
    pageindexCommand = commandFrom(fromFile2, DEFAULT_PAGEINDEX_COMMAND);
    pageindexSource = "library.json";
  } else {
    const installed = installedPageindex(env, options);
    if (installed) {
      pageindexCommand = installed.command;
      pageindexSource = "installed";
      pageindexHome = installed.home;
    } else {
      pageindexCommand = [DEFAULT_PAGEINDEX_COMMAND];
      pageindexSource = "default";
    }
  }
  return {
    configured: parsed !== void 0,
    route,
    primary,
    secondary,
    troveCommand: commandFrom(env.AW_TROVE_COMMAND?.trim(), DEFAULT_TROVE_COMMAND),
    pageindexCommand,
    pageindexSource,
    pageindexHome,
    shelfPath: shelf ? isAbsolute2(shelf) ? shelf : resolve6(project, shelf) : null,
    shadowEnabled: route === "both" && (parsed?.shadow?.enabled ?? true)
  };
}
function profileTroveEnabled(project) {
  const file = join8(project, ".academic-helper", "profile.md");
  if (!existsSync5(file)) return null;
  const match = readFileSync6(file, "utf8").match(/^## Tools\s*\n+```json\n([\s\S]*?)\n```/mu);
  if (!match?.[1]) return null;
  try {
    const tools = JSON.parse(match[1]);
    const entry = tools.trove ?? tools.candlekeep;
    return typeof entry?.enabled === "boolean" ? entry.enabled : null;
  } catch {
    return null;
  }
}

