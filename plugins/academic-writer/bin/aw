      const out = text3(flags, "--out") ? resolve12(paths.root, text3(flags, "--out")) : paths.judgeHtml;
      const inside2 = relative3(paths.root, out);
      if (inside2 === "" || inside2.startsWith("..") || isAbsolute4(inside2)) throw new LibraryError("usage", "ERROR library eval page: --out must be a file inside the evaluation folder");
      await writeText(out, html.replace(slot, (_whole, open4, _body, close) => `${open4}${payload}${close}`));
      print({ eval_id: evalId, out, pairs: pairs2.pairs.length });
      return 0;
    }
    if (subcommand2 === "import") {
      const file = text3(flags, "--file");
      if (!file && !flags.has("--stdin")) throw new LibraryError("usage", "ERROR library eval import: give --file <judgments.json> or --stdin");
      let raw;
      try {
        raw = JSON.parse(file ? await readFile7(file, "utf8") : await (io.stdin ?? readStdin)());
      } catch {
        throw new LibraryError("usage", "ERROR library eval import: the judgments are not valid JSON");
      }
      print(await importJudgments({ paths, evalId, raw, partial: flags.has("--partial"), now }));
      return 0;
    }
    if (subcommand2 === "unblind") {
      const report = await unblind({ paths, force: flags.has("--force"), now });
      io.out(flags.has("--json") ? `${JSON.stringify(report)}
` : renderMarkdown(report));
      return 0;
    }
    const plan2 = await readJson(paths.plan);
    if (plan2 === null || validate("plan", plan2).length > 0) throw new LibraryError("usage", `ERROR library eval status: no plan for ${evalId}`);
    const typed = plan2;
    let finished2 = 0;
    let failed = 0;
    const invalidRuns = [];
    for (const claim of typed.claims) {
      for (const route of typed.routes) {
        const run = await readJson(runFile(paths, claim.id, route));
        if (run && validate("run", run).length === 0) {
          if (run.violations.length > 0) invalidRuns.push(run);
          if (run.status === "ok") finished2 += 1;
          else failed += 1;
        }
      }
    }
    const invalidClaimList = invalidClaims(invalidRuns);
    const invalidNote = invalidWarning(invalidRuns.length, typed.claims.length * typed.routes.length);
    const pairs = await readJson(paths.pairs);
    const judgments = await readJson(paths.judgments);
    const judgedIds = new Set((judgments?.entries ?? []).map((entry) => entry.pair_id));
    const built = pairs?.pairs.length ?? 0;
    const unblinded = existsSync20(paths.reportJson);
    const stage = unblinded ? "unblinded" : judgments && judgedIds.size >= built && built > 0 ? "judged" : pairs ? "paired" : finished2 + failed >= typed.claims.length * typed.routes.length ? "located" : "planned";
    print({
      eval_id: evalId,
      ...invalidNote ? { warning: invalidNote } : {},
      stage,
      claims: typed.claims.length,
      invalid: { runs: invalidRuns.length, claims: invalidClaimList },
      runs: { expected: typed.claims.length * typed.routes.length, finished: finished2, failed },
      pairs: { built, identical: pairs?.pairs.filter((pair) => pair.auto_same).length ?? 0 },
      judged: { done: judgedIds.size, of: built },
      unblinded
    });
    return 0;
  } catch (error) {
    io.err(`${errorMessage(error)}
`);
    return exitCodeFor(error);
  }
}

// src/library/report.ts
import { lstat as lstat3, readFile as readFile8, readdir as readdir2 } from "node:fs/promises";
import { join as join26 } from "node:path";
init_thresholds();
var limits7 = thresholds_default.library;
var LOCATE_STEP = "library.eval.locate";
var INDEX_STEP2 = "library.index";
function rate2(part, whole3) {
  return whole3 === 0 ? null : Math.round(part / whole3 * 1e3) / 1e3;
}
function percentile(values, p) {
  if (values.length === 0) return null;
  const sorted = [...values].sort((a, b) => a - b);
  return sorted[Math.max(0, Math.ceil(p / 100 * sorted.length) - 1)];
}
var latency = (values) => ({ p50: percentile(values, 50), p90: percentile(values, 90) });
var sum2 = (values) => values.reduce((total, value) => total + value, 0);
var median2 = (values) => percentile(values, 50);
var sumCost = (values) => values.length === 0 ? null : Math.round(sum2(values) * 1e6) / 1e6;
var OPS = ["list", "toc", "read", "get"];
function parseLocateRun(runId2) {
  const match = runId2.match(/^(.+)-(trove|pageindex)-(c\d+)$/u);
  return match ? { eval: match[1], route: match[2], claim: match[3] } : null;
}
var emptyConfusion = () => ({ supports: 0, not_supports: 0, unknown: 0 });
var ROUTES = ["trove", "pageindex"];
function buildReport(rows, invalid, run = null, input = {}) {
  const evalId = input.eval ?? null;
  const inScope = (runId2) => (run === null || runId2 === run) && (evalId === null || runId2 !== null && parseLocateRun(runId2)?.eval === evalId);
  let lookups = rows.filter((row) => row.row_type === "lookup");
  if (run !== null || evalId !== null) lookups = lookups.filter((row) => inScope(row.run_id));
  const ids = new Set(lookups.map((row) => row.lookup_id));
  const shadows = /* @__PURE__ */ new Map();
  const verdicts = /* @__PURE__ */ new Map();
  for (const row of rows) {
    if (!ids.has(row.lookup_id)) continue;
    if (row.row_type === "shadow") shadows.set(row.lookup_id, row);
    else if (row.row_type === "verdict") {
      const key = `${row.lookup_id}\0${row.paragraph_id ?? ""}`;
      const held = verdicts.get(key);
      const order = held ? compareVerdictKeys(row, held) : 1;
      if (!held || order > 0 || order === 0 && (row.settled === true || held.settled !== true)) verdicts.set(key, row);
    }
  }
  const routes = {};
  const totals = { lookups: 0, pages: 0, agreed: 0 };
  for (const name of ROUTES) {
    const answered = lookups.filter((row) => row.route_primary === name);
    const failed = answered.filter((row) => !row.primary.ok).length;
    const ran = [...shadows.values()].filter((row) => row.route === name);
    const compared = answered.flatMap((row) => {
      const agree = shadows.get(row.lookup_id)?.agree;
      return agree ? [agree] : [];
    });
    const mine = [...verdicts.values()].filter((row) => row.primary_route === name);
    const passes = mine.filter((row) => row.verdict === "PASS").length;
    const checked = mine.filter((row) => row.shadow_supports !== null);
    const supported = checked.filter((row) => row.shadow_supports === true).length;
    const pagesCompared = compared.reduce((total, agree) => total + agree.compared, 0);
    const pagesAgreed = compared.reduce((total, agree) => total + agree.agreed, 0);
    totals.lookups += compared.length;
    totals.pages += pagesCompared;
    totals.agreed += pagesAgreed;
    routes[name] = {
      lookups: answered.length,
      errors: failed,
      error_rate: rate2(failed, answered.length),
      latency_ms: latency(answered.map((row) => row.primary.latency_ms)),
      by_op: byOp(answered),
      shadow_runs: ran.length,
      shadow_errors: ran.filter((row) => !row.ok && row.error_code !== "page_map").length,
      shadow_timeouts: ran.filter((row) => row.timed_out).length,
      shadow_unmapped: ran.filter((row) => !row.ok && row.error_code === "page_map").length,
      shadow_latency_ms: latency(ran.map((row) => row.latency_ms)),
      agreement: { pages_compared: pagesCompared, pages_agreed: pagesAgreed, rate: rate2(pagesAgreed, pagesCompared) },
      auditor: {
        verdicts: mine.length,
        pass: passes,
        fail: mine.length - passes,
        pass_rate: rate2(passes, mine.length),
        fail_with_corrected_page: mine.filter((row) => row.verdict === "FAIL" && row.corrected_page !== null).length,
        shadow_checked: checked.length,
        shadow_supports: supported,
        shadow_supports_rate: rate2(supported, checked.length)
      },
      enough_data: answered.length >= limits7.report.minLookups
    };
  }
  const tokens2 = tokenReport(lookups, [...shadows.values()]);
  const usage = (input.usage ?? []).filter((row) => inScope(row.run_id));
  const confusion = { PASS: emptyConfusion(), FAIL: emptyConfusion() };
  for (const row of verdicts.values()) {
    const bucket = confusion[row.verdict];
    if (row.shadow_supports === true) bucket.supports += 1;
    else if (row.shadow_supports === false) bucket.not_supports += 1;
    else bucket.unknown += 1;
  }
  const readLookups = lookups.filter((row) => row.op === "read" || row.op === "get");
  const withVerdict = new Set([...verdicts.values()].map((row) => row.lookup_id).filter((id) => readLookups.some((lookup) => lookup.lookup_id === id))).size;
  const modes = {};
  for (const row of lookups) {
    const key = row.mode === "both" ? `both, ${row.route_primary} answers` : row.mode;
    modes[key] = (modes[key] ?? 0) + 1;
  }
  const skipped = {};
  for (const row of lookups) if (row.shadow_status.startsWith("skipped:")) {
    const why = row.shadow_status.slice(8);
    skipped[why] = (skipped[why] ?? 0) + 1;
  }
  const settled = [...verdicts.values()];
  const report = {
    run,
    eval: evalId,
    rows: { lookup: lookups.length, shadow: shadows.size, verdict: verdicts.size, invalid },
    modes,
    routes,
    agreement: { lookups_compared: totals.lookups, pages_compared: totals.pages, pages_agreed: totals.agreed, rate: rate2(totals.agreed, totals.pages) },
    auditor: { verdicts: verdicts.size, lookups_with_verdict: withVerdict, read_lookups: readLookups.length, verdict_coverage: rate2(withVerdict, readLookups.length), shadow_supports_by_verdict: confusion },
    tokens: tokens2,
    agents: agentReport(usage, lookups),
    indexing: indexingReport(usage),
    data_quality: {
      shadow_pending_verdicts: settled.filter((row) => row.shadow_supports_reason === "shadow_pending").length,
      shadow_missing_verdicts: settled.filter((row) => row.shadow_supports_reason === "shadow_missing").length,
      no_quote_verdicts: settled.filter((row) => row.shadow_supports_reason === "no_quote").length,
      lookups_without_shadow_row: lookups.filter((row) => row.shadow_status === "pending" && !shadows.has(row.lookup_id)).length,
      shadow_skipped: skipped,
      usage_invalid: input.usageInvalid ?? 0
    },
    notes: []
  };
  if (lookups.length === 0) report.notes.push(evalId === null ? "No lookups are recorded yet." : `No lookups are recorded for evaluation ${evalId}.`);
  for (const name of ROUTES) if (routes[name].lookups > 0 && !routes[name].enough_data) report.notes.push(`Only ${routes[name].lookups} lookups were answered by ${name}; treat its rates as a rough guide (${limits7.report.minLookups} or more is a fair sample).`);
  if (report.data_quality.shadow_pending_verdicts > 0) report.notes.push("Some verdicts were recorded while the second lookup was still running; run the report again with --settle to finish them.");
  if (report.data_quality.lookups_without_shadow_row > 0) report.notes.push(`${report.data_quality.lookups_without_shadow_row} second lookups left no result (still running, or stopped early).`);
  if (lookups.length > 0 && report.auditor.verdicts === 0) report.notes.push("No auditor verdicts are recorded yet, so pass rates and second-library support are empty.");
  if (report.data_quality.usage_invalid > 0) report.notes.push(`${report.data_quality.usage_invalid} unreadable lines in the usage ledgers were skipped.`);
  return report;
}
function byOp(answered) {
  const out = {};
  for (const op of OPS) {
    const mine = answered.filter((row) => row.op === op);
    if (mine.length === 0) continue;
    out[op] = { lookups: mine.length, latency_ms: latency(mine.map((row) => row.primary.latency_ms)), est_tokens: sum2(mine.map((row) => row.primary.ok ? row.primary.est_tokens ?? 0 : 0)) };
  }
  return out;
}
function tokenReport(lookups, shadows) {
  const routes = {};
  for (const name of ROUTES) {
    const measured = lookups.filter((row) => row.route_primary === name && row.primary.ok && row.primary.est_tokens !== void 0);
    const estimates = measured.map((row) => row.primary.est_tokens);
    const paged = measured.filter((row) => (row.op === "read" || row.op === "get") && (row.primary.pages_returned ?? 0) > 0);
    const pages = sum2(paged.map((row) => row.primary.pages_returned));
    const quiet = shadows.filter((row) => row.route === name && row.ok && row.est_tokens !== void 0).map((row) => row.est_tokens);
    routes[name] = {
      lookups_measured: measured.length,
      total: sum2(estimates),
      per_lookup: latency(estimates),
      per_page_avg: pages === 0 ? null : Math.round(sum2(paged.map((row) => row.primary.est_tokens)) / pages),
      pages_measured: pages,
      shadow: { runs_measured: quiet.length, total: sum2(quiet), per_run: latency(quiet) }
    };
  }
  return { basis: "estimate", hebrew_chars_per_token: limits7.tokens.hebrewCharsPerToken, other_chars_per_token: limits7.tokens.otherCharsPerToken, routes };
}
function agentReport(usage, lookups) {
  const located = usage.filter((row) => row.step === LOCATE_STEP);
  const byRun = /* @__PURE__ */ new Map();
  for (const row of lookups) {
    if (row.run_id === null) continue;
    const held = byRun.get(row.run_id) ?? { count: 0, est: 0 };
    held.count += 1;
    if (row.primary.ok) held.est += row.primary.est_tokens ?? 0;
    byRun.set(row.run_id, held);
  }
  const routes = {};
  let unattributed = 0;
  for (const row of located) if (parseLocateRun(row.run_id) === null) unattributed += 1;
  for (const name of ROUTES) {
    const mine = located.filter((row) => parseLocateRun(row.run_id)?.route === name);
    const ids = [...new Set(mine.map((row) => row.run_id))];
    const costs = mine.flatMap((row) => row.cost_usd === null ? [] : [row.cost_usd]);
    const counts = ids.map((id) => byRun.get(id)?.count ?? 0);
    const returned = ids.map((id) => byRun.get(id)?.est ?? 0);
    routes[name] = {
      runs: mine.length,
      failed: mine.filter((row) => row.exit !== "OK").length,
      retried: mine.length - ids.length,
      wall_ms: latency(mine.map((row) => row.latency_ms)),
      input_tokens: { total: sum2(mine.map((row) => row.input_tokens)), median: median2(mine.map((row) => row.input_tokens)) },
      output_tokens: { total: sum2(mine.map((row) => row.output_tokens)), median: median2(mine.map((row) => row.output_tokens)) },
      cost_usd: { total: sumCost(costs), median: median2(costs), known_runs: costs.length },
      lookups_per_run: { median: median2(counts), total: sum2(counts) },
      returned_est_tokens_per_run: { median: median2(returned), total: sum2(returned) }
    };
  }
  return { step: LOCATE_STEP, runs: located.length, unattributed, routes };
}
function indexingReport(usage) {
  const mine = usage.filter((row) => row.step === INDEX_STEP2);
  const costs = mine.flatMap((row) => row.cost_usd === null ? [] : [row.cost_usd]);
  return {
    step: INDEX_STEP2,
    runs: mine.length,
    failed: mine.filter((row) => row.exit !== "OK").length,
    input_tokens: sum2(mine.map((row) => row.input_tokens)),
    output_tokens: sum2(mine.map((row) => row.output_tokens)),
    cost_usd: { total: sumCost(costs), known_runs: costs.length },
    wall_ms: latency(mine.map((row) => row.latency_ms)),
    models: [...new Set(mine.map((row) => row.model))].sort()
  };
}
async function readUsageRows(project) {
  const rows = [];
  let invalid = 0;
  const dir = await containedDir(project, ["runs"]);
  if (!dir) return { rows, invalid };
  let names;
  try {
    names = (await readdir2(dir)).sort();
  } catch {
    return { rows, invalid };
  }
  for (const name of names) {
    let text4;
    try {
      const folder = join26(dir, name);
      if (!(await lstat3(folder)).isDirectory()) continue;
      const file = join26(folder, "usage.jsonl");
      const info = await lstat3(file);
      if (!info.isFile() || info.size > limits7.maxBufferBytes) continue;
      text4 = await readFile8(file, "utf8");
    } catch {
      continue;
    }
    for (const line of text4.split("\n")) {
      if (!line.trim()) continue;
      try {
        const parsed = JSON.parse(line);
        if (checkSchema(ledger_row_schema_default, parsed).length > 0) invalid += 1;
        else if (parsed.step === LOCATE_STEP || parsed.step === INDEX_STEP2) rows.push(parsed);
      } catch {
        invalid += 1;
      }
    }
  }
  return { rows, invalid };
}
async function reportFor(project, run, options = {}) {
  const evalId = options.eval ?? null;
  if (evalId !== null) {
    if (run !== null) throw new LibraryError("usage", "ERROR library report: use --run or --eval, not both");
    if (!/^[A-Za-z0-9][A-Za-z0-9._#:-]{0,79}$/u.test(evalId)) throw new LibraryError("usage", "ERROR library report: --eval must be a plain id (letters, digits and . _ # : - only)");
  }
  const [{ rows, invalid }, usage] = await Promise.all([readRows(project), readUsageRows(project)]);
  return buildReport(rows, invalid, run, { eval: evalId, usage: usage.rows, usageInvalid: usage.invalid });
}
var pct2 = (value) => value === null ? "n/a" : `${Math.round(value * 1e3) / 10}%`;
var ms = (value) => value === null ? "n/a" : `${value} ms`;
var secs = (value) => value === null ? "n/a" : `${(Math.round(value / 100) / 10).toFixed(1)} s`;
var num3 = (value) => value === null ? "n/a" : value.toLocaleString("en-US");
var usd2 = (value) => value === null ? "n/a" : `$${value.toFixed(value >= 1 ? 2 : 3)}`;
var KIND = { list: "book lists", toc: "tables of contents", read: "page reads", get: "whole-book reads" };
var ROUTE_NAME = { trove: "Trove", pageindex: "PageIndex" };
function formatMeasures(report) {
  const lines = [];
  const { tokens: tokens2, agents, indexing } = report;
  const tokenLines = [];
  for (const name of ROUTES) {
    const route = report.routes[name];
    const stats = tokens2.routes[name];
    if (stats.lookups_measured === 0 && stats.shadow.runs_measured === 0) continue;
    const parts = [];
    if (stats.lookups_measured > 0) {
      parts.push(`${route.lookups} lookups answered${stats.lookups_measured < route.lookups ? ` (${stats.lookups_measured} carry an estimate; older rows do not)` : ""}, about ${num3(stats.total)} tokens in all; half return ${num3(stats.per_lookup.p50)} or fewer, nine in ten ${num3(stats.per_lookup.p90)} or fewer${stats.per_page_avg === null ? "" : `; about ${num3(stats.per_page_avg)} per page`}`);
    }
    if (stats.shadow.runs_measured > 0) parts.push(`second lookups ${stats.shadow.runs_measured}, about ${num3(stats.shadow.total)} tokens in all`);
    tokenLines.push(`  ${ROUTE_NAME[name]}: ${parts.join("; ")}`);
  }
  if (tokenLines.length > 0) {
    lines.push("", `Returned text (token figures are estimates: about ${tokens2.hebrew_chars_per_token} Hebrew or ${tokens2.other_chars_per_token} other characters per token, so Claude's own counts will differ)`, ...tokenLines);
  }
  const agentLines = [];
  for (const name of ROUTES) {
    const stats = agents.routes[name];
    if (stats.runs === 0) continue;
    const cost = stats.cost_usd.known_runs === 0 ? "cost not reported" : `cost ${usd2(stats.cost_usd.total)} in all (median ${usd2(stats.cost_usd.median)}; reported for ${stats.cost_usd.known_runs} of ${stats.runs} runs)`;
    agentLines.push(`  ${ROUTE_NAME[name]}: ${stats.runs} runs (${stats.failed} failed${stats.retried > 0 ? `, ${stats.retried} tried again` : ""}); half finish within ${secs(stats.wall_ms.p50)}, nine in ten within ${secs(stats.wall_ms.p90)}; per run, median ${num3(stats.input_tokens.median)} tokens in and ${num3(stats.output_tokens.median)} out; ${cost}; median ${num3(stats.lookups_per_run.median)} lookups per run returning about ${num3(stats.returned_est_tokens_per_run.median)} tokens (estimate)`);
  }
  if (agentLines.length > 0) lines.push("", "Locating agents (library-eval runs; the agent tokens and cost are what the agent's own tool reported)", ...agentLines);
  else if (report.rows.lookup > 0 && agents.unattributed === 0) lines.push("", "Agent tokens and cost are recorded only for library-eval runs (none here); the citation checker running inside a writing session does not report its tokens.");
  if (agents.unattributed > 0) lines.push(`  ${agents.unattributed} locating-agent runs have a run id that names no route and are not counted per route.`);
  if (indexing.runs > 0) {
    const cost = indexing.cost_usd.known_runs === 0 ? "cost not reported" : `cost ${usd2(indexing.cost_usd.total)} (reported for ${indexing.cost_usd.known_runs} of ${indexing.runs} runs)`;
    lines.push("", "Indexing (page summaries for PageIndex, from the usage ledger)", `  ${indexing.runs} runs (${indexing.failed} failed), ${num3(indexing.input_tokens)} tokens in and ${num3(indexing.output_tokens)} out, ${cost}; half finish within ${secs(indexing.wall_ms.p50)}${indexing.models.length > 0 ? `; model ${indexing.models.join(", ")}` : ""}`);
  }
  return lines;
}
function formatReport(report) {
  const lines = [];
  lines.push(`Library report${report.run ? ` for run ${report.run}` : ""}${report.eval ? ` for evaluation ${report.eval}` : ""}`);
  lines.push(`Lookups ${report.rows.lookup}, second lookups ${report.rows.shadow}, auditor verdicts ${report.rows.verdict}${report.rows.invalid ? `, ${report.rows.invalid} unreadable lines skipped` : ""}`);
  const modes = Object.entries(report.modes);
  if (modes.length) lines.push(`Setups seen: ${modes.map(([mode, count2]) => `${mode} (${count2})`).join("; ")}`);
  for (const name of ROUTES) {
    const route = report.routes[name];
    if (route.lookups === 0 && route.shadow_runs === 0) continue;
    lines.push("", name === "trove" ? "Trove" : "PageIndex");
    if (route.lookups > 0) lines.push(`  Answered ${route.lookups} lookups, ${route.errors} failed (${pct2(route.error_rate)}); half finish within ${ms(route.latency_ms.p50)}, nine in ten within ${ms(route.latency_ms.p90)}`);
    const kinds = OPS.flatMap((op) => {
      const stats = route.by_op[op];
      return stats ? [`${KIND[op]} ${stats.lookups} (half within ${ms(stats.latency_ms.p50)})`] : [];
    });
    if (kinds.length > 1) lines.push(`  By kind: ${kinds.join("; ")}`);
    if (route.shadow_runs > 0) lines.push(`  Ran quietly alongside ${route.shadow_runs} times: ${route.shadow_errors} failed, ${route.shadow_timeouts} timed out, ${route.shadow_unmapped} had no page mapping; half within ${ms(route.shadow_latency_ms.p50)}, nine in ten within ${ms(route.shadow_latency_ms.p90)}`);
    if (route.agreement.pages_compared > 0) lines.push(`  When ${name} answered, the other library returned the same page text for ${route.agreement.pages_agreed} of ${route.agreement.pages_compared} pages (${pct2(route.agreement.rate)})`);
    if (route.auditor.verdicts > 0) lines.push(`  Auditor: ${route.auditor.pass} of ${route.auditor.verdicts} citations passed (${pct2(route.auditor.pass_rate)}), ${route.auditor.fail_with_corrected_page} failed with a corrected page; the other library's page also supported the claim for ${route.auditor.shadow_supports} of ${route.auditor.shadow_checked} checked (${pct2(route.auditor.shadow_supports_rate)})`);
  }
  lines.push("", `Page agreement overall: ${report.agreement.pages_agreed} of ${report.agreement.pages_compared} pages (${pct2(report.agreement.rate)}) over ${report.agreement.lookups_compared} lookups`);
  const confusion = report.auditor.shadow_supports_by_verdict;
  lines.push(`Lookups with an auditor verdict: ${report.auditor.lookups_with_verdict} of ${report.auditor.read_lookups} page reads (${pct2(report.auditor.verdict_coverage)}); ${report.auditor.verdicts} verdicts in all`);
  lines.push(`  Passed: the other library supports ${confusion.PASS.supports}, does not ${confusion.PASS.not_supports}, unknown ${confusion.PASS.unknown}`);
  lines.push(`  Failed: the other library supports ${confusion.FAIL.supports}, does not ${confusion.FAIL.not_supports}, unknown ${confusion.FAIL.unknown}`);
  const quality = report.data_quality;
  lines.push(`Gaps: ${quality.shadow_pending_verdicts} verdicts waiting on the second lookup, ${quality.shadow_missing_verdicts} with no second-lookup text, ${quality.no_quote_verdicts} without a usable quote, ${quality.lookups_without_shadow_row} second lookups with no result`);
  const skipped = Object.entries(quality.shadow_skipped);
  if (skipped.length) lines.push(`Second lookups skipped: ${skipped.map(([why, count2]) => `${why.replace(/_/gu, " ")} (${count2})`).join(", ")}`);
  lines.push(...formatMeasures(report));
  for (const note of report.notes) lines.push("", note);
  return `${lines.join("\n")}
`;
}

// src/library/verdict.ts
init_thresholds();
import { randomBytes as randomBytes7 } from "node:crypto";
