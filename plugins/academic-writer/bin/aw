#!/usr/bin/env node

// src/paths.ts
import { resolve } from "node:path";
var dataArgument;
var projectArgument;
function setPathArguments(args2) {
  const rest = [];
  for (let index = 0; index < args2.length; index += 1) {
    const arg = args2[index];
    if ((arg === "--data-dir" || arg === "--project-dir") && args2[index + 1]) {
      if (arg === "--data-dir") dataArgument = args2[index + 1];
      else projectArgument = args2[index + 1];
      index += 1;
    } else rest.push(arg);
  }
  return rest;
}
function dataDir() {
  if (!dataArgument) throw new Error("ERROR: --data-dir is required");
  return resolve(dataArgument);
}
function projectDir() {
  if (!projectArgument) throw new Error("ERROR: --project-dir is required");
  return resolve(projectArgument);
}

// src/main.ts
