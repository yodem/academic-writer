var stubs2 = {};
var EMPTY_STYLE_WORDS = { banned: [], capped: [], filler: [] };
function roleOf(unit) {
  if (unit.role === "intro" || unit.role === "conclusion") return unit.role;
  if (unit.id === "intro") return "intro";
  if (unit.id === "conclusion") return "conclusion";
  return "body";
}
function flatten(outline) {
  if (Array.isArray(outline.units)) return outline.units;
  const sections = Array.isArray(outline.sections) ? outline.sections : [];
  return sections.flatMap((section) => Array.isArray(section.units) ? section.units : []);
}
function topoSort(units) {
  const byId = new Map(units.map((unit) => [unit.id, unit]));
  const indegree = new Map(units.map((unit) => [unit.id, 0]));
  const dependents = /* @__PURE__ */ new Map();
  for (const unit of units) {
    for (const dep of unit.dependsOn ?? []) {
      if (!byId.has(dep)) continue;
      indegree.set(unit.id, (indegree.get(unit.id) ?? 0) + 1);
      dependents.set(dep, [...dependents.get(dep) ?? [], unit.id]);
    }
  }
  const queue = units.filter((unit) => (indegree.get(unit.id) ?? 0) === 0).map((unit) => unit.id);
  const order = [];
  const seen = /* @__PURE__ */ new Set();
  while (queue.length) {
    const id = queue.shift();
    if (id === void 0 || seen.has(id)) continue;
    seen.add(id);
    const unit = byId.get(id);
    if (unit) order.push(unit);
    for (const next of dependents.get(id) ?? []) {
      indegree.set(next, (indegree.get(next) ?? 1) - 1);
      if ((indegree.get(next) ?? 0) <= 0) queue.push(next);
    }
  }
  if (order.length !== units.length) {
    const stuck = units.filter((unit) => !seen.has(unit.id)).map((unit) => unit.id);
    throw new AwError("ERROR", "write.draft", `cycle detected in dependsOn: ${stuck.join(", ")}`);
  }
  return order;
}
function normalize2(value) {
  return value.normalize("NFC").replace(/\s+/gu, " ").trim();
}
function splitParagraphs(text4) {
  return text4.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
}
function extractCitationKeys(text4) {
  const keys = /* @__PURE__ */ new Set();
  const re = /\[\^([^\]]+)\]/g;
  let match;
  while (match = re.exec(text4)) keys.add(match[1]);
  return [...keys];
}
var HEBREW_LETTER = /[א-ת]/;
function isAbbreviationGershayim(text4, index) {
  const prev = text4[index - 1];
  const next = text4[index + 1];
  const after = text4[index + 2];
  return Boolean(prev && next && HEBREW_LETTER.test(prev) && HEBREW_LETTER.test(next) && !(after && HEBREW_LETTER.test(after)));
}
function pairDelimiters(text4, char, filterAbbreviation) {
  const positions = [];
  for (let index = 0; index < text4.length; index += 1) {
    if (text4[index] !== char) continue;
    if (filterAbbreviation && isAbbreviationGershayim(text4, index)) continue;
    positions.push(index);
  }
  const spans = [];
  for (let index = 0; index + 1 < positions.length; index += 2) {
    spans.push(text4.slice(positions[index] + 1, positions[index + 1]));
  }
  return spans;
}
function extractQuotedSpans(text4) {
  const gershayim = pairDelimiters(text4, "\u05F4", true);
  const curly = [...text4.matchAll(/“([^“”]+)”/g)].map((m2) => m2[1]);
  const straight = pairDelimiters(text4, '"', false);
  return [...gershayim, ...curly, ...straight].filter((span) => span.trim().length > 0);
}
function countOccurrences(haystack, needle) {
  if (!needle) return 0;
  return haystack.split(needle).length - 1;
}
function runGates(unit, text4, paragraphs2, ctx) {
  const citations = extractCitationKeys(text4);
  const badCitation = citations.find((key) => !ctx.sourceKeys.has(key));
  if (badCitation !== void 0) return { gate: "citation-not-in-sources", detail: badCitation };
  const quoteText = ctx.quoteCheckText ?? text4;
  const leftover = quoteText.match(/⟦Q:([^⟧\s]+)⟧/u);
  if (leftover) return { gate: "quote-not-in-evidence", detail: `unknown quote placeholder ${leftover[1]}` };
  const pool = ctx.evidenceQuotes.map(normalize2).filter(Boolean);
  const termMaxWords = thresholds_default.paragraph.quotedTermMaxWords ?? 0;
  for (const quote2 of extractQuotedSpans(quoteText)) {
    const needle = normalize2(quote2);
    if (!needle) continue;
    if (needle.split(" ").length <= termMaxWords) continue;
    if (!pool.some((passage) => passage.includes(needle))) return { gate: "quote-not-in-evidence", detail: quote2.slice(0, 80) };
  }
  for (const banned of ctx.styleWords.banned) {
    if (text4.includes(banned.word)) return { gate: "style-banned", detail: banned.word };
  }
  for (const capped of ctx.styleWords.capped) {
    if (capped.maxPer === "chapter") {
      const count2 = countOccurrences(text4, capped.word);
      if (count2 > capped.max) return { gate: "style-capped", detail: `"${capped.word}" x${count2} > ${capped.max}/chapter` };
    } else {
      for (const paragraph of paragraphs2) {
        const count2 = countOccurrences(paragraph, capped.word);
        if (count2 > capped.max) return { gate: "style-capped", detail: `"${capped.word}" x${count2} > ${capped.max}/paragraph` };
      }
    }
  }
  if (Array.isArray(unit.paragraphs)) {
    const words = (ctx.quoteCheckText ?? text4).split(/\s+/).filter(Boolean).length;
    const para = thresholds_default.paragraph;
    const n = Math.max(1, unit.paragraphs.length);
    const bonus = unit.role === "intro" || unit.role === "conclusion" ? para.wordCeilingIntroConclusionBonus : 0;
    const bounds = { minWords: n * para.wordFloor, maxWords: n * (para.wordCeiling + bonus) };
    if (words < bounds.minWords || words > bounds.maxWords) {
      return { gate: "word-bounds", detail: `${words} words (bounds ${bounds.minWords}-${bounds.maxWords} for ${n} planned paragraph(s))` };
    }
  }
  return null;
}
function fillTemplate(template, vars) {
  return template.replace(/\{\{(\w+)\}\}/g, (_, key) => vars[key] ?? "");
}
function languageDirective(thesis) {
  return HEBREW_LETTER.test(thesis) ? "\u05DB\u05EA\u05D5\u05D1 \u05D0\u05EA \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05D4\u05D6\u05D5 \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA \u05D1\u05DC\u05D1\u05D3. \u05D0\u05DC \u05EA\u05EA\u05E8\u05D2\u05DD \u05D5\u05D0\u05DC \u05EA\u05E2\u05E8\u05D1\u05D1 \u05E9\u05E4\u05D5\u05EA." : "Write this unit only in English. Do not translate or mix languages.";
}
async function realGenerate(unit, predecessors, ctx) {
  const system = fillTemplate(write_draft_default, {
    thesis: ctx.outline.thesis ?? "",
    unit_id: unit.id,
    unit_role: roleOf(unit),
    unit_claim: unit.claim ?? "",
    unit_plan: JSON.stringify(unit.paragraphs ?? [], null, 2),
    outline_summary: JSON.stringify(flatten(ctx.outline).map((u) => ({ id: u.id, claim: u.claim ?? "" })), null, 2),
    evidence_passages: ctx.passagesText,
    predecessor_text: predecessors.length ? predecessors.map((p) => `### ${p.id}
${p.text}`).join("\n\n") : "(none \u2014 this is the first unit)",
    voice_exemplars: JSON.stringify(ctx.voice.exemplars, null, 2),
    voice_pairs: JSON.stringify(ctx.voice.pairs, null, 2),
    voice_rules: ctx.voice.rules,
    feedback: ctx.feedback ?? "(none \u2014 first draft of this unit)",
    language_directive: languageDirective(ctx.outline.thesis ?? "")
  });
  const result = await callGemini({ step: "write.draft", system, parts: ["Draft the unit now. Return plain prose only."], runId: ctx.runId, budget: ctx.budget });
  return result.text;
}
