var modeOverrides = /* @__PURE__ */ new Map();
async function decide(req) {
  const config = thresholds_default.jev;
  const mode = modeOverrides.get(req.point) ?? config.points[req.point]?.mode ?? "off";
  const enabled = Boolean((process.env.JEV_API_KEY ?? "").trim()) || jevCall !== askJev;
  const activeMode = enabled ? mode : "off";
  let jevResult = null;
  let modelAnswer = null;
  let answer;
  let by = "model";
  if (activeMode === "off") {
    modelAnswer = await req.fallback();
    answer = modelAnswer;
  } else if (activeMode === "shadow") {
    const [model, jev] = await Promise.all([req.fallback(), (jevCall?.(req) ?? Promise.resolve(null)).catch(() => null)]);
    modelAnswer = model;
    jevResult = jev;
    answer = model;
  } else {
    jevResult = await (jevCall?.(req) ?? Promise.resolve(null)).catch(() => null);
    if (jevResult && jevResult.confidence >= config.threshold && req.options.includes(jevResult.answer)) {
      answer = jevResult.answer;
      by = "jev";
    } else {
      modelAnswer = await req.fallback();
      answer = modelAnswer;
    }
  }
  const dir = join3(projectDir(), ".academic-helper", "runs", req.runId);
  mkdirSync2(dir, { recursive: true });
  appendFileSync2(join3(dir, "jev.jsonl"), `${JSON.stringify({ point: req.point, jevAnswer: jevResult?.answer ?? null, jevConfidence: jevResult?.confidence ?? null, modelAnswer, decidedBy: by, label: req.label ?? null })}
`, "utf8");
  return { answer, by, confidence: jevResult?.confidence ?? null };
}
async function runDecideCli(args2) {
  const value = (name) => {
    const position = args2.indexOf(name);
    return position >= 0 ? args2[position + 1] : void 0;
  };
  const pointValue = args2[1];
  const question = value("--question");
  const rawOptions = value("--options");
  const contextFile = value("--context-file");
  const fallback = value("--fallback");
  const runIdValue = value("--run");
  const label = value("--label");
  if (!pointValue || !VALID_POINTS.has(pointValue) || !question || !rawOptions || !contextFile || !fallback || !runIdValue) {
    throw new Error("ERROR decide: expected aw decide <point> --question <text> --options a,b --context-file <file> --fallback <answer> --run <id>");
  }
  const options = rawOptions.split(",").map((item) => item.trim()).filter(Boolean);
  if (options.length < 2) throw new Error("ERROR decide: --options requires at least two comma-separated answers");
  if (!options.includes(fallback)) throw new Error("ERROR decide: --fallback must match one of --options");
  const context = readFileSync2(contextFile, "utf8");
  return decide({ point: pointValue, question, options, context, runId: runIdValue, fallback: async () => fallback, label });
}

