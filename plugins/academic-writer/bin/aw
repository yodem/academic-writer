async function slotIsStale(file, now) {
  try {
    const age = now - (await stat4(file)).mtimeMs;
    const token = await readToken(file);
    if (age > limits3.shadow.lockStaleMs) return token ?? "unreadable";
    if (age < limits3.shadow.reapGraceMs || !token) return null;
    return pidAlive(token.pid) ? null : token;
  } catch {
    return null;
  }
}
async function reapSlots(dir) {
  const guard = join10(dir, ".reap");
  try {
    await mkdir3(guard);
  } catch {
    try {
      if (Date.now() - (await stat4(guard)).mtimeMs > limits3.shadow.reapGraceMs * 5) await rm3(guard, { recursive: true, force: true });
    } catch {
    }
    return;
  }
  try {
    const now = Date.now();
    for (let slot = 0; slot < limits3.shadow.maxConcurrent; slot += 1) {
      const file = slotFile(dir, slot);
      const judged = await slotIsStale(file, now);
      if (judged === null) continue;
      const current = await readToken(file);
      if (judged === "unreadable" ? current === null : current?.nonce === judged.nonce) await rm3(file, { force: true });
    }
  } finally {
    await rm3(guard, { recursive: true, force: true });
  }
}
async function acquireSlot(project) {
  try {
    const dir = await containedDir(project, ["retrieval", "active"], true);
    if (!dir) return null;
    await reapSlots(dir);
    const nonce = randomBytes(12).toString("hex");
    for (let slot = 0; slot < limits3.shadow.maxConcurrent; slot += 1) {
      try {
        const handle = await open3(slotFile(dir, slot), "wx", 420);
        try {
          await handle.writeFile(JSON.stringify({ pid: process.pid, nonce, ts: nowIso() }), "utf8");
        } finally {
          await handle.close();
        }
        return { slot, nonce };
      } catch (error) {
        if (error.code !== "EEXIST") return null;
      }
    }
    return null;
  } catch {
    return null;
  }
}
async function claimSlot(project, held, pid) {
  try {
    const dir = await containedDir(project, ["retrieval", "active"]);
    if (!dir) return;
    const file = slotFile(dir, held.slot);
    const handle = await open3(file, "r+");
    try {
      const current = await readToken(file);
      if (current?.nonce !== held.nonce) return;
      await handle.truncate(0);
      await handle.writeFile(JSON.stringify({ pid, nonce: held.nonce, ts: nowIso() }), "utf8");
    } finally {
      await handle.close();
    }
  } catch {
  }
}
async function releaseSlot(project, held) {
  if (held === null) return;
  try {
    const dir = await containedDir(project, ["retrieval", "active"]);
    if (!dir) return;
    const file = slotFile(dir, held.slot);
    if ((await readToken(file))?.nonce === held.nonce) await rm3(file, { force: true });
  } catch {
  }
}
