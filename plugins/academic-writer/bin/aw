// src/library/jsonschema.ts
function isRecord(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}
function typeOf(value) {
  if (value === null) return "null";
  if (Array.isArray(value)) return "array";
  if (typeof value === "number") return Number.isInteger(value) ? "integer" : "number";
  return typeof value;
}
function typeMatches(want, value) {
  const got = typeOf(value);
  return want === got || want === "number" && got === "integer";
}
function resolveRef(root, ref) {
  if (!ref.startsWith("#/")) return void 0;
  let node = root;
  for (const part of ref.slice(2).split("/")) node = isRecord(node) ? node[part] : void 0;
  return isRecord(node) ? node : void 0;
}
function checkSchema(schema3, value, root = schema3, path2 = "") {
  const here = path2 || "row";
  if (typeof schema3.$ref === "string") {
    const target = resolveRef(root, schema3.$ref);
    return target ? checkSchema(target, value, root, path2) : [`${here}: unknown reference ${schema3.$ref}`];
  }
  if (Array.isArray(schema3.oneOf)) {
    const options = schema3.oneOf.filter(isRecord);
    const results = options.map((option) => checkSchema(option, value, root, path2));
    const passing = results.filter((problems2) => problems2.length === 0).length;
    if (passing === 1) return [];
    if (passing > 1) return [`${here}: matches more than one option`];
    const best = results.reduce((a, b) => b.length < a.length ? b : a, results[0] ?? [`${here}: no option matches`]);
    return best;
  }
  const problems = [];
  if ("const" in schema3 && schema3.const !== value) problems.push(`${here}: expected ${JSON.stringify(schema3.const)}`);
  if (Array.isArray(schema3.enum) && !schema3.enum.includes(value)) problems.push(`${here}: not one of ${schema3.enum.map((item) => JSON.stringify(item)).join(", ")}`);
  if (schema3.type !== void 0) {
    const wanted = (Array.isArray(schema3.type) ? schema3.type : [schema3.type]).filter((item) => typeof item === "string");
    if (!wanted.some((name) => typeMatches(name, value))) return [`${here}: expected ${wanted.join(" or ")}`];
  }
  if (typeof value === "number") {
    if (typeof schema3.minimum === "number" && value < schema3.minimum) problems.push(`${here}: below ${schema3.minimum}`);
    if (typeof schema3.maximum === "number" && value > schema3.maximum) problems.push(`${here}: above ${schema3.maximum}`);
  }
  if (typeof value === "string") {
    if (typeof schema3.minLength === "number" && value.length < schema3.minLength) problems.push(`${here}: too short`);
    if (typeof schema3.maxLength === "number" && value.length > schema3.maxLength) problems.push(`${here}: too long`);
    if (typeof schema3.pattern === "string" && !new RegExp(schema3.pattern, "u").test(value)) problems.push(`${here}: does not match ${schema3.pattern}`);
  }
  if (Array.isArray(value) && isRecord(schema3.items)) {
    value.forEach((item, index) => problems.push(...checkSchema(schema3.items, item, root, `${path2}[${index}]`)));
  }
  if (isRecord(value)) {
    const properties = isRecord(schema3.properties) ? schema3.properties : {};
    if (Array.isArray(schema3.required)) {
      for (const key of schema3.required) if (typeof key === "string" && !(key in value)) problems.push(`${path2 ? `${path2}.` : ""}${key}: missing`);
    }
    for (const [key, item] of Object.entries(value)) {
      const child = properties[key];
      const next = path2 ? `${path2}.${key}` : key;
      if (isRecord(child)) problems.push(...checkSchema(child, item, root, next));
      else if (schema3.additionalProperties === false) problems.push(`${next}: not allowed`);
    }
  }
  return problems;
}

// src/library/redact.ts
var MARK = "[redacted]";
var NAME2 = "(?:key|token|secret|password|passwd|pwd|credential|cookie|session|authorization|auth(?![a-z]))";
var RULES = [
  // Header lines that carry credentials: the whole value to the end of the line (scheme and credentials, or every cookie).
  [/\b((?:Proxy-)?Authorization|Set-Cookie|Cookie)\s*[:=][^\r\n]*/giu, `$1: ${MARK}`],
  // JSON web tokens and well known key shapes
  [/\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}/gu, MARK],
  [/\b(?:sk|pk|rk)-[A-Za-z0-9_-]{8,}/gu, MARK],
  [/\bgh[pousr]_[A-Za-z0-9]{20,}/gu, MARK],
  [/\bxox[abprs]-[A-Za-z0-9-]{10,}/gu, MARK],
  [/\bAKIA[0-9A-Z]{16}\b/gu, MARK],
  [/\bAIza[0-9A-Za-z_-]{20,}/gu, MARK],
  // credentials inside a URL: scheme://user:pass@host or scheme://token@host
  [/(\b[a-z][a-z0-9+.-]*:\/\/)[^/\s@]+@/giu, `$1${MARK}@`],
  // Authorization header values written without the header name
  [/\b(Bearer|Basic|Token)\s+[A-Za-z0-9._~+/=-]{6,}/giu, `$1 ${MARK}`],
  // NAME=value, NAME: value, "name": "value", 'name': 'value' (single or double quoted names and values)
  [new RegExp(`(["']?)\\b([A-Za-z0-9_.-]*${NAME2}[A-Za-z0-9_.-]*)\\b(["']?\\s*[=:]\\s*)("(?:[^"\\\\]|\\\\.)*"|'(?:[^'\\\\]|\\\\.)*'|[^\\s,;}]+)`, "giu"), `$1$2$3${MARK}`],
  // command line flags that carry a secret: --api-key abc, --token=abc
  [new RegExp(`(--[a-z0-9-]*(?:key|token|secret|password|passwd)[a-z0-9-]*)(\\s+|=)(\\S+)`, "giu"), `$1$2${MARK}`],
  // long strings that mix letters and digits: hex digests, base64 blobs, opaque ids
  [/(?<![A-Za-z0-9+/_-])(?=[A-Za-z0-9+/_-]*[0-9])(?=[A-Za-z0-9+/_-]*[A-Za-z])[A-Za-z0-9+/_-]{32,}={0,2}/gu, MARK]
];
function redact(text4) {
  let out = text4;
  for (const [pattern, replacement] of RULES) out = out.replace(pattern, replacement);
  return out;
}

