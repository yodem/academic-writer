// src/sefaria.ts
async function fetchSefaria(reference) {
  const response = await fetch(`https://www.sefaria.org/api/v3/texts/${encodeURIComponent(reference)}`);
  if (!response.ok) throw new Error(`ERROR sefaria.fetch: HTTP ${response.status}`);
  const payload = await response.json();
  if (typeof payload !== "object" || payload === null) throw new Error("ERROR sefaria.fetch: invalid response");
  const record = payload;
  const flatten2 = (value) => Array.isArray(value) ? value.flatMap(flatten2) : typeof value === "string" ? [value] : [];
  const text4 = flatten2(record.he).join("\n");
  if (!text4) throw new Error("ERROR sefaria.fetch: missing Hebrew text");
  return { title: typeof record.ref === "string" ? record.ref : reference, author: "", text: text4 };
}

