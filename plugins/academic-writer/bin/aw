var LibraryError = class extends Error {
  code;
  stderr;
  constructor(code, message, stderr = "") {
    super(message);
    this.name = "LibraryError";
    this.code = code;
    this.stderr = stderr;
  }
};
function errorMessage(error) {
  return error instanceof Error ? error.message : String(error);
}

// src/library/exec.ts
var STDERR_KEEP = 8192;
var CommandScope = class {
  stopped = false;
  children = /* @__PURE__ */ new Set();
  get aborted() {
    return this.stopped;
  }
  add(child) {
    this.children.add(child);
  }
  remove(child) {
    this.children.delete(child);
  }
  abort() {
    this.stopped = true;
    for (const child of this.children) {
      try {
        if (process.platform !== "win32" && child.pid) process.kill(-child.pid, "SIGKILL");
        else child.kill("SIGKILL");
      } catch {
        try {
          child.kill("SIGKILL");
        } catch {
        }
      }
    }
    this.children.clear();
  }
};
function runCommand(command3, args2, options) {
  const [file, ...prefix] = command3;
  if (!file) return Promise.reject(new LibraryError("config", "ERROR library: empty command"));
  const label = file.split("/").pop() ?? file;
  if (options.scope?.aborted) return Promise.reject(new LibraryError("timeout", `ERROR library: ${label} not started: this lookup was stopped`));
  return new Promise((resolve13, reject) => {
    let settled = false;
    const chunks = [];
    let size = 0;
    let stderr = "";
    const posix = process.platform !== "win32";
    const child = spawn(file, [...prefix, ...args2], { stdio: ["ignore", "pipe", "pipe"], env: options.env, cwd: options.cwd, detached: posix, windowsHide: true });
    options.scope?.add(child);
    const killTree = () => {
      try {
        if (posix && child.pid) process.kill(-child.pid, "SIGKILL");
        else child.kill("SIGKILL");
      } catch {
        try {
          child.kill("SIGKILL");
        } catch {
        }
      }
    };
    const finish = (fn) => {
      if (settled) return;
      settled = true;
      options.scope?.remove(child);
      clearTimeout(timer);
      fn();
    };
    const timer = setTimeout(() => {
      finish(() => {
        killTree();
        options.scope?.abort();
        child.stdout?.destroy();
        child.stderr?.destroy();
        reject(new LibraryError("timeout", `ERROR library: ${label} did not answer within ${options.timeoutMs} ms`));
      });
    }, options.timeoutMs);
    child.stdout?.on("data", (chunk) => {
      size += chunk.length;
      if (size > options.maxBuffer) {
        finish(() => {
          killTree();
          reject(new LibraryError("too_large", `ERROR library: ${label} output is larger than ${options.maxBuffer} bytes`));
        });
        return;
      }
      chunks.push(chunk);
    });
    child.stderr?.on("data", (chunk) => {
      if (stderr.length < STDERR_KEEP) stderr += chunk.toString("utf8");
    });
    child.on("error", (error) => {
      finish(() => reject(new LibraryError("spawn", error.code === "ENOENT" ? `ERROR library: command not found: ${file}` : `ERROR library: could not start ${label}: ${error.message}`)));
    });
    child.on("close", (code) => {
      finish(() => {
        if (code === 0) resolve13(Buffer.concat(chunks).toString("utf8"));
        else reject(new LibraryError("exit", `ERROR library: ${label} exited with code ${code ?? "signal"}: ${stderr.trim().slice(0, 300)}`, stderr));
      });
    });
  });
}
function splitCommand(text4) {
  const words = [];
  let current = "";
  let quote2 = null;
  let started = false;
  for (const char of text4) {
    if (quote2) {
      if (char === quote2) quote2 = null;
      else current += char;
    } else if (char === '"' || char === "'") {
      quote2 = char;
      started = true;
    } else if (/\s/u.test(char)) {
      if (started) {
        words.push(current);
        current = "";
        started = false;
      }
    } else {
      current += char;
      started = true;
    }
  }
  if (quote2) throw new LibraryError("config", "ERROR library: unbalanced quote in the command setting");
  if (started) words.push(current);
  return words;
}

// src/library/pages.ts
init_thresholds();
import { existsSync, readFileSync } from "node:fs";
