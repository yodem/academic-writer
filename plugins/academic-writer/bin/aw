async function startShadow(spec, mode, env, runner2) {
  if (mode === "off") return idle("disabled");
  let slot = null;
  let specPath = null;
  try {
    if (!await hasProjectFolder(spec.project)) return idle("skipped:no_project_dir");
    if (mode === "inline") return { status: "pending", settle: () => runShadowWorker({ ...spec, slot: null }, runner2, workerSettings(env)) };
    const entry = workerEntry(env, process.argv[1] ? resolve7(process.argv[1]) : void 0);
    if (!entry) return idle("skipped:spawn_failed");
    slot = await acquireSlot(spec.project);
    if (slot === null) return idle("skipped:busy");
    const dir = await containedDir(spec.project, ["retrieval"], true);
    if (!dir) throw new Error("no retrieval folder");
    specPath = join10(dir, `spec-${spec.lookup_id}.json`);
    const handle = await open3(specPath, "wx", 420);
    try {
      await handle.writeFile(JSON.stringify({ ...spec, slot: slot.slot, slot_nonce: slot.nonce }), "utf8");
    } finally {
      await handle.close();
    }
    const child = spawn5(process.execPath, [entry, "library", "_shadow", specPath], { detached: true, stdio: "ignore", windowsHide: true, env, cwd: spec.project });
    child.on("error", () => void 0);
    child.unref();
    if (child.pid) await claimSlot(spec.project, slot, child.pid);
    return idle("pending");
  } catch {
    if (specPath) await rm3(specPath, { force: true });
    await releaseSlot(spec.project, slot);
    return idle("skipped:spawn_failed");
  }
}
async function loadSpec(path2) {
  try {
