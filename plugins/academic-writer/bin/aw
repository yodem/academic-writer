var Budget = class {
  tokens = 0;
  usd = 0;
  runId;
  caps;
  constructor(runId2, caps) {
    this.runId = runId2;
    this.caps = caps;
  }
  charge(usage, costUsd = 0, step = "write.draft") {
    this.tokens += usage.in + usage.out;
    this.usd += costUsd;
    if (this.tokens > this.caps.maxTokens || this.caps.maxUsd !== void 0 && this.usd > this.caps.maxUsd) {
      throw new AwError("CAP_REACHED", step, `budget exceeded for ${this.runId}`);
    }
  }
};
