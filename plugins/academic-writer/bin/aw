var spawnRunner = async (args2, systemPrompt) => {
  const fullArgs = args2.map((arg) => arg === "__SYSTEM_PROMPT__" ? systemPrompt : arg);
  return await new Promise((resolve13, reject) => {
    const child = spawn2("pi", fullArgs, { stdio: ["pipe", "pipe", "pipe"], env: allowedEnv(process.env, "pi") });
    child.stdin.end();
    let stdout = "";
    let stderr = "";
    child.stdout.setEncoding("utf8").on("data", (chunk) => {
      stdout += chunk;
    });
    child.stderr.setEncoding("utf8").on("data", (chunk) => {
      stderr += chunk;
    });
    child.on("error", reject);
    child.on("close", (code) => {
      try {
        if (code !== 0) {
          reject(new Error(stderr || `pi exited ${String(code)}`));
          return;
        }
        const events = stdout.split("\n").filter(Boolean).map((line) => JSON.parse(line));
        const final = events.filter((event2) => event2.type === "message_end").at(-1);
        const message = final?.message;
        if (!message) {
          reject(new Error("missing final message_end event"));
          return;
        }
        const finalText = (message.content ?? []).map((item) => item.text ?? "").join("");
        resolve13({ finalText, usage: { in: message.usage?.input ?? 0, out: message.usage?.output ?? 0 } });
      } catch (error) {
        reject(error);
      }
    });
  });
};
