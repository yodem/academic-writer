function estimateTokens(text4) {
  let hebrew = 0;
  for (let index = 0; index < text4.length; index += 1) {
    const code = text4.charCodeAt(index);
    if (code >= 1424 && code <= 1535 || code >= 64285 && code <= 64335) hebrew += 1;
  }
  const tokens2 = hebrew / limits2.tokens.hebrewCharsPerToken + (text4.length - hebrew) / limits2.tokens.otherCharsPerToken;
  return Math.ceil(tokens2);
}
