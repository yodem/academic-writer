    const ids = new Set((unit.paragraphs ?? []).flatMap((p) => p.evidenceIds ?? []));
    return (raw.passages ?? []).filter((passage) => ids.size === 0 || ids.has(passage.id));
  } catch {
    return [];
  }
}
function renderPassages(passages) {
  return passages.length ? passages.map((p) => `[${p.id}] source=${p.sourceId}${p.locator ? ` locator=${p.locator}` : ""}
  quote: ${p.quote}${p.gloss ? `
  gloss: ${p.gloss}` : ""}`).join("\n") : "(none)";
}
function quoteIndex() {
  const path2 = join15(projectDir(), ".academic-helper", "evidence.json");
  if (!existsSync9(path2)) return /* @__PURE__ */ new Map();
  try {
    const raw = JSON.parse(readFileSync11(path2, "utf8"));
    return new Map((raw.passages ?? []).map((p) => [p.id, p.quote]));
  } catch {
    return /* @__PURE__ */ new Map();
  }
}
function substituteQuotes(text4, quotes) {
  return text4.replace(/⟦Q:([^⟧\s]+)⟧([.,;:]?)/gu, (whole3, id, after) => {
    const quote2 = quotes.get(id);
    if (quote2 === void 0) return whole3;
    const body = after ? quote2.replace(/[.,;:]+\s*$/u, "") : quote2;
    return (/[\u0590-\u05FF]/u.test(body) ? `\u05F4${body}\u05F4` : `"${body}"`) + after;
  });
}
function renderFootnotes(text4, meta) {
  return text4.replace(/^\[\^([^\]]+)\]:.*$/gmu, (line, key) => {
    const m2 = meta.get(key);
    if (!m2) return line;
    const locator = m2.locator.replace(/^Page\s+(\d+).*$/iu, "\u05E2\u05DE\u05F3 $1");
    return `[^${key}]: ${[m2.author, m2.title, locator].filter(Boolean).join(", ")}.`;
  });
}
function footnoteMeta() {
  const path2 = join15(projectDir(), ".academic-helper", "evidence.json");
  if (!existsSync9(path2)) return /* @__PURE__ */ new Map();
  try {
    const raw = JSON.parse(readFileSync11(path2, "utf8"));
    const src = new Map((raw.sources ?? []).map((x2) => [x2.id, x2]));
    return new Map((raw.passages ?? []).map((p) => [p.id, { author: src.get(p.sourceId)?.author ?? "", title: src.get(p.sourceId)?.title ?? "", locator: p.locator ?? "" }]));
  } catch {
    return /* @__PURE__ */ new Map();
  }
}
function evidenceQuotesFor(unit) {
  const path2 = join15(projectDir(), ".academic-helper", "evidence.json");
  if (!existsSync9(path2)) return [];
  try {
    const raw = JSON.parse(readFileSync11(path2, "utf8"));
    const ids = new Set((unit.paragraphs ?? []).flatMap((p) => p.evidenceIds ?? []));
    return (raw.passages ?? []).filter((passage) => ids.size === 0 || ids.has(passage.id)).map((passage) => passage.quote);
  } catch {
    return [];
  }
}
async function loadVoiceBundle(runId2) {
  const cfg2 = thresholds_default.voice.bundle;
  const result = await voiceBundle({ n: cfg2.exemplars, pairs: cfg2.pairs, runId: runId2 });
  const parsed = JSON.parse(readFileSync11(result.path, "utf8"));
  return { exemplars: parsed.exemplars ?? [], pairs: parsed.pairs ?? [], rules: parsed.rules ?? "", styleWords: parsed.styleWords ?? EMPTY_STYLE_WORDS };
}
async function voiceCheckFallback(paragraph, styleWords) {
  const bannedHits = styleWords.banned.filter((b) => paragraph.includes(b.word)).length;
  const fillerHits = styleWords.filler.filter((w) => paragraph.includes(w)).length;
  const cfg2 = thresholds_default.styleFingerprint;
  const score = Math.max(0, cfg2.maxScore - bannedHits * 2 - fillerHits);
  return score >= cfg2.passThreshold ? "pass" : "fail";
}
var GATE_REASON = {
  "citation-not-in-sources": "unknown-source",
  "quote-not-in-evidence": "quote-not-in-evidence",
  "style-banned": "banned-word",
  "style-capped": "word-used-too-often",
  "word-bounds": "length-out-of-range"
};
async function draftAll(outline, options) {
  return endRunOnError(options.runId, options.flow ?? "write", () => draftUnits(outline, options));
}
async function draftUnits(outline, options) {
  const allUnits = flatten(outline);
  if (allUnits.length === 0) throw new AwError("ERROR", "write.draft", "outline has no units");
  const bodyUnits = allUnits.filter((unit) => roleOf(unit) === "body");
  const specialUnits = allUnits.filter((unit) => roleOf(unit) !== "body").sort((a, b) => (roleOf(a) === "conclusion" ? 1 : 0) - (roleOf(b) === "conclusion" ? 1 : 0));
  const ordered = [...topoSort(bodyUnits), ...specialUnits];
  const orderedIds = new Set(ordered.map((u) => u.id));
  for (const dep of allUnits.flatMap((u) => u.dependsOn ?? [])) {
    if (dep && !orderedIds.has(dep) && !allUnits.some((u) => u.id === dep)) {
      throw new AwError("ERROR", "write.draft", `dangling dependency: ${dep}`);
    }
  }
  const targetUnits = options.unit ? ordered.filter((unit) => unit.id === options.unit) : ordered;
  if (options.unit && targetUnits.length === 0) throw new AwError("ERROR", "write.draft", `unknown unit: ${options.unit}`);
  const draftedText = /* @__PURE__ */ new Map();
  if (options.unit && !stubs2.gen) {
    for (const unit of ordered) {
      if (unit.id === options.unit) break;
      if (existsSync9(draftPath(unit.id))) draftedText.set(unit.id, readFileSync11(draftPath(unit.id), "utf8"));
    }
  }
  const voice = stubs2.voice ?? await loadVoiceBundle(options.runId);
  const sourceKeys = withPassageKeys(loadSourceKeys());
  const feedback = options.feedbackFile && existsSync9(options.feedbackFile) ? readFileSync11(options.feedbackFile, "utf8") : void 0;
  const budget = new Budget(options.runId, budgetFor("write"));
  const drafted = [];
  const failures = [];
  const audit = [];
  const flow = options.flow ?? "write";
  const redrafting = options.unit !== void 0 && options.feedbackFile !== void 0;
  const stepName = flow !== "write" ? "edit" : redrafting ? "redraft" : "draft";
  startRunOnce(options.runId, flow);
  emit(options.runId, flow, "step_start", { step: stepName });
  for (const unit of targetUnits) {
    const role = roleOf(unit);
    const predecessors = role === "body" ? (unit.dependsOn ?? []).filter((id) => draftedText.has(id)).map((id) => ({ id, text: draftedText.get(id) })) : bodyUnits.filter((u) => draftedText.has(u.id)).map((u) => ({ id: u.id, text: draftedText.get(u.id) }));
    const evidenceQuotes = stubs2.evidenceQuotes ?? evidenceQuotesFor(unit);
    const generate = stubs2.gen ?? ((u, preds) => realGenerate(u, preds, { outline, voice, evidenceQuotes, passagesText: renderPassages(evidencePassagesFor(unit)), feedback, budget, runId: options.runId }));
    const raw = await generate(unit, predecessors);
    const quotes = quoteIndex();
    const text4 = renderFootnotes(substituteQuotes(raw, quotes), footnoteMeta());
    const modelQuotesText = raw.replace(/⟦Q:([^⟧\s]+)⟧/gu, (whole3, id) => quotes.has(id) ? "\u27E8quote\u27E9" : whole3);
    draftedText.set(unit.id, text4);
    writeDraft(unit.id, text4);
    drafted.push(unit.id);
    if (redrafting) emit(options.runId, flow, "redraft", { step: stepName, unit: unit.id });
    emit(options.runId, flow, "unit_drafted", { step: stepName, unit: unit.id });
    const paragraphs2 = splitParagraphs(text4);
    for (let index = 0; index < paragraphs2.length; index += 1) {
      const paragraph = paragraphs2[index];
      await decide({
        point: "write.audit_prescreen",
        question: "Does this paragraph plausibly contain a citation the auditor should check?",
        options: ["review", "skip-likely"],
        context: JSON.stringify({ unit: unit.id, paragraphIndex: index, excerpt: paragraph.slice(0, 200) }),
        runId: options.runId,
        fallback: async () => "review"
      });
      audit.push({ unit: unit.id, paragraphIndex: index, required: true });
      await decide({
        point: "write.voice_check",
        question: "Does this paragraph meet the voice/style-fingerprint threshold?",
        options: ["pass", "fail"],
        context: JSON.stringify({ unit: unit.id, paragraphIndex: index }),
        runId: options.runId,
        fallback: async () => voiceCheckFallback(paragraph, voice.styleWords)
      });
    }
    const failure = runGates(unit, text4, paragraphs2, { sourceKeys, evidenceQuotes, styleWords: voice.styleWords, quoteCheckText: modelQuotesText });
    if (failure) failures.push({ unit: unit.id, gate: failure.gate, detail: failure.detail });
    emit(options.runId, flow, "gate", { step: stepName, unit: unit.id, gate: failure ? failure.gate : "draft-gates", ok: !failure, ...failure ? { reason: GATE_REASON[failure.gate] ?? "gate-failed" } : {} });
  }
  emit(options.runId, flow, "step_end", { step: stepName });
  return { drafted, failures, audit };
}

