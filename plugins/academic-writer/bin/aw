// src/library/textmatch.ts
var INVISIBLE = /[​-‏‪-‮⁠-⁩﻿]/gu;
var HEBREW_MARKS = /[֑-ׇֽֿׁׂׅׄ]/gu;
var INWORD_QUOTES = /["'`׳״‘’“”]/gu;
function normalizeText(text4) {
  return text4.normalize("NFC").replace(INVISIBLE, "").replace(HEBREW_MARKS, "").replace(INWORD_QUOTES, "").replace(/[\p{P}\p{S}]+/gu, " ").toLowerCase().replace(/\s+/gu, " ").trim();
}
function tokens(text4) {
  const normal = normalizeText(text4);
  return normal ? normal.split(" ") : [];
}
function jaccard(a, b) {
  const left = new Set(tokens(a));
  const right = new Set(tokens(b));
  if (left.size === 0 && right.size === 0) return 1;
  let shared = 0;
  for (const word of left) if (right.has(word)) shared += 1;
  return shared / (left.size + right.size - shared);
}
function coverage(quote2, text4) {
  const wanted = tokens(quote2);
  if (wanted.length === 0) return 0;
  const have = new Set(tokens(text4));
  return wanted.filter((word) => have.has(word)).length / wanted.length;
}

