    if (subcommand === "classify") {
      if (!Array.isArray(input)) throw new Error("ERROR revise.classify: items must be an array");
      process.stdout.write(`${JSON.stringify(await classify(input, args[args.indexOf("--run") + 1] ?? "revise"))}
`);
    } else if (subcommand === "apply") process.stdout.write(`${JSON.stringify(await applyPlan(input))}
`);
    else throw new Error("ERROR revise: expected classify or apply");
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR revise: unknown failure"}
`);
    process.exitCode = 2;
  }
} else if (command2 === "evidence" && subcommand === "build") {
  const value = (name) => {
    const position = args.indexOf(name);
    return position >= 0 ? args[position + 1] : void 0;
  };
  const list = (name) => (value(name) ?? "").split(",").map((item) => item.trim()).filter(Boolean);
  const runIdValue = value("--run");
  try {
    if (!runIdValue) throw new Error("ERROR evidence.build: --run is required");
    const result = await buildEvidence({ sources: list("--sources"), sefaria: list("--sefaria"), intent: value("--intent"), runId: runIdValue });
    process.stdout.write(`${JSON.stringify({ sourceCount: result.sources.length, passageCount: result.passages.length })}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR evidence.build: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "decide") {
  try {
    const result = await runDecideCli(args);
    process.stdout.write(`${JSON.stringify(result)}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR decide: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "voice") {
  try {
    dataDir();
    projectDir();
    if (subcommand === "migrate") process.stdout.write(`${voiceMigrate(args[args.indexOf("--from") + 1] ?? projectDir())}
`);
    else if (subcommand === "exemplars") process.stdout.write(`${JSON.stringify(voiceCandidates(args[args.indexOf("--corpus") + 1] ?? ""), null, 2)}
`);
    else if (subcommand === "bundle") {
      const bundle = await voiceBundle({ n: Number(args[args.indexOf("--n") + 1] ?? thresholds_default.voice.bundle.exemplars), pairs: Number(args[args.indexOf("--pairs") + 1] ?? thresholds_default.voice.bundle.pairs), runId: args[args.indexOf("--run-id") + 1] ?? "default" });
      process.stdout.write(`${bundle.path}
`);
    } else if (subcommand === "moves") process.stdout.write(`${await voiceMoves(args[args.indexOf("--run-id") + 1] ?? "voice-moves")}
`);
    else if (subcommand === "push" || subcommand === "pull") process.stdout.write(`${voiceSync(subcommand)}
`);
    else throw new Error("ERROR: expected aw voice migrate|exemplars|bundle|moves|push|pull");
  } catch (error) {
    const message = error instanceof Error ? error.message : "ERROR voice: unknown failure";
    process.stderr.write(`${message}
`);
    process.exitCode = message.includes("no voice store") ? 3 : 2;
  }
} else if (command2 === "draft") {
  try {
    const value = (name) => {
      const i2 = args.indexOf(name);
      return i2 >= 0 ? args[i2 + 1] : void 0;
    };
    const runId2 = value("--run");
    const outlinePath = value("--outline");
    const flowArg = value("--flow");
    if (flowArg !== void 0 && !["write", "edit", "edit-section"].includes(flowArg)) throw new Error("ERROR draft: --flow must be write, edit or edit-section");
    if (!runId2 || !outlinePath) throw new Error("ERROR draft: --outline and --run are required");
    const result = await draftAll(JSON.parse(readFileSync19(outlinePath, "utf8")), { runId: runId2, unit: value("--unit"), feedbackFile: value("--feedback-file"), flow: flowArg });
    process.stdout.write(`${JSON.stringify({ drafted: result.drafted, failures: result.failures })}
`);
    if (result.failures.length) process.exitCode = 2;
  } catch (error) {
    const message = error instanceof Error ? error.message : "ERROR draft: unknown failure";
    process.stderr.write(`${message}
`);
    process.exitCode = 1;
  }
} else if (command2 === "synthesize") {
  try {
    const i2 = args.indexOf("--run");
    const runId2 = i2 >= 0 ? args[i2 + 1] : void 0;
    if (!runId2) throw new Error("ERROR synthesize: --run is required");
    process.stdout.write(`${JSON.stringify(await synthesizeAll({ runId: runId2 }))}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR synthesize: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "edit") {
  try {
    const value = (name) => {
      const i2 = args.indexOf(name);
      return i2 >= 0 ? args[i2 + 1] : void 0;
    };
    const runId2 = value("--run");
    const textFile = value("--text-file");
    const language = value("--lang");
    const instruction = value("--instruction") ?? (value("--instruction-file") ? readFileSync19(value("--instruction-file"), "utf8") : void 0);
    if (!runId2 || !textFile || !instruction || language !== "he" && language !== "en") throw new Error("ERROR edit: --text-file, --instruction or --instruction-file, --lang he|en, and --run are required");
    process.stdout.write(`${JSON.stringify(await editText({ runId: runId2, textFile, instruction, language, out: value("--out"), section: args.includes("--section") }))}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR edit: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "ocr") {
  try {
    const value = (name) => {
      const i2 = args.indexOf(name);
      return i2 >= 0 ? args[i2 + 1] : void 0;
    };
    const runId2 = value("--run");
    const input = value("--input");
    const language = value("--lang");
    const format = value("--format");
    const engine = value("--engine") ?? "auto";
    if (!runId2 || !input || !["he", "en", "mixed"].includes(language ?? "") || format && !["concise", "detailed"].includes(format) || !["auto", "gemini", "claude", "local"].includes(engine)) throw new Error("ERROR ocr: --input, --lang he|en|mixed, and --run are required; --format must be concise|detailed; --engine must be auto|gemini|claude|local");
    process.stdout.write(`${JSON.stringify(await ocrDocument({ runId: runId2, input, language, pages: value("--pages"), format, out: value("--out"), engine }))}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR ocr: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "docx") {
  try {
    const value = (name) => {
      const i2 = args.indexOf(name);
      return i2 >= 0 ? args[i2 + 1] : void 0;
    };
    const runId2 = value("--run");
    const outline = value("--outline");
    const out = value("--out");
    if (!runId2 || !outline || !out) throw new Error("ERROR docx: --outline, --run, and --out are required");
    const result = generateDocx({ outlinePath: outline, runId: runId2, out, title: value("--title"), coverFile: value("--cover-file"), abstractFile: value("--abstract-file"), formatFile: value("--format-file"), projectDir: projectDir(), dataDir: dataDir(), pluginRoot: pluginRoot() });
    process.stdout.write(`${docxSummary(result, out)}
`);
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : "ERROR docx: unknown failure"}
`);
    process.exitCode = 1;
  }
} else if (command2 === "activity" && subcommand === "show") {
  const value = (name) => {
    const i2 = args.indexOf(name);
    return i2 >= 0 ? args[i2 + 1] : void 0;
  };
  const run = value("--run");
  if (!run && !args.includes("--latest")) {
    process.stderr.write("ERROR activity: --run <id> or --latest is required\n");
    process.exitCode = 2;
  } else {
    try {
      process.stdout.write(`${activityShow({ run, latest: !run }, projectDirOr())}
`);
    } catch (error) {
      process.stderr.write(`${error instanceof Error ? error.message : "ERROR activity: unknown failure"}
`);
      process.exitCode = 2;
    }
  }
} else if (command2 === "library") {
  process.exitCode = await runLibraryCli(args.slice(1));
} else {
  process.stderr.write("ERROR: expected aw models check, aw ledger show <runId>, aw evidence build, aw decide <point>, or aw library <status|index|backfill|install|eval|...>\n");
  process.exitCode = 2;
}
