var limits8 = thresholds_default.library;
function sleep3(ms2) {
  return new Promise((resolveSleep) => {
    setTimeout(resolveSleep, ms2);
  });
}
function pagesSupport(quote2, pages, page) {
  const byPage = new Map(pages.map((entry) => [entry.page, entry.text]));
  const covers = (text4) => coverage(quote2, text4) >= limits8.supports.tokenCoverageMin;
  const any = page === void 0 || page === null;
  for (const start of any ? [...byPage.keys()] : [page - 1, page]) {
    const first = byPage.get(start);
    if (first === void 0) continue;
    if ((any || start === page) && covers(first)) return true;
    const next = byPage.get(start + 1);
    if (next !== void 0 && covers(`${first}
${next}`)) return true;
  }
  return false;
}
async function computeSupports(project, lookupId, quote2, waitMs, page, probe2) {
  if (tokens(quote2).length < limits8.supports.minQuoteTokens) return { supports: null, reason: "no_quote" };
  const rows = await rowsForLookup(project, lookupId);
  const lookup = rows.find((row) => row.row_type === "lookup");
  if (!lookup || lookup.shadow_status !== "pending") return { supports: null, reason: "shadow_missing" };
  const deadline = Date.now() + waitMs;
  const judge2 = (spool) => {
    if (spool.too_large || spool.pages.length === 0) return { supports: null, reason: "shadow_missing" };
    return pagesSupport(quote2, spool.pages, page) ? { supports: true, reason: "covered" } : { supports: false, reason: "not_covered" };
  };
  const spoolPath = spoolFile(project, lookupId, "shadow");
  let first = true;
  for (; ; ) {
    const spool = await readSpool(project, spoolPath);
    if (first) {
      first = false;
      await probe2?.afterFirstSpoolRead?.();
    }
    if (spool) return judge2(spool);
    const shadow = (await rowsForLookup(project, lookupId)).find((row) => row.row_type === "shadow");
    if (shadow) {
      const again = await readSpool(project, spoolPath);
      return again ? judge2(again) : { supports: null, reason: "shadow_missing" };
    }
    if (Date.now() >= deadline) return { supports: null, reason: "shadow_pending" };
    await sleep3(limits8.shadow.pollMs);
  }
}
var WALL_AT_START = BigInt(Date.now()) * 1000000n;
var MONO_AT_START = process.hrtime.bigint();
function nowNs() {
  return String(WALL_AT_START + (process.hrtime.bigint() - MONO_AT_START));
}
function newKey() {
  return { verdict_at: nowNs(), pid: process.pid, nonce: randomBytes7(8).toString("hex") };
}
var pendingName = (lookupId, paragraph, nonce) => `pending-${lookupId}-${textSha(paragraph ?? "").slice(0, 8)}-${nonce}.json`;
var pendingFile = (project, lookupId, paragraph, nonce) => join27(spoolDir(project), pendingName(lookupId, paragraph, nonce));
async function earlierVerdicts(project, lookup, paragraph) {
  return (await rowsForLookup(project, lookup)).filter((row) => row.row_type === "verdict" && row.paragraph_id === paragraph);
}
function verdictRow(input, key, result, lookup, settled) {
  return {
    row_type: "verdict",
    schema: 1,
    ...key,
    ts: nowIso(),
    lookup_id: input.lookup,
    run_id: input.run ?? lookup?.run_id ?? null,
    paragraph_id: input.paragraph,
    verdict: input.verdict,
    corrected_page: input.correctedPage,
    shadow_supports: result.supports,
    shadow_supports_reason: result.reason,
    primary_route: lookup?.route_primary ?? null,
    mode: lookup?.mode ?? null,
    ...settled ? { settled: true } : {}
  };
}
async function recordVerdict(project, input, waitMs = limits8.timeoutMs.verdictSettle) {
  const key = newKey();
  await sweepSpool(project);
  const lookup = (await rowsForLookup(project, input.lookup)).find((row2) => row2.row_type === "lookup");
  const result = await computeSupports(project, input.lookup, input.quote, waitMs, input.page);
  const row = verdictRow(input, key, result, lookup, false);
  const append2 = await appendRow(project, row);
  if (append2.ok && result.reason === "shadow_pending") {
    const pending = { ...input, ...key };
    await writeSpool(project, pendingFile(project, input.lookup, input.paragraph, key.nonce), pending);
  }
  return { row, append: append2 };
}
async function settlePending(project) {
  let settled = 0;
  let waiting = 0;
  if (!await hasProjectFolder(project) || !await containedDir(project, ["retrieval", "spool"])) return { settled, waiting };
  const files = await listSpool(project, (name) => name.startsWith("pending-") && name.endsWith(".json"));
  for (const file of files) {
    let input;
    try {
      input = await readSpoolJson(project, file);
    } catch {
      await removeSpool(project, file);
      continue;
    }
    if (typeof input.lookup !== "string" || typeof input.verdict_at !== "string" || typeof input.nonce !== "string" || !Number.isInteger(input.pid)) {
      await removeSpool(project, file);
      continue;
    }
    const paragraph = input.paragraph ?? null;
    const earlier = await earlierVerdicts(project, input.lookup, paragraph);
    if (earlier.some((row) => compareVerdictKeys(row, input) > 0)) {
      await removeSpool(project, file);
      continue;
    }
    const result = await computeSupports(project, input.lookup, input.quote, 0, input.page);
    if (result.reason === "shadow_pending") {
      waiting += 1;
      continue;
    }
    const lookup = (await rowsForLookup(project, input.lookup)).find((row) => row.row_type === "lookup");
    const key = { verdict_at: input.verdict_at, pid: input.pid, nonce: input.nonce };
    if ((await appendRow(project, verdictRow({ ...input, paragraph }, key, result, lookup, true))).ok) {
      settled += 1;
      await removeSpool(project, file);
    }
  }
  return { settled, waiting };
}

