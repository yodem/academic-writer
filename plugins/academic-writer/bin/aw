// src/prompts/write-synthesize.md
var write_synthesize_default = 'You are the final-pass editor of a scholarly Humanities article, working as its author. Every unit was drafted separately. Your task is to propose transition edits at paragraph boundaries, and nothing else. Citations and quotations have already been verified, so your edits leave them exactly as they are.\n\nYou never see or return the whole article at once. You are given every unit\'s paragraphs, numbered, and you propose a small set of surgical edits: one named paragraph\'s text, replaced with a version that bridges better to its neighbour. Everything else in the article stays untouched by construction.\n\n<instructions>\nPropose an edit only where a transition genuinely needs one: a paragraph boundary that reads abruptly, a phrase repeated heavily across two nearby paragraphs, or a voice drift within one paragraph. Leave a paragraph alone when the only reason to edit is that it could be phrased differently.\n\nEvery repeated opener listed in <repetition> must be varied: for each occurrence after the first, propose an edit that opens the paragraph differently while keeping its meaning. This takes priority over keeping the number of edits small.\n\nFor each edit:\n- `unitId` and `paragraphIndex` identify exactly one paragraph from <units>.\n- `before` is copied exactly, character for character, from that paragraph\'s text in <units>. This is how the edit is verified and applied; an edit whose `before` does not match is discarded.\n- `after` is the full replacement text for that paragraph.\n- `reason` is a one-line explanation.\n\nInside `after`, keep each of these exactly as it appears in `before`, even when you edit the sentence around it:\n- a parenthetical citation: text inside `(...)` naming a work, an author or a location, with or without a year (Hebrew citations normally carry no year, e.g. `(\u05DE\u05D7\u05D1\u05E8, \u05E2\u05DE\' 12)`);\n- a footnote marker `[^id]`, or a footnote definition line `[^id]: ...`;\n- quoted material: text inside `" "`, `\u05F4 \u05F4`, or `" "`.\n\nPropose at most one edit per paragraph. An empty `edits` array is the right answer when no boundary needs work, and that is the usual case (except for the repetitions above).\n</instructions>\n\n<output_format>\nReturn a single JSON object and nothing else:\n\n{\n  "edits": [\n    { "unitId": "<unit id>", "paragraphIndex": 0, "before": "<exact current paragraph text>", "after": "<replacement paragraph text>", "reason": "<one line>" }\n  ]\n}\n</output_format>\n\n<outline>\nThe approved thesis and section claims. Transitions must carry this argument forward.\n{{outline}}\n</outline>\n\n<repetition>\nParagraph openers that code found repeated word for word across the article.\n{{repetition}}\n</repetition>\n\n<units>\nEach unit\'s paragraphs, in draft order, with their 0-based paragraphIndex.\n{{units}}\n</units>\n\nNow propose the transition edits for the units above, following the instructions and returning only the JSON object.\n';

// src/synthesize.ts
var stubs3 = {};
var editsSchema = {
  type: "object",
  required: ["edits"],
  properties: {
    edits: {
      type: "array",
      items: {
        type: "object",
        required: ["unitId", "paragraphIndex", "before", "after", "reason"],
        properties: {
          unitId: { type: "string" },
          paragraphIndex: { type: "integer" },
          before: { type: "string" },
          after: { type: "string" },
          reason: { type: "string" }
        }
      }
    }
  }
};
function splitParagraphs2(text4) {
  return text4.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
}
function fillTemplate2(template, vars) {
  return template.replace(/\{\{(\w+)\}\}/g, (_, key) => vars[key] ?? "");
}
function repeatedOpeners(units, words, minCount) {
  const seen = /* @__PURE__ */ new Map();
  for (const u of units) u.paragraphs.forEach((text4, paragraphIndex) => {
    const opener = text4.split(/\s+/).slice(0, words).join(" ");
    if (!opener) return;
    seen.set(opener, [...seen.get(opener) ?? [], { unitId: u.id, paragraphIndex }]);
  });
  return [...seen.entries()].filter(([, at]) => at.length >= minCount).map(([opener, at]) => ({ opener, at }));
}
function outlineOrder(path2) {
  if (!path2) return [];
  try {
    const o = JSON.parse(readFileSync12(path2, "utf8"));
    return (o.units ?? (o.sections ?? []).flatMap((x2) => x2.units ?? [])).map((u) => u.id);
  } catch {
    return [];
  }
}
function outlineContext(path2) {
  if (!path2) return "(no outline)";
  try {
    const o = JSON.parse(readFileSync12(path2, "utf8"));
    return JSON.stringify({ thesis: o.thesis, sections: (o.sections ?? []).map((x2) => ({ id: x2.id, title: x2.title, claim: x2.claim })) }, null, 2);
  } catch {
    return "(no outline)";
  }
}
async function realGenerate2(units, runId2, budget, outlinePath) {
  const cfg2 = thresholds_default.synthesis;
  const repeats = repeatedOpeners(units, cfg2.openerWords, cfg2.repeatedOpenerMin);
  const system = fillTemplate2(write_synthesize_default, {
    units: JSON.stringify(units.map((u) => ({ unitId: u.id, paragraphs: u.paragraphs.map((text4, paragraphIndex) => ({ paragraphIndex, text: text4 })) })), null, 2),
    outline: outlineContext(outlinePath),
    repetition: repeats.length ? JSON.stringify(repeats, null, 2) : "(none)"
  });
  const result = await callGemini({ step: "write.synthesize", system, parts: ["Propose transition edits now. Return JSON only."], responseSchema: editsSchema, runId: runId2, budget });
  const json = result.json;
  if (!json || !Array.isArray(json.edits)) throw new AwError("ERROR", "write.synthesize", "missing edits array");
  return json.edits;
}
function draftsDir() {
  return join16(projectDir(), ".academic-helper", "drafts");
}
async function synthesizeAll(options) {
  return endRunOnError(options.runId, "write", () => synthesizeUnits(options));
}
async function synthesizeUnits(options) {
  const dir = draftsDir();
  if (!existsSync10(dir)) throw new AwError("ERROR", "write.synthesize", "no drafts directory \u2014 run aw draft first");
  const files = readdirSync4(dir).filter((f3) => f3.endsWith(".md")).sort();
  if (files.length === 0) throw new AwError("ERROR", "write.synthesize", "drafts directory is empty");
  const order = outlineOrder(options.outline);
  const rank = (id) => {
    const i2 = order.indexOf(id);
    return i2 < 0 ? order.length : i2;
  };
  const units = files.map((file) => ({ id: file.replace(/\.md$/, ""), text: readFileSync12(join16(dir, file), "utf8") })).sort((a, b) => rank(a.id) - rank(b.id));
  const unitsWithParagraphs = units.map((u) => ({ id: u.id, paragraphs: splitParagraphs2(u.text) }));
  emit(options.runId, "write", "step_start", { step: "synthesize" });
  const budget = new Budget(options.runId, budgetFor("write"));
  const generate = stubs3.gen ?? ((list) => realGenerate2(list, options.runId, budget, options.outline));
  const proposed = await generate(unitsWithParagraphs);
  const byUnit = new Map(units.map((u) => [u.id, u]));
  const paragraphsByUnit = new Map(units.map((u) => [u.id, splitParagraphs2(u.text)]));
  let appliedCount = 0;
  for (const edit of proposed) {
    const unit = byUnit.get(edit.unitId);
    const paragraphs2 = paragraphsByUnit.get(edit.unitId);
    if (!unit || !paragraphs2 || edit.paragraphIndex < 0 || edit.paragraphIndex >= paragraphs2.length) continue;
    const decision = await decide({
      point: "synthesize.needs_bridge",
      question: "Does this paragraph boundary need the proposed transition edit?",
      options: ["bridge", "no-bridge"],
      context: JSON.stringify(edit),
      runId: options.runId,
      fallback: async () => "bridge",
      label: `${edit.unitId}:${edit.paragraphIndex}`
    });
    if (decision.answer !== "bridge") continue;
    if (paragraphs2[edit.paragraphIndex] !== edit.before) continue;
    paragraphs2[edit.paragraphIndex] = edit.after;
    appliedCount += 1;
  }
  for (const unit of units) {
    const paragraphs2 = paragraphsByUnit.get(unit.id);
    if (!paragraphs2) continue;
    writeFileSync6(join16(dir, `${unit.id}.md`), `${paragraphs2.join("\n\n")}
`, "utf8");
  }
  emit(options.runId, "write", "step_end", { step: "synthesize" });
  return { edits: proposed, applied: appliedCount };
}

// src/edit.ts
import { readFileSync as readFileSync13, writeFileSync as writeFileSync7 } from "node:fs";
init_thresholds();
var schema = { type: "object", required: ["revised_text"], properties: { revised_text: { type: "string" } } };
async function editText(options) {
  return endRunOnError(options.runId, options.section ? "edit-section" : "edit", () => editRun(options));
}
async function editRun(options) {
  const flow = options.section ? "edit-section" : "edit";
  emit(options.runId, flow, "run_start");
  emit(options.runId, flow, "step_start", { step: "edit" });
  const original = readFileSync13(options.textFile, "utf8");
  if (!original.trim()) throw new AwError("ERROR", "edit", "text file is empty");
  if (!options.instruction.trim()) throw new AwError("ERROR", "edit", "instruction is empty");
  const voice = await voiceBundle({ n: thresholds_default.voice.bundle.exemplars, pairs: thresholds_default.voice.bundle.pairs, runId: options.runId });
  const system = `You are revising a passage of a scholarly article as its author. Apply only the requested change; preserve citations, footnote markers, and quotations exactly. Match this author's voice.
<voice_examples>
${voice.exemplars.map((x2) => x2.text).join("\n\n")}
</voice_examples>
<voice_pairs>
${JSON.stringify(voice.pairs)}
</voice_pairs>
Language: ${options.language}
<existing_text>
${original}
</existing_text>
<edit_instruction>
${options.instruction}
</edit_instruction>
Return one JSON object with revised_text.`;
  const response = await callGemini({ step: "edit", system, parts: ["Apply the edit now. Return JSON only."], responseSchema: schema, runId: options.runId, budget: new Budget(options.runId, budgetFor("write")) });
  const result = response.json;
  if (!result || typeof result.revised_text !== "string") throw new AwError("ERROR", "edit", "invalid revised_text response");
  if (options.out) {
    writeFileSync7(options.out, result.revised_text, "utf8");
    emit(options.runId, flow, "file_written", { step: "edit", path: options.out });
  }
  emit(options.runId, flow, "step_end", { step: "edit" });
  emit(options.runId, flow, "run_end", { exit: "OK" });
  return { revised_text: result.revised_text };
}

// src/ocr.ts
import { existsSync as existsSync11, mkdtempSync, readFileSync as readFileSync14, readdirSync as readdirSync5, rmSync, statSync as statSync3, writeFileSync as writeFileSync8 } from "node:fs";
import { tmpdir } from "node:os";
import { dirname as dirname6, extname, join as join17, resolve as resolve9 } from "node:path";
import { spawnSync } from "node:child_process";
init_thresholds();
var schema2 = { type: "array", items: { type: "object", required: ["page_number", "text", "is_born_digital"], properties: { page_number: { type: "integer" }, text: { type: "string" }, is_born_digital: { type: "boolean" }, confidence: { type: "string", enum: ["high", "medium", "low"] }, notes: { type: "string" } } } };
var cfg = thresholds_default.ocr;
function runScript(name, args2) {
  const plugin2 = resolve9(dirname6(process.argv[1] ?? ""), "..");
  const script = join17(plugin2, "scripts", "ocr", name);
  const result = spawnSync("python3", [script, ...args2], { encoding: "utf8", env: allowedEnv(process.env, "script") });
  if (result.status !== 0) throw new AwError("ERROR", "ocr", result.stderr.trim() || result.stdout.trim() || `${name} failed`);
  try {
    return JSON.parse(result.stdout);
  } catch {
    throw new AwError("ERROR", "ocr", `${name} returned invalid JSON`);
  }
}
function prompt3(language, format, pages) {
  const rtl = language !== "en" ? "Preserve Hebrew right-to-left reading order. Mixed Hebrew and Latin text should follow human reading order." : "";
  const detail = format === "detailed" ? "Use notes to describe layout, footnotes, tables, and uncertain passages." : "Keep notes brief; flag only low-confidence passages.";
  return `Transcribe these scanned academic document pages faithfully. OCR ONLY: do not correct, paraphrase, modernize, or summarize. Preserve paragraph breaks and omit running headers/footers unless they are content. Ignore watermarks. ${rtl}
Language: ${language}; detail: ${format ?? "concise"}. Images are pages in this order: ${pages.join(", ")}. Return one JSON array entry per page with page_number, text, is_born_digital=false, confidence (high|medium|low), notes. ${detail}`;
}
var PLAIN_PROMPT = "Transcribe all text on this page image exactly as printed, in the natural reading order of the page. Include running heads, page numbers and footnotes (footnotes after the main text). Keep the original spelling, vowel points (niqqud) and punctuation. Do not correct, modernize, translate, summarize or add any commentary. Mark an illegible word as [?]. Output plain text only, no markdown.";
var GEMINI_REFUSAL = /RECITATION|SAFETY|PROHIBITED_CONTENT|BLOCKLIST|SPII|IMAGE_SAFETY/;
var CLAUDE_REFUSAL = /content filtering|Output blocked/i;
var SHORT = "Claude's answer is much shorter than the free reading";
var SOFT_REFUSAL = /I can(?:no|['’])t (?:transcribe|reproduce)|copyrighted text/i;
function stripFence(value) {
  const match = /```(?:json)?\s*\n([\s\S]*?)\n```/i.exec(value);
  return match?.[1] ?? value;
}
var probe = (cmd) => cmd === "surya_ocr" ? suryaServer() : spawnSync(cmd, ["--version"], { encoding: "utf8" }).status === 0;
function suryaServer() {
  const url = (process.env.SURYA_INFERENCE_URL ?? "").trim().replace(/\/+$/, "").replace(/\/v1$/, "");
  if (!url || spawnSync("surya_ocr", ["--help"], { encoding: "utf8" }).status !== 0) return false;
  const health = spawnSync(process.execPath, ["-e", "fetch(process.argv[1]).then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))", `${url}/health`], { timeout: 5e3 });
  return health.status === 0;
}
function lettersOnly(text4) {
  return text4.normalize("NFC").replace(/[\u200e\u200f\u202a-\u202e\u2066-\u2069\ufeff]/g, "").replace(/\[\?\]/g, " ").replace(/[\u05be-]/g, " ").replace(/[\u0591-\u05c7]/g, "").replace(/[^\p{L}\p{M}\s]/gu, " ").toLowerCase().replace(/\s+/g, " ").trim();
}
function similarity(a, b) {
  if (!a.length && !b.length) return 1;
  let prev = new Uint32Array(b.length + 1), cur = new Uint32Array(b.length + 1);
  for (let i2 = 1; i2 <= a.length; i2++) {
    for (let j = 1; j <= b.length; j++) cur[j] = a[i2 - 1] === b[j - 1] ? prev[j - 1] + 1 : Math.max(prev[j], cur[j - 1]);
    [prev, cur] = [cur, prev];
  }
  return 2 * prev[b.length] / (a.length + b.length);
}
function chooseEngine(requested) {
  const hasKey = (process.env.GOOGLE_API_KEY ?? "").trim() !== "";
  if (requested === "gemini") {
    if (!hasKey) throw new AwError("ERROR", "ocr", "engine gemini needs a Google API key (GOOGLE_API_KEY)");
    return { engine: "gemini", reason: "requested" };
  }
  if (requested === "claude") {
    if (!probe("claude")) throw new AwError("ERROR", "ocr", "engine claude needs the claude program on PATH");
    return { engine: "claude", reason: "requested" };
  }
  if (!probe("tesseract")) throw new AwError("ERROR", "ocr", "engine local needs tesseract installed");
  return { engine: "local", reason: "requested" };
}
function nativeDpi(pdf, page) {
  const out = spawnSync("pdfimages", ["-list", "-f", String(page), "-l", String(page), pdf], { encoding: "utf8" });
  if (out.status !== 0) return void 0;
  const rows = out.stdout.split("\n").slice(2).map((l) => l.trim().split(/\s+/)).filter((r2) => r2.length > 12);
  const big = rows.sort((a, b) => Number(b[3]) * Number(b[4]) - Number(a[3]) * Number(a[4]))[0];
  const dpi = big ? Number(big[12]) : NaN;
  return Number.isFinite(dpi) && dpi > 0 ? dpi : void 0;
}
function lowResNote(engine, dpi) {
  if (engine === "gemini" || engine === "none" || dpi === void 0 || dpi >= cfg.lowResDpi) return "";
  return `low resolution (${dpi} dpi): in the bake-off Gemini read pages under ${cfg.lowResDpi} dpi more accurately; verify against the image`;
}
async function readGemini(scans, options) {
  const pages = [];
  for (let offset = 0; offset < scans.length; offset += cfg.geminiBatchSize) {
    const batch = scans.slice(offset, offset + cfg.geminiBatchSize);
    const numbers = batch.map((s2) => s2.page_number);
    const parts = batch.map((s2) => ({ inlineData: { mimeType: mimeOf(s2.png), data: readFileSync14(s2.png).toString("base64") } }));
    let result;
    try {
      result = await callGemini({ step: "ocr", system: prompt3(options.language, options.format, numbers), parts: [...parts, prompt3(options.language, options.format, numbers)], responseSchema: schema2, runId: options.runId, budget: new Budget(options.runId, budgetFor("write")) });
    } catch (error) {
      const message = error instanceof Error ? error.message : "";
      const refusal = GEMINI_REFUSAL.exec(message)?.[0];
      if (!refusal) throw error;
      pages.push(...numbers.map((n) => ({ page_number: n, text: "", is_born_digital: false, confidence: "low", notes: `blocked: Gemini refused this page (${refusal}); not substituted from another engine` })));
      continue;
    }
    const parsed = JSON.parse(stripFence(result.text));
    if (!Array.isArray(parsed) || parsed.some((p) => typeof p.page_number !== "number" || typeof p.text !== "string")) throw new AwError("ERROR", "ocr", "invalid OCR page response");
    if (batch.length === 1 && parsed.length === 1) parsed[0].page_number = batch[0].page_number;
    for (const p of parsed) if (!p.text.trim()) {
      p.confidence = "low";
      p.notes = "blocked: Gemini returned no text (copyright/recitation block); not substituted from another engine";
    }
    pages.push(...parsed);
  }
  return pages;
}
function readClaude(scan, language) {
  const message = { type: "user", message: { role: "user", content: [
    { type: "image", source: { type: "base64", media_type: mimeOf(scan.png), data: readFileSync14(scan.png).toString("base64") } },
    { type: "text", text: language === "en" ? PLAIN_PROMPT : `${PLAIN_PROMPT} Hebrew columns read right to left.` }
  ] } };
  const run = spawnSync("claude", [
    "-p",
    "--model",
    cfg.claudeModel,
    "--setting-sources",
    "",
    "--strict-mcp-config",
    "--tools",
    "",
    "--system-prompt",
    "You are a precise OCR transcription engine.",
    "--input-format",
    "stream-json",
    "--output-format",
    "stream-json",
    "--verbose",
    "--no-session-persistence"
  ], { input: `${JSON.stringify(message)}
`, encoding: "utf8", cwd: tmpdir(), env: { ...process.env, ENABLE_CLAUDEAI_MCP_SERVERS: "false" }, maxBuffer: 64 * 1024 * 1024, timeout: 9e5 });
  const line = (run.stdout ?? "").split("\n").find((l) => l.includes('"type":"result"'));
  if (!line) throw new AwError("ERROR", "ocr", `claude produced no result: ${(run.stderr || run.stdout || "").slice(-300)}`);
  const result = JSON.parse(line);
  if (result.is_error) {
    if (!CLAUDE_REFUSAL.test(result.result ?? "")) throw new AwError("ERROR", "ocr", `claude failed: ${(result.result ?? "").slice(0, 200)}`);
    return { page_number: scan.page_number, text: "", is_born_digital: false, confidence: "low", refused: true, notes: `blocked by Claude: ${(result.result ?? "").slice(0, 120)}; ask before sending this page to another engine` };
  }
  return { page_number: scan.page_number, text: result.result ?? "", is_born_digital: false, confidence: "medium", notes: "" };
}
function readLocal(scan, language) {
  const langs = language === "en" ? "eng" : "heb+eng";
  const run = spawnSync("tesseract", [scan.png, "-", "-l", langs], { encoding: "utf8", maxBuffer: 16 * 1024 * 1024 });
  if (run.status !== 0) throw new AwError("ERROR", "ocr", `tesseract failed: ${run.stderr.slice(-300)}`);
  return { page_number: scan.page_number, text: run.stdout, is_born_digital: false, confidence: "low", notes: "Tesseract: OCR, not image-verified (2-5% letter error on Hebrew scans, more on vowel marks)" };
}
function readSurya(scan) {
  const dir = mkdtempSync(join17(tmpdir(), "aw-surya-"));
  try {
    const run = spawnSync("surya_ocr", [scan.png, "--output_dir", dir], { encoding: "utf8", env: process.env, maxBuffer: 16 * 1024 * 1024, timeout: 18e5 });
    const file = readdirSync5(dir).map((d) => join17(dir, d, "results.json")).find((f3) => existsSync11(f3));
    if (run.status !== 0 || !file) throw new AwError("ERROR", "ocr", `surya_ocr failed: ${(run.stderr || run.stdout || "").trim().split("\n").pop()?.slice(-300) ?? ""}`);
    const results = JSON.parse(readFileSync14(file, "utf8"));
    const blocks = (Object.values(results)[0]?.[0]?.blocks ?? []).filter((b) => !b.skipped).sort((a, b) => (a.reading_order ?? 0) - (b.reading_order ?? 0));
    return { page_number: scan.page_number, text: blocks.map((b) => (b.html ?? "").replace(/<[^>]+>/g, "")).join("\n"), is_born_digital: false, confidence: "medium", notes: "" };
  } finally {
    rmSync(dir, { recursive: true, force: true });
  }
}
function available() {
  return { surya: probe("surya_ocr"), tesseract: probe("tesseract"), claude: probe("claude"), gemini: (process.env.GOOGLE_API_KEY ?? "").trim() !== "" };
}
function withNote(page, note, confidence) {
  if (!note) return page;
  return { ...page, notes: page.notes ? `${page.notes}; ${note}` : note, ...confidence ? { confidence } : {} };
}
async function readAuto(scan, options, have) {
  const failures = [];
  const tried = (read) => {
    try {
      return read();
    } catch (error) {
      failures.push((error instanceof Error ? error.message : String(error)).replace(/^ERROR ocr: /, "").slice(0, 200));
      return void 0;
    }
  };
  const tess = have.tesseract ? tried(() => readLocal(scan, options.language)) : void 0;
  const noModel = !have.claude && !have.gemini;
  const surya = have.surya && (tess || noModel) ? tried(() => readSurya(scan)) : void 0;
  const free = surya && lettersOnly(surya.text) ? { ...surya, engine: "surya" } : tess ?? (surya ? { ...surya, engine: "surya" } : void 0);
  const page = await chooseRead();
  return failures.length ? withNote(page, `skipped: ${failures.join("; ")}`) : page;
  async function chooseRead() {
    if (surya && tess) {
      const [a, b] = [lettersOnly(surya.text), lettersOnly(tess.text)];
      const agree = a && b ? similarity(a, b) : 0;
      if (agree >= cfg.freeAgreeMin) return { ...surya, engine: "surya", notes: `free reading: Surya and Tesseract agree (${agree.toFixed(3)})` };
    }
    const lowRes = scan.dpi !== void 0 && scan.dpi < cfg.lowResDpi;
    let why = lowRes ? `under ${cfg.lowResDpi} dpi` : "";
    if (have.claude && !(lowRes && have.gemini)) {
      const claude = readClaude(scan, options.language);
      const ref = tess ? lettersOnly(tess.text).length : 0;
      why = claude.refused ? "Claude refused the page" : SOFT_REFUSAL.test(claude.text.slice(0, 300)) ? "Claude declined to transcribe the page" : ref >= cfg.shortAnswerMinChars && lettersOnly(claude.text).length < cfg.shortAnswerRatio * ref ? SHORT : "";
      delete claude.refused;
      if (!why) return withNote({ ...claude, engine: "claude" }, lowResNote("claude", scan.dpi), lowRes ? "low" : void 0);
      if (!have.gemini && why === SHORT) {
        return withNote({ ...claude, engine: "claude" }, `${why}; no Google API key for the Gemini fallback: check it against the image`, "low");
      }
      if (!have.gemini) {
        const other = free && lettersOnly(free.text) ? `; a free reading by ${free.engine ?? "local"} exists but did not pass the agreement check` : "";
        return { ...claude, text: "", confidence: "low", engine: "claude", notes: `blocked: ${why}; no Google API key for the Gemini fallback${other}; ask before sending this page to another engine` };
      }
    }
    if (have.gemini) {
      const answer = await readGemini([scan], options);
      if (answer.length !== 1) throw new AwError("ERROR", "ocr", `Gemini returned ${answer.length} pages for page ${scan.page_number}`);
      const page2 = { ...answer[0], page_number: scan.page_number };
      return why ? withNote({ ...page2, engine: "gemini" }, `read by Gemini: ${why}`) : { ...page2, engine: "gemini" };
    }
    if (!free) throw new AwError("ERROR", "ocr", `page ${scan.page_number}: no reader worked and no Claude or Gemini is available (${failures.join("; ") || "no free reader installed"})`);
    return withNote({ ...free, engine: free.engine ?? "local" }, "no Claude or Gemini available: free reading only", "low");
  }
}
function mimeOf(file) {
  return /\.jpe?g$/i.test(file) ? "image/jpeg" : /\.webp$/i.test(file) ? "image/webp" : /\.tiff?$/i.test(file) ? "image/tiff" : "image/png";
}
function autoReason(have) {
  const steps = [
    have.surya && have.tesseract ? "Surya and Tesseract when they agree" : "",
    have.claude ? `Claude (${cfg.claudeModel})` : "",
    have.gemini ? "Gemini for refused, short or low-resolution pages" : "",
    !have.claude && !have.gemini ? "free readers only" : ""
  ].filter(Boolean);
  return `cheapest reader that matched Gemini, page by page: ${steps.join(", then ")}`;
}
async function ocrDocument(options) {
  const input = resolve9(options.input);
  if (!existsSync11(input)) throw new AwError("ERROR", "ocr", `input does not exist: ${input}`);
  const isDir = statSync3(input).isDirectory();
  const imageFiles = isDir ? readdirSync5(input).filter((name) => /\.(png|jpe?g|webp|tiff?)$/i.test(name)).sort().map((name) => join17(input, name)) : [];
  const pages = [];
  let truncated = false;
  let truncation_message;
  const scans = [];
  let rasterDir;
  if (!isDir && extname(input).toLowerCase() === ".pdf") {
    const detected = runScript("detect_text_layer.py", options.pages ? [input, "--pages", options.pages] : [input]);
    const selected = detected.pages.slice(0, cfg.perCallPageCap);
    truncated = detected.pages.length > selected.length;
    if (truncated) truncation_message = `${selected.length} of ${detected.pages.length} pages processed; rerun with a narrower page range.`;
    pages.push(...selected.filter((p) => p.is_born_digital).map((p) => ({ page_number: p.page_number, text: p.text, is_born_digital: true, confidence: "high", notes: "" })));
    const numbers = selected.filter((p) => !p.is_born_digital).map((p) => p.page_number);
    if (numbers.length) {
      const raster = runScript("rasterize_pages.py", [input, "--pages", numbers.join(",")]);
      rasterDir = raster.temp_dir;
      scans.push(...raster.pages.map((p) => ({ page_number: p.page_number, png: p.png_path, dpi: nativeDpi(input, p.page_number) })));
    }
  } else {
    const files = imageFiles.length ? imageFiles : [input];
    if (isDir && files.length === 0) throw new AwError("ERROR", "ocr", "directory contains no supported image files");
    const kept = files.slice(0, cfg.perCallPageCap);
    scans.push(...kept.map((png, index) => ({ page_number: index + 1, png })));
    truncated = files.length > kept.length;
    if (truncated) truncation_message = `${kept.length} of ${files.length} images processed.`;
  }
  const auto = (options.engine ?? "auto") === "auto";
  const have = auto && scans.length ? available() : void 0;
  if (have && !have.claude && !have.gemini && !have.tesseract && !have.surya) throw new AwError("ERROR", "ocr", "no OCR engine available: install Claude Code, set GOOGLE_API_KEY, or install tesseract");
  const { engine, reason } = !scans.length ? { engine: "none", reason: "no scanned pages: text extracted from the PDF text layer" } : have ? { engine: "auto", reason: autoReason(have) } : chooseEngine(options.engine);
  try {
    const read = [];
    if (engine === "auto" && have) for (const s2 of scans) read.push(await readAuto(s2, options, have));
    else if (engine === "gemini") read.push(...await readGemini(scans, options));
    else if (engine !== "none") read.push(...scans.map((s2) => engine === "claude" ? readClaude(s2, options.language) : readLocal(s2, options.language)));
    for (const page of read) {
      const scan = scans.find((s2) => s2.page_number === page.page_number);
      const note = engine === "auto" ? "" : lowResNote(engine, scan?.dpi);
      if (scan?.dpi !== void 0) page.dpi = scan.dpi;
      if (note) {
        page.notes = page.notes ? `${page.notes}; ${note}` : note;
        page.confidence = "low";
      }
      pages.push(page);
    }
  } finally {
    if (rasterDir) rmSync(rasterDir, { recursive: true, force: true });
  }
  pages.sort((a, b) => a.page_number - b.page_number);
  const output = { pages, truncated, ...truncation_message ? { truncation_message } : {}, engine, engine_reason: reason };
  const byPage = engine === "auto" ? ` (${pages.filter((p) => p.engine).map((p) => `page ${p.page_number}: ${p.engine}`).join(", ")})` : "";
  if (options.out) writeFileSync8(options.out, `OCR engine: ${engine}${byPage}

${pages.map((p) => p.text).join("\n\n")}`, "utf8");
  return output;
}

// src/docx.ts
import { existsSync as existsSync12, mkdirSync as mkdirSync9, readFileSync as readFileSync15, writeFileSync as writeFileSync9 } from "node:fs";
import { join as join18, resolve as resolve10 } from "node:path";
import { spawnSync as spawnSync2 } from "node:child_process";
function parseUnit(raw, unitId) {
  const definitions = /* @__PURE__ */ new Map();
  const body = [];
  for (const line of raw.split(/\r?\n/u)) {
    const def = line.match(/^\s*\[\^([^\]]+)\]:\s*(.*?)\s*$/u);
    if (def) definitions.set(def[1], def[2]);
    else body.push(line);
  }
  const paragraphs2 = [];
  for (const part of body.join("\n").split(/\n\s*\n/u).map((p) => p.trim()).filter(Boolean)) {
    const footnotes = [];
    let text4 = "";
    const marker = /\[\^([^\]]+)\]/gu;
    let last = 0;
    let match;
    while (match = marker.exec(part)) {
      text4 += part.slice(last, match.index);
      const key = match[1];
      const definition = definitions.get(key);
      if (definition === void 0) throw new Error(`ERROR docx: footnote ${key} has no definition`);
      const prior = text4;
      let length = Math.min(12, prior.length);
      let anchor = prior.slice(-length);
      while (length < prior.length && anchor && part.split(anchor).length - 1 !== 1) {
        length += 1;
        anchor = prior.slice(-length);
      }
      if (!anchor || part.split(anchor).length - 1 !== 1) throw new Error(`ERROR docx: footnote ${key} has no unique anchor`);
      footnotes.push({ after: anchor, text: definition });
      last = marker.lastIndex;
    }
    text4 += part.slice(last);
    paragraphs2.push({ text: text4.trim(), footnotes });
  }
  return paragraphs2;
}
function assembleArticle(outline, project, runId2, options) {
  const sections = [];
  let paragraphCount = 0;
  let footnoteCount = 0;
  const emit2 = (sectionTitle, units) => {
    const paragraphs2 = units.flatMap((unit) => {
      const path2 = join18(project, ".academic-helper", "drafts", `${unit.id}.md`);
      if (!existsSync12(path2)) throw new Error(`ERROR docx: missing draft ${unit.id}`);
      return parseUnit(readFileSync15(path2, "utf8"), unit.id);
    });
    paragraphCount += paragraphs2.length;
    footnoteCount += paragraphs2.reduce((sum3, p) => sum3 + p.footnotes.length, 0);
    sections.push({ title: sectionTitle, paragraphs: paragraphs2 });
  };
  const inputSections = outline.sections ?? [];
  if (inputSections.length) {
    for (const section of inputSections) {
      const units = section.units ?? [];
      const intro = units.filter((u) => u.id === "intro" || u.id === "introduction");
      const regular = units.filter((u) => !intro.includes(u) && u.id !== "conclusion");
      const conclusion = units.filter((u) => u.id === "conclusion");
      if (intro.length) emit2(section.title ?? "", intro);
      if (regular.length) emit2(section.title ?? "", regular);
      if (conclusion.length) emit2(section.title ?? "", conclusion);
    }
  } else if (outline.units) emit2("", outline.units);
  const words = sections.flatMap((s2) => s2.paragraphs.map((p) => p.text)).join(" ").trim().split(/\s+/u).filter(Boolean).length;
  const article = { title: options.title ?? outline.title ?? "", thesis: outline.thesis ?? null, sections, totalWords: words };
  for (const [key, path2] of [["coverPage", options.coverFile], ["abstract", options.abstractFile], ["format", options.formatFile]]) {
    if (path2) article[key] = JSON.parse(readFileSync15(path2, "utf8"));
  }
  return { article, sections: sections.length, paragraphs: paragraphCount, footnotes: footnoteCount, words };
}
function generateDocx(args2) {
  void args2.dataDir;
  const project = resolve10(args2.projectDir);
  emit(args2.runId, "write", "step_start", { step: "word" }, project);
  try {
    return buildDocx(args2, project);
  } catch (error) {
    emit(args2.runId, "write", "run_end", { exit: "ERROR", reason: "command failed" }, project);
    throw error;
  }
}
function buildDocx(args2, project) {
  const outline = JSON.parse(readFileSync15(args2.outlinePath, "utf8"));
  const result = assembleArticle(outline, resolve10(args2.projectDir), args2.runId, args2);
  const runDir = join18(args2.projectDir, ".academic-helper", "runs", args2.runId);
  mkdirSync9(runDir, { recursive: true });
  const jsonPath = join18(runDir, "article.json");
  writeFileSync9(jsonPath, `${JSON.stringify(result.article, null, 2)}
`, "utf8");
  const script = join18(args2.pluginRoot, "scripts", "generate-docx.py");
  const child = spawnSync2("python3", [script, "--input", jsonPath, "--output", args2.out], { stdio: "inherit", env: allowedEnv(process.env, "script") });
  if (child.error) throw new Error(`ERROR docx: ${child.error.message}`);
  if (child.status !== 0) throw new Error(`ERROR docx: generate-docx.py exited ${child.status ?? 1}`);
  emit(args2.runId, "write", "file_written", { step: "word", path: args2.out }, project);
  emit(args2.runId, "write", "step_end", { step: "word" }, project);
  emit(args2.runId, "write", "run_end", { exit: "OK" }, project);
  return { sections: result.sections, paragraphs: result.paragraphs, footnotes: result.footnotes, words: result.words };
}
function docxSummary(value, out) {
  return JSON.stringify({ docx: out, ...value });
}

