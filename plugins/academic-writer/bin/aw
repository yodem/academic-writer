function invalidClaims(runs) {
  const byClaim = /* @__PURE__ */ new Map();
  for (const run of runs) {
    if (run.violations.length === 0) continue;
    const entry = byClaim.get(run.claim_id) ?? { runs: 0, commands: [] };
    entry.runs += 1;
    for (const command3 of run.violations) if (!entry.commands.includes(command3)) entry.commands.push(command3);
    byClaim.set(run.claim_id, entry);
  }
  return [...byClaim.entries()].sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0).map(([claim_id, entry]) => ({ claim_id, runs: entry.runs, reason: invalidReason(entry.commands.map((command3) => command3.replaceAll("<wrapper>", STORED_WRAPPER)), STORED_WRAPPER), commands: entry.commands.slice(0, 5) }));
}
