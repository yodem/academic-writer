function voiceSync(direction) {
  const dir = store();
  mkdirSync6(dir, { recursive: true });
  try {
    const profileText = readFileSync9(join13(projectDir(), ".academic-helper", "profile.md"), "utf8");
    const authorKey = /^author_key:\s*["']?([^\s"']+)/m.exec(profileText)?.[1];
    if (!authorKey) throw new AwError("ERROR", `voice.${direction}`, "author_key missing from project profile");
    const title = `Voice Store \u2014 ${authorKey}`;
    const names = ["profile.json", "exemplars.jsonl", "pairs.jsonl", "style-words.json", "rules.md", "CHANGELOG.jsonl"];
    const readStore = () => Object.fromEntries(names.map((name) => [name, existsSync8(join13(dir, name)) ? readFileSync9(join13(dir, name), "utf8") : ""]));
    const writeStore = (files) => {
      for (const name of names) writeFileSync3(join13(dir, name), files[name] ?? "");
    };
    const local = readStore();
    const previousVersion = (local["profile.json"] ? JSON.parse(local["profile.json"]) : {}).voiceVersion;
    const currentVersion = refreshVersion(dir);
    if (currentVersion !== previousVersion) writeFileSync3(join13(dir, "CHANGELOG.jsonl"), `${local["CHANGELOG.jsonl"] ?? ""}${JSON.stringify({ voiceVersion: currentVersion, at: (/* @__PURE__ */ new Date()).toISOString() })}
`);
    local["profile.json"] = readFileSync9(join13(dir, "profile.json"), "utf8");
    local["CHANGELOG.jsonl"] = readFileSync9(join13(dir, "CHANGELOG.jsonl"), "utf8");
    const localProfile = local["profile.json"] ? JSON.parse(local["profile.json"]) : {};
    const listingText = execFileSync("trove", ["items", "list", "--json"], { encoding: "utf8", env: allowedEnv(process.env, "trove") });
    const listing = JSON.parse(listingText);
    const item = listing.items?.find((row) => row.title === title && typeof row.id === "string");
    if (direction === "pull" && !item?.id) throw new AwError("ERROR", "voice.pull", "no Trove voice store found");
    let remote;
    if (item?.id) {
      const text4 = execFileSync("trove", ["items", "get", item.id], { encoding: "utf8", env: allowedEnv(process.env, "trove") });
      remote = JSON.parse(text4);
    }
    if (direction === "pull") {
      if (!remote) throw new AwError("ERROR", "voice.pull", "missing remote store");
      const remoteProfile2 = remote["profile.json"] ? JSON.parse(remote["profile.json"]) : {};
      const merged = { ...remote };
      if (localProfile.voiceVersion && remoteProfile2.voiceVersion && localProfile.voiceVersion > remoteProfile2.voiceVersion) Object.assign(merged, local);
      const changelog = [...new Set([...(remote["CHANGELOG.jsonl"] ?? "").split("\n"), ...(local["CHANGELOG.jsonl"] ?? "").split("\n")].filter(Boolean))].join("\n");
      merged["CHANGELOG.jsonl"] = changelog ? `${changelog}
` : "";
      writeStore(merged);
      return `voice pull: synchronized ${title}`;
    }
    const body = JSON.stringify(local, null, 2);
    const remoteProfile = remote?.["profile.json"] ? JSON.parse(remote["profile.json"]) : {};
    if (localProfile.voiceVersion && remoteProfile.voiceVersion && remoteProfile.voiceVersion > localProfile.voiceVersion && remote) {
      local["CHANGELOG.jsonl"] = [...new Set([...(remote["CHANGELOG.jsonl"] ?? "").split("\n"), ...(local["CHANGELOG.jsonl"] ?? "").split("\n")].filter(Boolean))].join("\n") + "\n";
    }
    const file = join13(dir, ".trove-voice.md");
    writeFileSync3(file, body);
    if (item?.id) execFileSync("trove", ["items", "put", item.id, "-f", file], { encoding: "utf8", env: allowedEnv(process.env, "trove") });
    else execFileSync("trove", ["items", "import", file, "--title", title], { encoding: "utf8", env: allowedEnv(process.env, "trove") });
    return `voice push: synchronized ${title}`;
  } catch (error) {
    if (error instanceof AwError) throw error;
    throw new AwError("ERROR", `voice.${direction}`, error instanceof Error ? error.message : "Trove sync failed");
  }
}

// src/revise.ts
import { appendFileSync as appendFileSync7, mkdirSync as mkdirSync7, readFileSync as readFileSync10, writeFileSync as writeFileSync4 } from "node:fs";
