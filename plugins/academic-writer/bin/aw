    return void 0;
  }
}
function loadSourceCards(project) {
  const dir = join21(project, ".academic-helper");
  const cards = /* @__PURE__ */ new Map();
  const add = (entry, idKeys, titleKeys) => {
    const id = textOf(idKeys.map((key) => entry[key]).find((value) => textOf(value) !== ""));
    if (!id || !PLAIN_ID.test(id) || cards.has(id)) return;
    const titles = titleKeys.map((key) => textOf(entry[key])).filter(Boolean);
    const year = /\b(1[0-9]{3}|20[0-9]{2})\b/u.exec(textOf(entry.year ?? entry.date ?? entry.issued))?.[1] ?? null;
    cards.set(id, {
      id,
      title: titles[0] ?? id,
      year,
      surnames: surnamesOf(entry.author ?? entry.authors ?? entry.creators),
      titleWords: [...new Set(titles.flatMap(distinctive))]
    });
  };
  for (const entry of listOf(readQuiet(join21(dir, "sources.json")), "sources")) add(entry, ["sourceId", "id"], ["workTitle", "title", "shortTitle"]);
  for (const entry of listOf(readQuiet(join21(dir, "evidence.json")), "sources")) add(entry, ["id", "sourceId"], ["title", "workTitle", "shortTitle"]);
  return [...cards.values()];
}
var IBID = /* @__PURE__ */ new Set(["ibid", "ibidem", "idem", "\u05E9\u05DD", "\u05E9\u05DE"]);
