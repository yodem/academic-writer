// src/jev.ts
async function askJev(input) {
  const key = (process.env.JEV_API_KEY ?? "").trim();
  if (!key) throw new Error("ERROR Jev: missing JEV_API_KEY");
  const thresholds = (await Promise.resolve().then(() => (init_thresholds(), thresholds_exports))).default;
  const response = await fetch("https://api.typesafe.ai/v1/systemone", {
    method: "POST",
    headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
    // Request shape matches the working jev-ask client: choice questions carry `instructions` and a
    // `criteria` map keyed by option (the API rejects `question`/`options`).
    body: JSON.stringify({ state: input.context, questions: { q: jevQuestion(input) }, model: thresholds.models.jev.model })
  });
  if (!response.ok) throw new Error(`ERROR Jev: HTTP ${response.status}`);
  const payload = await response.json();
  const answer = payload.answers?.q;
  if (!answer) throw new Error("ERROR Jev: missing answer");
  const selected = typeof answer.choice === "string" ? answer.choice : typeof answer.noul === "number" ? answer.noul >= thresholds.jev.yesProbability ? "yes" : "no" : void 0;
  const confidence = typeof answer.confidence === "number" ? answer.confidence : typeof answer.noul === "number" ? Math.max(answer.noul, 1 - answer.noul) : typeof answer.score === "number" ? answer.score / thresholds.jev.scoreMaximum : void 0;
  if (selected === void 0) throw new Error("ERROR Jev: malformed answer");
  if (confidence === void 0 || !Number.isFinite(confidence) || confidence < 0 || confidence > 1) throw new Error("ERROR Jev: missing or invalid confidence");
  return { answer: selected, confidence };
}
function jevQuestion(input) {
  return { type: "choice", instructions: input.question, criteria: Object.fromEntries(input.options.map((o) => [o, null])) };
}

