  const author = existsSync8(authorPath) ? readFileSync9(authorPath, "utf8") : "";
  const fingerprintPath = join13(source, ".voice", "fingerprint.md");
  const exemplarsPath = join13(source, ".academic-helper", "voice-exemplars.md");
  const fingerprint = existsSync8(fingerprintPath) ? readFileSync9(fingerprintPath, "utf8") : "";
  const rawExemplars = existsSync8(exemplarsPath) ? readFileSync9(exemplarsPath, "utf8") : "";
  const version = sha(author + fingerprint + rawExemplars);
  writeFileSync3(join13(dir, "profile.json"), JSON.stringify({ schemaVersion: 1, voiceVersion: version, authorVoice: author, fingerprint }, null, 2));
  const rows = paragraphs(rawExemplars).filter((p) => p !== "# Voice exemplars").map((text4, index) => ({ id: `migrated-${index + 1}`, source: `migration-${index + 1}`, text: text4 }));
  writeFileSync3(join13(dir, "exemplars.jsonl"), rows.map((r2) => JSON.stringify(r2)).join("\n") + (rows.length ? "\n" : ""));
  for (const file of ["pairs.jsonl", "CHANGELOG.jsonl"]) if (!existsSync8(join13(dir, file))) writeFileSync3(join13(dir, file), "");
  if (!existsSync8(join13(dir, "style-words.json"))) writeFileSync3(join13(dir, "style-words.json"), JSON.stringify({ banned: [], capped: [], filler: [] }, null, 2));
  if (!existsSync8(join13(dir, "rules.md"))) writeFileSync3(join13(dir, "rules.md"), author.split("\n").slice(0, thresholds_default.voice.bundle.maxRuleLines).join("\n"));
  return dir;
}
