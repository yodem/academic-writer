{
  "permissions": {
    "deny": [
      "Read(./.env)", "Read(./**/.env)", "Read(./.env.local)", "Read(./**/.env.local)",
      "Read(./.env.*.local)", "Read(./.env.production)",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard)", "Bash(git reset --hard *)",
      "Bash(git clean -f *)", "Bash(git clean -fd *)", "Bash(git clean -fdx *)"
    ]
  },
  "hooks": {
    "Stop": [ { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tests.sh", "timeout": 600 } ] } ]
  }
}
