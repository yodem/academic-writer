{
  "description": "Academic Writer hooks — session dashboard, session logging (TypeScript/ESM)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/session-env",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/session-dashboard",
            "timeout": 5,
            "statusMessage": "Loading Academic Writer dashboard..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/voice-pull",
            "timeout": 10,
            "statusMessage": "Pulling latest voice profile..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" skills/setup/voice-migrate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/subagent-start",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/subagent-stop",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/notify-stop",
            "timeout": 3,
            "statusMessage": "Notifying..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/gate-enforce",
            "timeout": 5,
            "statusMessage": "Checking gates..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/guard.sh\" lifecycle/session-end-log",
            "timeout": 10,
            "statusMessage": "Logging session..."
          }
        ]
      }
    ]
  },
  "modules": [
    "../mod/register.tsx"
  ]
}
