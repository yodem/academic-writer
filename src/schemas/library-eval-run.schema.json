{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Library evaluation locate run (runs/<claim>-<route>.json)",
  "description": "What one isolated locate agent found for one claim on one route, with its timing, tokens and cost. Never shown to the judge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eval_id", "claim_id", "route", "engine", "model", "status", "attempts", "started_at", "answer", "tool_calls", "n_reads", "n_toc", "pages_per_read", "over_budget", "permission_denials", "wall_ms", "agent_ms", "turns", "input_tokens", "output_tokens", "cost_usd", "returned_chars", "returned_est_tokens", "agent_version", "error"],
  "properties": {
    "schema": {"const": 1},
    "eval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,39}$"},
    "claim_id": {"type": "string", "pattern": "^c[0-9]{2,3}$"},
    "route": {"enum": ["trove", "pageindex"]},
    "engine": {"enum": ["claude", "codex"]},
    "model": {"type": "string"},
    "status": {"enum": ["ok", "error"]},
    "attempts": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "minLength": 1},
    "answer": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["book", "pages", "reason"],
          "properties": {
            "book": {"type": "string"},
            "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "reason": {"type": "string"}
          }
        }
      ]
    },
    "tool_calls": {"type": "array", "items": {"type": "string"}},
    "n_reads": {"type": "integer", "minimum": 0},
    "n_toc": {"type": "integer", "minimum": 0},
    "pages_per_read": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "over_budget": {"type": "boolean"},
    "permission_denials": {"type": "integer", "minimum": 0},
    "wall_ms": {"type": "integer", "minimum": 0},
    "agent_ms": {"type": ["integer", "null"], "minimum": 0},
    "turns": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "returned_chars": {"type": ["integer", "null"], "minimum": 0},
    "returned_est_tokens": {"type": ["integer", "null"], "minimum": 0},
    "agent_version": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  }
}
