{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Library evaluation pairs (pairs.json), the only file the judge sees",
  "description": "Anonymous A/B pairs. It names no library, carries no timing, token or cost figure, and no free-text reason from the locating agent. Page text is the same canonical text for both options.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eval_id", "created_at", "mapping_sha256", "pairs"],
  "properties": {
    "schema": {"const": 1},
    "eval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,39}$"},
    "created_at": {"type": "string", "minLength": 1},
    "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pairs": {"type": "array", "items": {"$ref": "#/definitions/pair"}}
  },
  "definitions": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "claim", "auto_same", "options"],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^p[0-9]{2,3}$"},
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "text"],
          "properties": {
            "id": {"type": "string", "pattern": "^c[0-9]{2,3}$"},
            "text": {"type": "string", "minLength": 1}
          }
        },
        "auto_same": {"type": "boolean"},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": {"$ref": "#/definitions/option"},
            "B": {"$ref": "#/definitions/option"}
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "book_title", "pages"],
      "properties": {
        "book": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.#:-]+$"},
        "book_title": {"type": ["string", "null"]},
        "pages": {"type": "array", "items": {"$ref": "#/definitions/page"}}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "text"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "text": {"type": "string"}
      }
    }
  }
}
