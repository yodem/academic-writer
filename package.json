{
  "name": "academic-writer",
  "version": "0.20.6",
  "description": "AI-first academic writing assistant for Humanities researchers — Claude Code plugin",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build-plugins.sh",
    "test:cli": "cd src/cli && npm test",
    "typecheck:cli": "cd src/cli && npx tsc --noEmit",
    "build:hooks": "cd src/hooks && npm run build",
    "typecheck": "cd src/hooks && npx tsc --noEmit",
    "clean": "find plugins/academic-writer -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; rm -rf src/hooks/dist/",
    "version:show": "python3 scripts/version-sync.py --show",
    "version:check": "python3 scripts/version-sync.py --check",
    "version:fix": "python3 scripts/version-sync.py --fix",
    "hooks:install": "git config core.hooksPath .githooks && echo 'core.hooksPath -> .githooks'",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yodem/academic-writer"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "academic-writing",
    "humanities"
  ],
  "author": "Yotam Fromm",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
