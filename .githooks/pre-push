#!/usr/bin/env bash
# Pre-push guard: never push another session's ALE run by accident.
#
# Prints the commits being pushed (like `git log --oneline <remote>..<local>`) and aborts when any of them is
# a "Merge branch 'ale/<run>/...'" commit whose run id is not listed in ALE_ALLOW_RUNS (comma or space separated).
# Enable with:  npm run hooks:install      Bypass once with:  git push --no-verify
set -euo pipefail

zero=0000000000000000000000000000000000000000
remote_name="${1:-origin}"
allow=",$(printf '%s' "${ALE_ALLOW_RUNS:-}" | tr ' ' ',' | tr -s ','),"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # a branch deletion pushes no commits
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not "--remotes=$remote_name")
  else
    range=("$remote_sha..$local_sha")
  fi
  commits="$(git log --oneline "${range[@]}")"
  [ -n "$commits" ] || continue
  echo "pre-push: commits to push to $remote_ref:"
  printf '%s\n' "$commits" | sed 's/^/  /'
  while IFS= read -r sha; do
    subject="$(git log -1 --format=%s "$sha")"
    case "$subject" in
      "Merge branch 'ale/"*)
        run="${subject#"Merge branch 'ale/"}"; run="${run%%/*}"; run="${run%%\'*}"
        case "$allow" in *",$run,"*) ;; *)
          echo "pre-push: $sha merges run '$run' of another session: $subject" >&2
          blocked=1 ;;
        esac ;;
    esac
  done < <(git log --format=%H "${range[@]}")
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-push: aborted. Allow a run with ALE_ALLOW_RUNS=<run-id>[,<run-id>] or skip once with git push --no-verify." >&2
  exit 1
fi
